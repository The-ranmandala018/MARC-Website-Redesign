---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import PageHeader from "../components/PageHeader.astro";

const socials = [
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/company/multidisciplinaryai",
        icon: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3v-11zm6.5 0h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4v-11z",
    },
    {
        label: "YouTube",
        href: "https://www.youtube.com/@MARCUoP",
        icon: "M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.75 15.02V8.98L15.5 12l-5.75 3.02z",
    },
    {
        label: "Facebook",
        href: "https://www.facebook.com/p/Multidisciplinary-AI-Research-Center-MARC-61566611961677/",
        icon: "M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z",
    },
];
---

<BaseLayout
    title="Contact"
    description="Get in touch with the Multidisciplinary AI Research Centre at the University of Peradeniya."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>Contact</li>
    </Breadcrumb>

    <PageHeader
        eyebrow="Contact"
        lead="Interested in our research, collaborations, projects, or opportunities? We would love to hear from you."
    >
        <Fragment slot="title">
            Let’s talk about
            <br />
            <span class="text-gradient">AI &amp; research.</span>
        </Fragment>
    </PageHeader>

    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">
        <!-- ===================================================== -->
        <!-- INFO -->
        <!-- ===================================================== -->

        <div class="space-y-6 lg:col-span-5">
            <section class="glass-card p-7 sm:p-8">
                <span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-[#3f6bf5] to-[#7a84f0] text-white shadow-[0_12px_30px_-12px_rgba(63,107,245,0.7)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21z" />
                        <circle cx="12" cy="9.5" r="2.5" />
                    </svg>
                </span>
                <h2 class="mt-5 font-display text-2xl text-base-content">Visit us</h2>
                <address class="mt-3 not-italic leading-relaxed text-base-content/70">
                    Multidisciplinary AI Research Centre<br />
                    Faculty of Engineering<br />
                    University of Peradeniya<br />
                    Sri Lanka
                </address>
            </section>

            <section class="glass-card p-7 sm:p-8">
                <span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-[#7a84f0] to-[#e69aa8] text-white shadow-[0_12px_30px_-12px_rgba(122,132,240,0.7)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9" />
                        <path stroke-linecap="round" d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
                    </svg>
                </span>
                <h2 class="mt-5 font-display text-2xl text-base-content">Connect with MARC</h2>
                <p class="mt-3 text-base-content/70">
                    Follow our latest research, projects, and updates.
                </p>
                <div class="mt-6 flex flex-wrap gap-2">
                    {
                        socials.map((s) => (
                            <a href={s.href} target="_blank" rel="noopener noreferrer" class="glass-chip">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d={s.icon} />
                                </svg>
                                {s.label}
                            </a>
                        ))
                    }
                </div>
            </section>
        </div>

        <!-- ===================================================== -->
        <!-- FORM -->
        <!-- ===================================================== -->

        <section class="glass-card p-7 sm:p-9 lg:col-span-7 lg:p-10">
            <h2 class="font-display text-3xl text-base-content">Send us a message</h2>
            <p class="mt-2 text-base-content/60">Tell us a little about your inquiry.</p>

            <form class="mt-8 space-y-5">
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <div>
                        <label for="name" class="mb-2 block text-sm font-medium text-base-content">Your name</label>
                        <input id="name" name="name" type="text" autocomplete="name" placeholder="Enter your name" class="glass-field" />
                    </div>
                    <div>
                        <label for="email" class="mb-2 block text-sm font-medium text-base-content">Email address</label>
                        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" class="glass-field" />
                    </div>
                </div>

                <div>
                    <label for="message" class="mb-2 block text-sm font-medium text-base-content">Message</label>
                    <textarea id="message" name="message" rows="6" placeholder="Tell us about your inquiry…" class="glass-field resize-y"></textarea>
                </div>

                <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center sm:justify-between">
                    <button
                        type="button"
                        class="inline-flex items-center justify-center gap-3 rounded-full bg-gradient-to-r from-[#3f6bf5] to-[#7a84f0] px-7 py-3.5 text-sm font-semibold text-white shadow-[0_16px_34px_-14px_rgba(63,107,245,0.8)] transition-transform hover:-translate-y-0.5"
                    >
                        Send message
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
                        </svg>
                    </button>
                    <p class="text-xs text-base-content/50 sm:max-w-xs sm:text-right">
                        The contact form will be connected to the MARC email/backend after the design is finalized.
                    </p>
                </div>
            </form>
        </section>
    </div>
</BaseLayout>
