---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-[#FAF8F3] text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- Dotted hands reaching toward one another -->
            <div class="hero-hands-art" aria-hidden="true">
                <svg viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid meet" role="presentation">
                    <defs>
                        <pattern id="hand-dots" width="8" height="8" patternUnits="userSpaceOnUse">
                            <circle cx="2" cy="2" r="1.25" fill="#343943" />
                        </pattern>
                        <linearGradient id="hand-edge" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0" stop-color="#343943" stop-opacity=".2" />
                            <stop offset=".55" stop-color="#343943" stop-opacity=".65" />
                            <stop offset="1" stop-color="#343943" stop-opacity=".35" />
                        </linearGradient>
                        <radialGradient id="touch-glow">
                            <stop offset="0" stop-color="#5170FF" stop-opacity=".35" />
                            <stop offset="1" stop-color="#5170FF" stop-opacity="0" />
                        </radialGradient>
                    </defs>

                    <!-- Left human hand reaching in from the left -->
                    <g class="dotted-hand hand-left">
                        <path d="M-40 470
                            L120 432
                            C190 414 255 388 315 358
                            L407 309
                            C424 300 442 301 451 311
                            C458 320 450 330 439 337
                            L384 371
                            L448 344
                            C466 336 482 345 474 358
                            C470 364 463 369 454 374
                            L398 402
                            L461 381
                            C480 375 494 386 484 400
                            C480 406 473 411 463 416
                            L407 441
                            L453 427
                            C471 421 483 434 471 447
                            C466 453 457 458 447 463
                            L395 485
                            L427 478
                            C444 474 454 487 441 499
                            C410 525 369 544 322 560
                            L130 613 L-40 620 Z"
                            fill="url(#hand-dots)" stroke="url(#hand-edge)" stroke-width="2" stroke-linejoin="round" />
                        <!-- Distinct thumb, finger creases, and palm lines -->
                        <path d="M305 365 C333 348 359 327 388 307
                            C401 298 417 299 425 309
                            C433 319 425 329 413 338
                            L368 372 C349 387 331 397 309 405
                            C297 410 285 402 289 392
                            C292 382 299 373 305 365 Z"
                            fill="url(#hand-dots)" stroke="#343943" stroke-opacity=".48" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="M380 344 C396 334 410 326 425 319
                            M397 379 C420 369 439 359 458 350
                            M410 409 C433 401 451 392 470 383
                            M413 443 C434 436 451 428 466 419
                            M390 478 C407 471 423 464 438 454
                            M160 466 C230 445 292 416 349 384"
                            fill="none" stroke="#343943" stroke-opacity=".42" stroke-width="1.7" stroke-linecap="round" stroke-dasharray="2 7" />
                    </g>

                    <!-- Right human hand mirrored toward the left hand -->
                    <g class="dotted-hand hand-right">
                        <path d="M1240 470
                            L1080 432
                            C1010 414 945 388 885 358
                            L793 309
                            C776 300 758 301 749 311
                            C742 320 750 330 761 337
                            L816 371
                            L752 344
                            C734 336 718 345 726 358
                            C730 364 737 369 746 374
                            L802 402
                            L739 381
                            C720 375 706 386 716 400
                            C720 406 727 411 737 416
                            L793 441
                            L747 427
                            C729 421 717 434 729 447
                            C734 453 743 458 753 463
                            L805 485
                            L773 478
                            C756 474 746 487 759 499
                            C790 525 831 544 878 560
                            L1070 613 L1240 620 Z"
                            fill="url(#hand-dots)" stroke="url(#hand-edge)" stroke-width="2" stroke-linejoin="round" />
                        <path d="M895 365 C867 348 841 327 812 307
                            C799 298 783 299 775 309
                            C767 319 775 329 787 338
                            L832 372 C851 387 869 397 891 405
                            C903 410 915 402 911 392
                            C908 382 901 373 895 365 Z"
                            fill="url(#hand-dots)" stroke="#343943" stroke-opacity=".48" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="M820 344 C804 334 790 326 775 319
                            M803 379 C780 369 761 359 742 350
                            M790 409 C767 401 749 392 730 383
                            M787 443 C766 436 749 428 734 419
                            M810 478 C793 471 777 464 762 454
                            M1040 466 C970 445 908 416 851 384"
                            fill="none" stroke="#343943" stroke-opacity=".42" stroke-width="1.7" stroke-linecap="round" stroke-dasharray="2 7" />
                    </g>

                    <!-- Small AI-inspired spark at the meeting point -->
                    <g class="hand-connection">
                        <circle cx="600" cy="270" r="43" fill="url(#touch-glow)" />
                        <circle class="connection-ring" cx="600" cy="270" r="13" fill="none" stroke="#5170FF" stroke-width="1.5" />
                        <circle cx="600" cy="270" r="3.5" fill="#004AAD" />
                        <path class="connection-rays" d="M600 247 V239 M600 293 V301 M577 270 H569 M623 270 H631 M584 254 L578 248 M616 286 L622 292 M616 254 L622 248 M584 286 L578 292"
                            stroke="#5170FF" stroke-width="1.6" stroke-linecap="round" />
                    </g>
                </svg>
            </div>
            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 lg:pt-20 pb-20"
        >

            <!-- Clean content area -->
            <div class="relative">

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center justify-center px-7 py-20 sm:px-12 lg:px-8"
                >

                    <div class="relative z-20 max-w-3xl mx-auto text-center flex flex-col items-center">

                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display font-semibold text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.98] tracking-tight max-w-4xl text-[#0F172A] dark:text-white"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-slate-700 dark:text-slate-100">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-6 max-w-2xl text-base sm:text-lg text-slate-600 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-8 flex flex-wrap items-center justify-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-white/70 bg-white/55 px-7 py-3.5 text-sm font-medium text-slate-700 backdrop-blur-md transition-all duration-300 hover:bg-white/80 hover:border-sky-300/60 shadow-sm"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-white/50 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-slate-500"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>



    <!-- ========================================================= -->
    <!-- ABOUT MARC -->
    <!-- ========================================================= -->

    <section id="about" class="py-20 lg:py-28 bg-white dark:bg-slate-950">
        <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-20 items-start">
                <div>
                    <p class="eyebrow text-[#004AAD] dark:text-[#5170FF] mb-4">About MARC</p>
                    <h2 class="font-display text-4xl md:text-5xl leading-tight text-slate-900 dark:text-white">
                        AI research across disciplines.
                    </h2>
                </div>
                <div class="space-y-5 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
                    <p>
                        The Multidisciplinary AI Research Centre (MARC) brings together researchers
                        from different disciplines to develop intelligent systems for meaningful
                        real-world impact.
                    </p>
                    <p>
                        Based at the University of Peradeniya, MARC connects foundational AI
                        research with practical challenges in engineering, science, health,
                        energy and society.
                    </p>
                    <a href="/Research" class="inline-flex items-center gap-2 text-sm font-semibold text-[#004AAD] dark:text-[#5170FF] hover:gap-3 transition-all">
                        Explore our research
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="Latest updates"
            title="Latest News"
            description="Discover the latest research, achievements, events and updates from MARC."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-[#0B0405] text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-[#5170FF] opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>
    /* Dotted hands framing the centered MARC hero */
    .hero-hands-art {
        position: absolute;
        z-index: 10;
        inset: 17% 0 3%;
        width: 100%;
        height: 76%;
        pointer-events: none;
        opacity: .48;
        overflow: hidden;
    }

    .hero-hands-art svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .dotted-hand {
        transform-box: fill-box;
        transform-origin: center;
        animation: hands-reach 5s ease-in-out infinite alternate;
    }

    .dotted-hand:nth-of-type(2) {
        animation-delay: -.4s;
    }

    .connection-ring {
        transform-box: fill-box;
        transform-origin: center;
        animation: connection-pulse 2s ease-in-out infinite;
    }

    .connection-rays {
        animation: connection-glow 2s ease-in-out infinite;
    }

    @keyframes hands-reach {
        from { translate: 0 0; }
        to { translate: 0 -3px; }
    }

    @keyframes connection-pulse {
        0%, 100% { opacity: .45; transform: scale(.85); }
        50% { opacity: 1; transform: scale(1.2); }
    }

    @keyframes connection-glow {
        0%, 100% { opacity: .45; }
        50% { opacity: 1; }
    }

    @media (max-width: 900px) {
        .hero-hands-art {
            inset: 22% -8% 10%;
            width: 116%;
            height: 70%;
            opacity: .32;
        }
    }

    @media (max-width: 640px) {
        .hero-hands-art {
            inset: 30% -20% 12%;
            width: 140%;
            height: 58%;
            opacity: .2;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .dotted-hand,
        .connection-ring,
        .connection-rays {
            animation: none !important;
        }
    }
</style>


<!-- Previous colourful particle animation script disabled.
     The hero now uses the lightweight dotted-hands SVG animation. -->
