---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-[#FAF8F3] text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- Cinematic 3D human + AI hands animation -->
            <div class="hero-hands-art" aria-hidden="true">
                <canvas id="marc-hands-canvas"></canvas>
                <div class="hands-animation-fallback">
                    <div class="fallback-ring"></div>
                </div>
            </div>
            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 lg:pt-20 pb-20"
        >

            <!-- Clean content area -->
            <div class="relative">

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center justify-center px-7 py-20 sm:px-12 lg:px-8"
                >

                    <div class="relative z-20 max-w-3xl mx-auto text-center flex flex-col items-center">

                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display font-semibold text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.98] tracking-tight max-w-4xl text-[#0F172A] dark:text-white"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-slate-700 dark:text-slate-100">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-6 max-w-2xl text-base sm:text-lg text-slate-600 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-8 flex flex-wrap items-center justify-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-white/70 bg-white/55 px-7 py-3.5 text-sm font-medium text-slate-700 backdrop-blur-md transition-all duration-300 hover:bg-white/80 hover:border-sky-300/60 shadow-sm"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-white/50 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-slate-500"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>



    <!-- ========================================================= -->
    <!-- ABOUT MARC -->
    <!-- ========================================================= -->

    <section id="about" class="py-20 lg:py-28 bg-white dark:bg-slate-950">
        <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-20 items-start">
                <div>
                    <p class="eyebrow text-[#004AAD] dark:text-[#5170FF] mb-4">About MARC</p>
                    <h2 class="font-display text-4xl md:text-5xl leading-tight text-slate-900 dark:text-white">
                        AI research across disciplines.
                    </h2>
                </div>
                <div class="space-y-5 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
                    <p>
                        The Multidisciplinary AI Research Centre (MARC) brings together researchers
                        from different disciplines to develop intelligent systems for meaningful
                        real-world impact.
                    </p>
                    <p>
                        Based at the University of Peradeniya, MARC connects foundational AI
                        research with practical challenges in engineering, science, health,
                        energy and society.
                    </p>
                    <a href="/Research" class="inline-flex items-center gap-2 text-sm font-semibold text-[#004AAD] dark:text-[#5170FF] hover:gap-3 transition-all">
                        Explore our research
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="Latest updates"
            title="Latest News"
            description="Discover the latest research, achievements, events and updates from MARC."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-[#0B0405] text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-[#5170FF] opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>
    .hero-hands-art {
        position: absolute;
        z-index: 10;
        inset: 27% 0 0;
        width: 100%;
        height: 65%;
        pointer-events: none;
        overflow: hidden;
        opacity: .92;
    }

    #marc-hands-canvas {
        display: block;
        width: 100%;
        height: 100%;
    }

    .hands-animation-fallback {
        position: absolute;
        width: min(25vw, 260px);
        aspect-ratio: 1;
        left: 50%;
        top: 42%;
        transform: translate(-50%, -50%);
        border: 2px solid rgba(245, 133, 55, .65);
        border-radius: 50%;
        box-shadow: 0 0 28px rgba(245, 133, 55, .18), inset 0 0 28px rgba(245, 133, 55, .12);
        animation: fallback-ring-pulse 4s ease-in-out infinite;
    }

    @keyframes fallback-ring-pulse {
        0%, 100% { transform: translate(-50%, -50%) scale(.88); opacity: .5; }
        50% { transform: translate(-50%, -50%) scale(1.06); opacity: .9; }
    }

    @media (max-width: 900px) {
        .hero-hands-art { inset: 34% -8% 2%; width: 116%; height: 58%; opacity: .68; }
    }

    @media (max-width: 640px) {
        .hero-hands-art { inset: 39% -22% 4%; width: 144%; height: 50%; opacity: .48; }
    }

    @media (prefers-reduced-motion: reduce) {
        .hands-animation-fallback { animation: none; }
    }
</style>

<script>
    import * as THREE from "three";
    import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

    const canvas = document.querySelector<HTMLCanvasElement>("#marc-hands-canvas");

    if (canvas) {
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
        camera.position.set(0, 0.15, 10.8);

        const renderer = new THREE.WebGLRenderer({
            canvas,
            alpha: true,
            antialias: true,
            powerPreference: "low-power",
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        scene.add(new THREE.AmbientLight(0xffffff, 2.0));
        const keyLight = new THREE.DirectionalLight(0xfff1df, 3.2);
        keyLight.position.set(0, 4, 6);
        scene.add(keyLight);
        const blueLight = new THREE.PointLight(0x20bfff, 24, 9);
        blueLight.position.set(1.3, 1.1, 2);
        scene.add(blueLight);
        const warmLight = new THREE.PointLight(0xff8438, 18, 7);
        warmLight.position.set(0, -0.4, 2);
        scene.add(warmLight);

        const art = new THREE.Group();
        scene.add(art);

        const skin = new THREE.MeshStandardMaterial({
            color: 0xc88c68, roughness: 0.48, metalness: 0.02,
        });
        const skinLight = new THREE.MeshStandardMaterial({
            color: 0xe0ad88, roughness: 0.42, metalness: 0.02,
        });
        const metal = new THREE.MeshStandardMaterial({
            color: 0x9eb9c8, metalness: 0.82, roughness: 0.23,
        });
        const darkMetal = new THREE.MeshStandardMaterial({
            color: 0x243b4b, metalness: 0.75, roughness: 0.28,
        });
        const jointMaterial = new THREE.MeshStandardMaterial({
            color: 0x25c9ff, emissive: 0x0879a8, emissiveIntensity: 1.2,
            metalness: 0.45, roughness: 0.24,
        });
        const leafMaterial = new THREE.MeshStandardMaterial({
            color: 0x4c9869, roughness: 0.65, side: THREE.DoubleSide,
        });
        const flowerMaterial = new THREE.MeshStandardMaterial({
            color: 0x6f91ed, roughness: 0.55, side: THREE.DoubleSide,
        });

        const sphereGeometry = new THREE.SphereGeometry(1, 20, 14);
        function ellipsoid(parent: THREE.Object3D, material: THREE.Material, pos: [number,number,number], scale: [number,number,number]) {
            const mesh = new THREE.Mesh(sphereGeometry, material);
            mesh.position.set(...pos);
            mesh.scale.set(...scale);
            parent.add(mesh);
            return mesh;
        }

        function segment(parent: THREE.Object3D, material: THREE.Material, a: THREE.Vector3, b: THREE.Vector3, radiusA: number, radiusB = radiusA) {
            const direction = new THREE.Vector3().subVectors(b, a);
            const mesh = new THREE.Mesh(
                new THREE.CylinderGeometry(radiusB, radiusA, direction.length(), 12, 1),
                material,
            );
            mesh.position.copy(a).add(b).multiplyScalar(0.5);
            mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction.normalize());
            parent.add(mesh);
            ellipsoid(parent, material, [a.x,a.y,a.z], [radiusA,radiusA,radiusA]);
            ellipsoid(parent, material, [b.x,b.y,b.z], [radiusB,radiusB,radiusB]);
            return mesh;
        }

        // Organic hand: a softly sculpted palm, forearm and five reaching fingers.
        const human = new THREE.Group();
        human.position.set(-2.7, -0.15, 0.05);
        human.rotation.z = 0.08;
        art.add(human);
        ellipsoid(human, skin, [-0.95, 0, 0], [1.22, 0.57, 0.38]);
        ellipsoid(human, skinLight, [-0.22, 0.02, 0.02], [0.68, 0.43, 0.34]);
        const humanFingerTips: THREE.Vector3[] = [];
        const fingerStarts: [number, number, number][] = [
            [-0.1, 0.28, 0.04], [0.0, 0.12, 0.10],
            [0.02, -0.06, 0.12], [-0.06, -0.23, 0.10],
        ];
        const fingerEnds: [number, number, number][] = [
            [1.5, 0.53, 0.02], [1.72, 0.23, 0.08],
            [1.75, -0.08, 0.08], [1.58, -0.37, 0.05],
        ];
        fingerStarts.forEach((start, i) => {
            const a = new THREE.Vector3(...start);
            const mid = new THREE.Vector3(start[0] + 0.68, start[1] + (fingerEnds[i][1] - start[1]) * 0.6, start[2]);
            const tip = new THREE.Vector3(...fingerEnds[i]);
            segment(human, skinLight, a, mid, 0.145 - i * 0.012, 0.12 - i * 0.01);
            segment(human, skin, mid, tip, 0.12 - i * 0.01, 0.075 - i * 0.008);
            humanFingerTips.push(tip);
        });
        segment(human, skinLight, new THREE.Vector3(-0.28,-0.08,0.12), new THREE.Vector3(0.56,-0.62,0.14), 0.19, 0.14);
        segment(human, skin, new THREE.Vector3(0.56,-0.62,0.14), new THREE.Vector3(0.94,-0.51,0.12), 0.14, 0.09);

        // Small botanical accents winding around the organic forearm.
        for (let i = 0; i < 8; i++) {
            const x = -1.8 + i * 0.34;
            const y = Math.sin(i * 1.2) * 0.32;
            const leaf = ellipsoid(human, leafMaterial, [x, y, 0.34], [0.23, 0.085, 0.035]);
            leaf.rotation.z = (i % 2 ? -1 : 1) * (0.45 + (i % 3) * 0.18);
            if (i === 2 || i === 5 || i === 7) {
                const flower = new THREE.Group();
                flower.position.set(x, y + 0.14, 0.4);
                for (let p = 0; p < 5; p++) {
                    const angle = p * Math.PI * 2 / 5;
                    ellipsoid(flower, flowerMaterial, [Math.cos(angle)*0.075, Math.sin(angle)*0.075, 0], [0.07,0.045,0.025]);
                }
                ellipsoid(flower, new THREE.MeshStandardMaterial({color:0xffd16c, emissive:0x6a3b08}), [0,0,0.025], [0.035,0.035,0.025]);
                human.add(flower);
            }
        }

        // Robotic hand: articulated metallic palm, segmented fingers and cyan joints.
        const robot = new THREE.Group();
        robot.position.set(2.75, 0.15, 0.1);
        robot.rotation.z = Math.PI - 0.08;
        art.add(robot);
        ellipsoid(robot, darkMetal, [-0.95,0,0], [1.18,0.57,0.38]);
        ellipsoid(robot, metal, [-0.24,0,0.03], [0.68,0.44,0.34]);
        const robotStarts: [number, number, number][] = [
            [-0.1,0.28,0.06], [0.0,0.12,0.1],
            [0.02,-0.06,0.12], [-0.06,-0.23,0.1],
        ];
        const robotEnds: [number, number, number][] = [
            [1.5,0.53,0.04], [1.72,0.23,0.08],
            [1.75,-0.08,0.08], [1.58,-0.37,0.05],
        ];
        robotStarts.forEach((start, i) => {
            const a = new THREE.Vector3(...start);
            const mid = new THREE.Vector3(start[0] + 0.68, start[1] + (robotEnds[i][1] - start[1]) * 0.6, start[2]);
            const tip = new THREE.Vector3(...robotEnds[i]);
            segment(robot, metal, a, mid, 0.14 - i * 0.01, 0.115 - i * 0.009);
            segment(robot, darkMetal, mid, tip, 0.115 - i * 0.009, 0.07 - i * 0.007);
            ellipsoid(robot, jointMaterial, [mid.x,mid.y,mid.z+0.025], [0.105,0.105,0.09]);
        });
        segment(robot, metal, new THREE.Vector3(-0.28,-0.08,0.12), new THREE.Vector3(0.56,-0.62,0.14), 0.18, 0.13);
        segment(robot, darkMetal, new THREE.Vector3(0.56,-0.62,0.14), new THREE.Vector3(0.94,-0.51,0.12), 0.13, 0.085);

        // Orange energy ring, layered for a soft cinematic glow.
        const ringGroup = new THREE.Group();
        ringGroup.position.set(0, 0.02, 0.0);
        ringGroup.rotation.x = 0.22;
        art.add(ringGroup);
        const ring = new THREE.Mesh(
            new THREE.TorusGeometry(1.12, 0.025, 12, 100),
            new THREE.MeshStandardMaterial({color:0xff9a47, emissive:0xff641c, emissiveIntensity:2.1, metalness:0.25, roughness:0.25}),
        );
        ringGroup.add(ring);
        const ringInner = new THREE.Mesh(
            new THREE.TorusGeometry(1.02, 0.008, 8, 100),
            new THREE.MeshBasicMaterial({color:0xffbd79, transparent:true, opacity:0.75}),
        );
        ringGroup.add(ringInner);
        const glow = new THREE.Mesh(
            new THREE.TorusGeometry(1.16, 0.085, 8, 100),
            new THREE.MeshBasicMaterial({color:0xff762d, transparent:true, opacity:0.11}),
        );
        ringGroup.add(glow);

        // Floating botanical leaves around the human side.
        const leaves: THREE.Mesh[] = [];
        for (let i = 0; i < 11; i++) {
            const leaf = ellipsoid(art, leafMaterial,
                [-3.35 + (i % 4) * 0.27, -0.9 + i * 0.18, -0.2 + (i % 3) * 0.12],
                [0.18,0.065,0.035]);
            leaf.rotation.z = (i % 2 ? -1 : 1) * 0.65;
            leaves.push(leaf);
        }


        // Load a real rigged, textured human hand model (CC0) and reuse its mesh
        // for the metallic AI hand. Keep the procedural version as a fallback.
        const handLoader = new GLTFLoader();
        const realHands = new THREE.Group();
        realHands.visible = false;
        art.add(realHands);

        handLoader.load(
            "https://www.innerscene.com/api/library/posable-anatomical-right-hand-f6098b4f/download",
            (gltf) => {
                const sourceHand = gltf.scene;
                sourceHand.scale.setScalar(7.2);
                sourceHand.rotation.set(0, Math.PI, -Math.PI / 2);
                sourceHand.position.set(-1.15, 0.05, 0.25);
                sourceHand.traverse((object) => {
                    if (object instanceof THREE.Mesh) {
                        object.castShadow = false;
                        object.receiveShadow = false;
                    }
                });

                const roboticHand = sourceHand.clone(true);
                roboticHand.scale.setScalar(7.2);
                roboticHand.position.set(1.15, 0.05, 0.15);
                roboticHand.rotation.set(0, 0, Math.PI / 2);
                roboticHand.traverse((object) => {
                    if (object instanceof THREE.Mesh) {
                        const original = object.material;
                        const metalFinish = new THREE.MeshStandardMaterial({
                            color: 0xb9cbd5,
                            metalness: 0.92,
                            roughness: 0.2,
                            emissive: 0x062638,
                            emissiveIntensity: 0.22,
                        });
                        object.material = Array.isArray(original)
                            ? original.map(() => metalFinish)
                            : metalFinish;
                    }
                });

                realHands.add(sourceHand, roboticHand);
                human.visible = false;
                robot.visible = false;
                realHands.visible = true;
            },
            undefined,
            (error) => {
                console.warn("Real hand model could not load; using local 3D fallback.", error);
            },
        );

        const fallback = document.querySelector<HTMLElement>(".hands-animation-fallback");
        if (fallback) fallback.style.display = "none";

        function resize() {
            const rect = canvas!.getBoundingClientRect();
            const width = Math.max(1, rect.width);
            const height = Math.max(1, rect.height);
            renderer.setSize(width, height, false);
            camera.aspect = width / height;
            camera.position.z = width < 620 ? 13.8 : width < 950 ? 12.2 : 10.8;
            camera.updateProjectionMatrix();
        }
        resize();
        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(canvas);

        const clock = new THREE.Clock();
        function animate() {
            const t = clock.getElapsedTime();
            if (!reducedMotion) {
                human.position.x = -2.7 + Math.sin(t * 0.55) * 0.1;
                robot.position.x = 2.75 - Math.sin(t * 0.55) * 0.1;
                human.rotation.z = 0.08 + Math.sin(t * 0.7) * 0.025;
                robot.rotation.z = Math.PI - 0.08 - Math.sin(t * 0.7) * 0.025;
                ringGroup.rotation.z = Math.sin(t * 0.3) * 0.12;
                const pulse = 1 + Math.sin(t * 1.6) * 0.035;
                ringGroup.scale.setScalar(pulse);
                blueLight.intensity = 20 + Math.sin(t * 1.8) * 5;
                warmLight.intensity = 14 + Math.sin(t * 1.6) * 5;
                leaves.forEach((leaf, i) => {
                    leaf.position.y += Math.sin(t * 0.8 + i) * 0.0009;
                    leaf.rotation.z += Math.cos(t * 0.5 + i) * 0.0008;
                });
            }
            renderer.render(scene, camera);
            if (!reducedMotion) requestAnimationFrame(animate);
        }
        animate();
    }
</script>
