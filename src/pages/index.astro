---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-white text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- Particle canvas -->
            <canvas
                id="particleCanvas"
                class="absolute inset-0 w-full h-full z-[5]"
            ></canvas>

            <!-- Particle vortex inspired by the supplied reference -->
            <div class="particle-vortex-glow" aria-hidden="true"></div>
            <div class="particle-vortex-core" aria-hidden="true"></div>
            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-36 pb-20"
        >

            <!-- Clean content area -->
            <div
                class="relative overflow-hidden rounded-[2rem] border border-white/65 bg-white/18 backdrop-blur-[3px] shadow-[0_30px_100px_-40px_rgba(71,85,105,0.22)]"
            >

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center px-7 py-20 sm:px-12 lg:px-20"
                >

                    <div class="max-w-5xl">

                        <!-- =================================================
                             UNIVERSITY
                             ================================================= -->

                        <div
                            class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 mb-8 shadow-sm backdrop-blur-md"
                        >

                            <span
                                class="w-2 h-2 rounded-full bg-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.6)]"
                            ></span>

                            <span
                                class="text-xs sm:text-sm tracking-wide text-slate-700"
                            >
                                University of Peradeniya · Faculty of Engineering
                            </span>

                        </div>


                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] leading-[0.88] tracking-tight max-w-5xl text-slate-900"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-slate-700">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-8 max-w-2xl text-base sm:text-lg lg:text-xl text-slate-600 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-10 flex flex-wrap items-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-white/70 bg-white/55 px-7 py-3.5 text-sm font-medium text-slate-700 backdrop-blur-md transition-all duration-300 hover:bg-white/80 hover:border-sky-300/60 shadow-sm"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-white/50 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-slate-500"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="The latest"
            title="News & milestones"
            description="Awards, papers, talks and stories from the lab."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-slate-950 text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-sky-300 opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>

    /* =========================================================
       HERO — CLEAN LIGHT BACKGROUND
       ========================================================= */

    /* =========================================================
       PREMIUM LIQUID AI LIGHT
       ========================================================= */

    /* =========================================================
       3D-LIKE PARTICLE FLOW — LIGHT MARC THEME
       ========================================================= */

    .particle-vortex-glow {
        position:absolute;
        width:52vw;
        height:44vw;
        min-width:520px;
        min-height:360px;
        left:67%;
        top:53%;
        transform:translate(-50%,-50%);
        border-radius:50%;
        background:
            radial-gradient(
                ellipse,
                rgba(124,58,237,.14) 0%,
                rgba(79,70,229,.07) 32%,
                rgba(6,182,212,.035) 54%,
                transparent 74%
            );
        filter:blur(30px);
        pointer-events:none;
    }

    .particle-vortex-core {
        position:absolute;
        width:270px;
        height:190px;
        left:67%;
        top:54%;
        transform:translate(-50%,-50%);
        border-radius:50%;
        background:
            radial-gradient(
                ellipse,
                rgba(255,255,255,.96) 0%,
                rgba(167,139,250,.34) 15%,
                rgba(59,130,246,.10) 38%,
                transparent 73%
            );
        filter:blur(22px);
        opacity:.72;
        pointer-events:none;
        animation:vortexCore 8s ease-in-out infinite;
    }

    @keyframes vortexCore {
        0%,100% {
            transform:translate(-50%,-50%) scale(1);
            opacity:.55;
        }
        50% {
            transform:translate(-50%,-50%) scale(1.18);
            opacity:.82;
        }
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 1100px) {
        .liquid-ai-visual {
            opacity: 0.92;
        }

        .liquid-ai-label {
            right: 5%;
            bottom: 6%;
        }
    }

    @media (max-width: 900px) {
        .liquid-ai-visual {
            opacity: 0.72;
        }

        .liquid-ai-label {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .liquid-ai-visual {
            opacity: 0.52;
        }
    }


    /* =========================================================
       REDUCE MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .liquid-ai-visual,
        .liquid-glow,
        .liquid-core,
        .liquid-band,
        .liquid-wave,
        .liquid-particle {

            animation: none !important;
        }

    }

</style>


<!-- ============================================================= -->
<!-- PARTICLE / NEURAL NETWORK SCRIPT -->
<!-- ============================================================= -->

<script>
    /*
     * Premium WebGL particle-flow hero.
     * The field is intentionally broad: particles travel through a
     * 3D-like vortex, with depth, glow and long directional flow.
     */
    const canvas =
        document.getElementById("particleCanvas") as HTMLCanvasElement | null;

    if (canvas) {
        const gl = canvas.getContext("webgl", {
            alpha: true,
            antialias: true,
            premultipliedAlpha: false,
        });

        if (gl) {
            const vertexShaderSource = \`
                attribute vec3 aPosition;
                attribute float aSeed;
                attribute float aSize;

                uniform float uTime;
                uniform vec2 uResolution;
                uniform float uPixelRatio;

                varying float vAlpha;
                varying float vColor;

                float hash(float n) {
                    return fract(sin(n) * 43758.5453123);
                }

                float noise(float x) {
                    return hash(floor(x)) * 0.6
                         + hash(floor(x) + 1.0) * 0.4;
                }

                void main() {
                    float t = uTime * (0.055 + aSeed * 0.025);

                    // Broad radial distance. The central region becomes denser.
                    float r = length(aPosition.xy);
                    float angle = atan(aPosition.y, aPosition.x);

                    // Stronger angular velocity near the vortex eye.
                    float swirl = 0.18 / (r + 0.18);
                    swirl += 0.045 * sin(aSeed * 19.0 + uTime * 0.15);

                    float a = angle + swirl * t * 10.0;

                    // Organic waves bend the otherwise radial flow.
                    float bend =
                        sin(a * 3.0 + aSeed * 17.0 + uTime * 0.18) *
                        (0.025 + r * 0.055);

                    float rr = r + bend;

                    vec3 p;
                    p.x = cos(a) * rr;
                    p.y = sin(a) * rr * 0.62;

                    // Depth gives the field its 3D character.
                    float depth =
                        sin(aSeed * 23.0 + t * 1.7) * 0.55 +
                        cos(a * 2.0 + aSeed * 7.0) * 0.18;

                    p.z = depth + sin(a * 4.0 + aSeed * 13.0) * 0.12;

                    // Slow translation makes the entire cloud breathe.
                    p.x += sin(uTime * 0.08 + aSeed * 9.0) * 0.035;
                    p.y += cos(uTime * 0.07 + aSeed * 11.0) * 0.025;

                    // Perspective projection.
                    float perspective = 1.0 / (1.65 - p.z * 0.48);

                    vec2 pos = p.xy * perspective;

                    // Place the vortex toward the visual right so the MARC copy remains clear.
                    pos.x *= 0.92;
                    pos += vec2(0.28, 0.01);

                    gl_Position = vec4(pos, p.z * 0.08, 1.0);

                    float core = 1.0 - smoothstep(0.03, 0.42, r);
                    float edge = smoothstep(0.08, 0.85, r);

                    vAlpha =
                        (0.28 + aSeed * 0.62) *
                        (0.55 + core * 0.95) *
                        (1.0 - edge * 0.16);

                    // 0 = cyan, 1 = indigo, 2 = violet.
                    vColor = mod(
                        aSeed * 3.0 +
                        core * 0.55 +
                        sin(a * 2.0) * 0.12,
                        3.0
                    );

                    gl_PointSize =
                        max(
                            0.65,
                            aSize *
                            uPixelRatio *
                            perspective *
                            (1.0 + core * 1.8)
                        );
                }
            \`;

            const fragmentShaderSource = \`
                precision mediump float;

                varying float vAlpha;
                varying float vColor;

                vec3 palette(float c) {
                    if (c < 1.0) {
                        return mix(
                            vec3(0.02, 0.72, 0.92),
                            vec3(0.24, 0.38, 1.00),
                            c
                        );
                    }

                    if (c < 2.0) {
                        return mix(
                            vec3(0.24, 0.38, 1.00),
                            vec3(0.50, 0.20, 0.95),
                            c - 1.0
                        );
                    }

                    return mix(
                        vec3(0.50, 0.20, 0.95),
                        vec3(0.82, 0.40, 1.00),
                        c - 2.0
                    );
                }

                void main() {
                    vec2 uv = gl_PointCoord - 0.5;
                    float d = length(uv);

                    if (d > 0.5) discard;

                    float glow =
                        pow(1.0 - smoothstep(0.0, 0.5, d), 2.7);

                    vec3 color = palette(vColor);

                    // White-hot center with MARC spectrum around it.
                    color = mix(
                        color,
                        vec3(0.96, 0.98, 1.0),
                        smoothstep(0.10, 0.0, d) * 0.72
                    );

                    gl_FragColor =
                        vec4(color, glow * vAlpha);
                }
            \`;

            const compile = (
                type: number,
                source: string,
            ) => {
                const shader = gl.createShader(type);

                if (!shader) return null;

                gl.shaderSource(shader, source);
                gl.compileShader(shader);

                if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
                    console.warn(
                        "MARC particle shader:",
                        gl.getShaderInfoLog(shader),
                    );
                    gl.deleteShader(shader);
                    return null;
                }

                return shader;
            };

            const vertexShader =
                compile(
                    gl.VERTEX_SHADER,
                    vertexShaderSource,
                );

            const fragmentShader =
                compile(
                    gl.FRAGMENT_SHADER,
                    fragmentShaderSource,
                );

            if (vertexShader && fragmentShader) {
                const program =
                    gl.createProgram();

                if (program) {
                    gl.attachShader(
                        program,
                        vertexShader,
                    );
                    gl.attachShader(
                        program,
                        fragmentShader,
                    );
                    gl.linkProgram(program);

                    if (
                        gl.getProgramParameter(
                            program,
                            gl.LINK_STATUS,
                        )
                    ) {
                        const positionLocation =
                            gl.getAttribLocation(
                                program,
                                "aPosition",
                            );

                        const seedLocation =
                            gl.getAttribLocation(
                                program,
                                "aSeed",
                            );

                        const sizeLocation =
                            gl.getAttribLocation(
                                program,
                                "aSize",
                            );

                        const timeLocation =
                            gl.getUniformLocation(
                                program,
                                "uTime",
                            );

                        const resolutionLocation =
                            gl.getUniformLocation(
                                program,
                                "uResolution",
                            );

                        const pixelRatioLocation =
                            gl.getUniformLocation(
                                program,
                                "uPixelRatio",
                            );

                        let animationFrame = 0;
                        let startTime = performance.now();

                        const reducedMotion =
                            window.matchMedia(
                                "(prefers-reduced-motion: reduce)",
                            ).matches;

                        const resize = () => {
                            const dpr =
                                Math.min(
                                    window.devicePixelRatio || 1,
                                    2,
                                );

                            canvas.width =
                                window.innerWidth * dpr;

                            canvas.height =
                                window.innerHeight * dpr;

                            canvas.style.width =
                                window.innerWidth + "px";

                            canvas.style.height =
                                window.innerHeight + "px";

                            gl.viewport(
                                0,
                                0,
                                canvas.width,
                                canvas.height,
                            );

                            if (resolutionLocation) {
                                gl.uniform2f(
                                    resolutionLocation,
                                    window.innerWidth,
                                    window.innerHeight,
                                );
                            }

                            if (pixelRatioLocation) {
                                gl.uniform1f(
                                    pixelRatioLocation,
                                    dpr,
                                );
                            }
                        };

                        const createField = () => {
                            const mobile =
                                window.innerWidth < 768;

                            const count =
                                mobile
                                    ? 4200
                                    : 8200;

                            const positions =
                                new Float32Array(
                                    count * 3,
                                );

                            const seeds =
                                new Float32Array(
                                    count,
                                );

                            const sizes =
                                new Float32Array(
                                    count,
                                );

                            for (
                                let i = 0;
                                i < count;
                                i++
                            ) {
                                /*
                                 * A broad cloud with a denser middle.
                                 * The square-root distribution keeps the
                                 * outer field populated like the reference.
                                 */
                                const u =
                                    Math.random();

                                const radius =
                                    0.055 +
                                    Math.pow(
                                        u,
                                        0.62,
                                    ) *
                                        0.94;

                                const angle =
                                    Math.random() *
                                    Math.PI *
                                    2;

                                positions[i * 3] =
                                    Math.cos(angle) *
                                    radius;

                                positions[i * 3 + 1] =
                                    Math.sin(angle) *
                                    radius;

                                positions[i * 3 + 2] =
                                    (Math.random() -
                                        0.5) *
                                    1.15;

                                seeds[i] =
                                    Math.random();

                                sizes[i] =
                                    Math.random() < 0.035
                                        ? 2.8 +
                                          Math.random() *
                                              3.8
                                        : 0.7 +
                                          Math.random() *
                                              1.9;
                            }

                            const positionBuffer =
                                gl.createBuffer();

                            const seedBuffer =
                                gl.createBuffer();

                            const sizeBuffer =
                                gl.createBuffer();

                            gl.bindBuffer(
                                gl.ARRAY_BUFFER,
                                positionBuffer,
                            );
                            gl.bufferData(
                                gl.ARRAY_BUFFER,
                                positions,
                                gl.STATIC_DRAW,
                            );

                            gl.bindBuffer(
                                gl.ARRAY_BUFFER,
                                seedBuffer,
                            );
                            gl.bufferData(
                                gl.ARRAY_BUFFER,
                                seeds,
                                gl.STATIC_DRAW,
                            );

                            gl.bindBuffer(
                                gl.ARRAY_BUFFER,
                                sizeBuffer,
                            );
                            gl.bufferData(
                                gl.ARRAY_BUFFER,
                                sizes,
                                gl.STATIC_DRAW,
                            );

                            return {
                                count,
                                positionBuffer,
                                seedBuffer,
                                sizeBuffer,
                            };
                        };

                        const field =
                            createField();

                        const draw = (
                            now: number,
                        ) => {
                            const elapsed =
                                (now -
                                    startTime) /
                                1000;

                            gl.clearColor(
                                0,
                                0,
                                0,
                                0,
                            );

                            gl.clear(
                                gl.COLOR_BUFFER_BIT,
                            );

                            gl.useProgram(
                                program,
                            );

                            if (timeLocation) {
                                gl.uniform1f(
                                    timeLocation,
                                    reducedMotion
                                        ? 0
                                        : elapsed,
                                );
                            }

                            gl.enable(
                                gl.BLEND,
                            );

                            gl.blendFunc(
                                gl.SRC_ALPHA,
                                gl.ONE,
                            );

                            gl.enable(
                                gl.PROGRAM_POINT_SIZE,
                            );

                            gl.bindBuffer(
                                gl.ARRAY_BUFFER,
                                field.positionBuffer,
                            );
                            gl.enableVertexAttribArray(
                                positionLocation,
                            );
                            gl.vertexAttribPointer(
                                positionLocation,
                                3,
                                gl.FLOAT,
                                false,
                                0,
                                0,
                            );

                            gl.bindBuffer(
                                gl.ARRAY_BUFFER,
                                field.seedBuffer,
                            );
                            gl.enableVertexAttribArray(
                                seedLocation,
                            );
                            gl.vertexAttribPointer(
                                seedLocation,
                                1,
                                gl.FLOAT,
                                false,
                                0,
                                0,
                            );

                            gl.bindBuffer(
                                gl.ARRAY_BUFFER,
                                field.sizeBuffer,
                            );
                            gl.enableVertexAttribArray(
                                sizeLocation,
                            );
                            gl.vertexAttribPointer(
                                sizeLocation,
                                1,
                                gl.FLOAT,
                                false,
                                0,
                                0,
                            );

                            gl.drawArrays(
                                gl.POINTS,
                                0,
                                field.count,
                            );

                            if (!reducedMotion) {
                                animationFrame =
                                    requestAnimationFrame(
                                        draw,
                                    );
                            }
                        };

                        resize();

                        window.addEventListener(
                            "resize",
                            resize,
                        );

                        draw(performance.now());

                        document.addEventListener(
                            "astro:before-swap",
                            () => {
                                cancelAnimationFrame(
                                    animationFrame,
                                );

                                window.removeEventListener(
                                    "resize",
                                    resize,
                                );

                                gl.deleteBuffer(
                                    field.positionBuffer,
                                );
                                gl.deleteBuffer(
                                    field.seedBuffer,
                                );
                                gl.deleteBuffer(
                                    field.sizeBuffer,
                                );
                                gl.deleteProgram(
                                    program,
                                );
                            },
                            { once: true },
                        );
                    }
                }
            }
        }
    }
</script>