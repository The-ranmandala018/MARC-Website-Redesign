<script>
    // Prev/next buttons for the projects carousel (native scroll-snap does the rest)
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((track) => {
        const name = track.dataset.carousel;
        const controls = document.querySelector<HTMLElement>(`[data-carousel-controls="${name}"]`);
        if (!controls) return;
        const buttons = controls.querySelectorAll<HTMLButtonElement>("button[data-dir]");

        const update = () => {
            const max = track.scrollWidth - track.clientWidth - 2;
            const scrollable = max > 0;
            controls.hidden = !scrollable;
            buttons.forEach((btn) => {
                const dir = Number(btn.dataset.dir);
                btn.disabled = dir < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
            });
        };

        buttons.forEach((btn) =>
            btn.addEventListener("click", () => {
                const item = track.querySelector<HTMLElement>(".carousel-item");
                const step = item ? item.offsetWidth + 24 : track.clientWidth * 0.8;
                track.scrollBy({
                    left: Number(btn.dataset.dir) * step,
                    behavior: reduceMotion ? "auto" : "smooth",
                });
            }),
        );

        track.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
    });
</script>
