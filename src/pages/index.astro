---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-white text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- Particle canvas -->
            <canvas
                id="particleCanvas"
                class="absolute inset-0 w-full h-full"
            ></canvas>

            <!-- AI sphere -->
            <div class="neural-brain-container" aria-hidden="true">
                <div class="brain-glow"></div>
                <svg class="neural-brain" viewBox="0 0 620 520" role="presentation">
                    <defs>
                        <radialGradient id="brainCoreGlow">
                            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                            <stop offset="28%" stop-color="#38bdf8" stop-opacity="0.9" />
                            <stop offset="65%" stop-color="#6366f1" stop-opacity="0.32" />
                            <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
                        </radialGradient>
                        <linearGradient id="brainStroke" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#22d3ee" />
                            <stop offset="50%" stop-color="#3b82f6" />
                            <stop offset="100%" stop-color="#8b5cf6" />
                        </linearGradient>
                        <filter id="neuralGlow">
                            <feGaussianBlur stdDeviation="5" result="blur" />
                            <feMerge>
                                <feMergeNode in="blur" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                    </defs>

                    <ellipse cx="310" cy="260" rx="245" ry="205" fill="url(#brainCoreGlow)" opacity="0.42" />

                    <g class="neural-connections">
                        <path d="M112 242 C155 175 205 160 258 205 S350 320 405 230 S500 155 535 235" />
                        <path d="M100 300 C160 350 195 250 255 280 S350 390 430 300 S500 260 540 315" />
                        <path d="M145 175 C205 235 235 125 300 185 S385 280 455 175" />
                        <path d="M150 365 C210 300 250 390 315 330 S405 260 480 365" />
                        <path d="M225 115 C250 175 315 145 340 220 S400 350 455 405" />
                        <path d="M395 120 C355 175 420 205 390 265 S330 355 285 410" />
                    </g>

                    <g class="brain-outline" filter="url(#neuralGlow)">
                        <path d="M307 104 C274 76 218 88 199 126 C160 116 127 145 132 184 C101 204 104 250 133 270 C112 308 134 352 176 357 C181 398 221 420 257 400 C281 432 321 428 341 400" />
                        <path d="M313 104 C348 75 402 89 421 126 C460 116 493 145 488 184 C519 204 516 250 487 270 C508 308 486 352 444 357 C439 398 399 420 363 400 C339 432 299 428 279 400" />
                        <path d="M310 106 C296 155 323 180 307 220 C291 258 326 284 307 325 C292 356 312 386 301 410" />
                        <path d="M200 160 C226 145 249 158 255 183 S236 221 260 237 S278 276 249 289 S220 330 247 350" />
                        <path d="M420 160 C394 145 371 158 365 183 S384 221 360 237 S342 276 371 289 S400 330 373 350" />
                    </g>

                    <g class="synapses">
                        <circle cx="155" cy="205" r="6" />
                        <circle cx="205" cy="145" r="5" />
                        <circle cx="255" cy="205" r="7" />
                        <circle cx="307" cy="220" r="6" />
                        <circle cx="365" cy="183" r="7" />
                        <circle cx="420" cy="160" r="5" />
                        <circle cx="475" cy="215" r="6" />
                        <circle cx="230" cy="330" r="6" />
                        <circle cx="307" cy="325" r="8" />
                        <circle cx="390" cy="300" r="6" />
                        <circle cx="445" cy="350" r="5" />
                    </g>

                    <circle class="brain-core" cx="307" cy="260" r="38" />
                    <circle class="brain-core-pulse" cx="307" cy="260" r="58" />
                </svg>

                <div class="brain-label">
                    <span class="brain-label-dot"></span>
                    Neural Intelligence
                </div>
            </div>

            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-36 pb-20"
        >

            <!-- Clean content area -->
            <div
                class="relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white/75 dark:border-white/10 dark:bg-slate-900/60 backdrop-blur-xl shadow-[0_30px_100px_-40px_rgba(15,23,42,0.25)]"
            >

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center px-7 py-20 sm:px-12 lg:px-20"
                >

                    <div class="max-w-5xl">

                        <!-- =================================================
                             UNIVERSITY
                             ================================================= -->

                        <div
                            class="inline-flex items-center gap-3 rounded-full border border-slate-200 bg-white/80 px-4 py-2 mb-8 shadow-sm dark:border-slate-700 dark:bg-slate-800/70"
                        >

                            <span
                                class="w-2 h-2 rounded-full bg-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.6)]"
                            ></span>

                            <span
                                class="text-xs sm:text-sm tracking-wide text-slate-600 dark:text-slate-300"
                            >
                                University of Peradeniya · Faculty of Engineering
                            </span>

                        </div>


                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] leading-[0.88] tracking-tight max-w-5xl text-slate-900 dark:text-white"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-slate-700 dark:text-white/90">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-8 max-w-2xl text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-300 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-10 flex flex-wrap items-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-slate-300 bg-white/80 px-7 py-3.5 text-sm font-medium text-slate-700 backdrop-blur-md transition-all duration-300 hover:bg-slate-50 hover:border-sky-300 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-200 dark:hover:bg-slate-800"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-slate-200/80 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-slate-500 dark:border-white/10 dark:text-slate-400"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="The latest"
            title="News & milestones"
            description="Awards, papers, talks and stories from the lab."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-slate-950 text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-sky-300 opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>

    /* =========================================================
       HERO — CLEAN LIGHT BACKGROUND
       ========================================================= */

    /* =========================================================
       NEURAL BRAIN — AI VISUAL
       ========================================================= */

    .neural-brain-container {
        position: absolute;
        width: 620px;
        height: 520px;
        right: -35px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        opacity: 0.9;
        filter: drop-shadow(0 25px 60px rgba(37, 99, 235, 0.12));
    }

    .brain-glow {
        position: absolute;
        inset: 18% 12%;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(56,189,248,0.20) 0%, rgba(99,102,241,0.13) 38%, transparent 72%);
        filter: blur(28px);
        animation: brainGlow 5s ease-in-out infinite;
    }

    .neural-brain {
        width: 100%;
        height: 100%;
        overflow: visible;
        animation: brainFloat 7s ease-in-out infinite;
    }

    .neural-connections path {
        fill: none;
        stroke: url(#brainStroke);
        stroke-width: 1.2;
        stroke-linecap: round;
        opacity: 0.28;
        stroke-dasharray: 7 10;
        animation: signalFlow 5s linear infinite;
    }

    .neural-connections path:nth-child(2) { animation-delay: -1s; }
    .neural-connections path:nth-child(3) { animation-delay: -2s; }
    .neural-connections path:nth-child(4) { animation-delay: -3s; }
    .neural-connections path:nth-child(5) { animation-delay: -4s; }
    .neural-connections path:nth-child(6) { animation-delay: -2.5s; }

    .brain-outline path {
        fill: none;
        stroke: url(#brainStroke);
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.68;
    }

    .synapses circle {
        fill: #67e8f9;
        stroke: rgba(255,255,255,0.75);
        stroke-width: 1;
        filter: drop-shadow(0 0 8px rgba(34,211,238,0.9));
        animation: synapsePulse 2.8s ease-in-out infinite;
    }

    .synapses circle:nth-child(2) { animation-delay: -0.4s; }
    .synapses circle:nth-child(3) { animation-delay: -0.8s; }
    .synapses circle:nth-child(4) { animation-delay: -1.2s; }
    .synapses circle:nth-child(5) { animation-delay: -1.6s; }
    .synapses circle:nth-child(6) { animation-delay: -2s; }
    .synapses circle:nth-child(7) { animation-delay: -2.4s; }
    .synapses circle:nth-child(8) { animation-delay: -0.6s; }
    .synapses circle:nth-child(9) { animation-delay: -1.4s; }
    .synapses circle:nth-child(10) { animation-delay: -2.2s; }
    .synapses circle:nth-child(11) { animation-delay: -1s; }

    .brain-core {
        fill: url(#brainCoreGlow);
        stroke: rgba(125,211,252,0.8);
        stroke-width: 1.5;
        filter: drop-shadow(0 0 18px rgba(56,189,248,0.7));
        animation: corePulse 3.2s ease-in-out infinite;
        transform-origin: 307px 260px;
    }

    .brain-core-pulse {
        fill: none;
        stroke: rgba(99,102,241,0.32);
        stroke-width: 1;
        transform-origin: 307px 260px;
        animation: coreRipple 3.2s ease-out infinite;
    }

    .brain-label {
        position: absolute;
        right: 125px;
        bottom: 48px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border: 1px solid rgba(255,255,255,0.65);
        border-radius: 999px;
        background: rgba(255,255,255,0.48);
        backdrop-filter: blur(12px);
        color: rgba(30,64,175,0.82);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        box-shadow: 0 8px 30px rgba(37,99,235,0.10);
    }

    .brain-label-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: linear-gradient(135deg,#22d3ee,#6366f1);
        box-shadow: 0 0 12px rgba(56,189,248,0.8);
    }

    @keyframes brainFloat {
        0%,100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(0.8deg); }
    }

    @keyframes signalFlow {
        from { stroke-dashoffset: 80; }
        to { stroke-dashoffset: 0; }
    }

    @keyframes synapsePulse {
        0%,100% { opacity: 0.45; transform: scale(0.85); }
        50% { opacity: 1; transform: scale(1.35); }
    }

    @keyframes brainGlow {
        0%,100% { opacity: 0.55; transform: scale(0.95); }
        50% { opacity: 1; transform: scale(1.08); }
    }

    @keyframes corePulse {
        0%,100% { opacity: 0.72; transform: scale(0.92); }
        50% { opacity: 1; transform: scale(1.08); }
    }

    @keyframes coreRipple {
        0% { opacity: 0.65; transform: scale(0.7); }
        100% { opacity: 0; transform: scale(1.8); }
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 1100px) {
        .neural-brain-container {
            width: 500px;
            height: 430px;
            right: -100px;
            opacity: 0.58;
        }

        .brain-label {
            right: 90px;
            bottom: 35px;
        }
    }

    @media (max-width: 900px) {
        .neural-brain-container {
            width: 380px;
            height: 330px;
            right: -130px;
            top: 26%;
            opacity: 0.30;
        }

        .brain-label {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .neural-brain-container {
            width: 300px;
            height: 270px;
            right: -105px;
            top: 24%;
            opacity: 0.20;
        }
    }


    /* =========================================================
       REDUCE MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .neural-brain,
        .neural-connections path,
        .synapses circle,
        .brain-core,
        .brain-core-pulse,
        .brain-glow {

            animation: none !important;
        }

    }

</style>


<!-- ============================================================= -->
<!-- PARTICLE / NEURAL NETWORK SCRIPT -->
<!-- ============================================================= -->

<script>

    const canvas =
        document.getElementById(
            "particleCanvas",
        ) as HTMLCanvasElement | null;


    if (canvas) {

        const ctx =
            canvas.getContext("2d");


        if (ctx) {

            let particles: {
                x: number;
                y: number;
                vx: number;
                vy: number;
                size: number;
            }[] = [];


            let animationFrame: number;


            /* =================================================
               RESIZE
               ================================================= */

            const resizeCanvas = () => {

                const dpr =
                    Math.min(
                        window.devicePixelRatio || 1,
                        2,
                    );


                canvas.width =
                    window.innerWidth * dpr;


                canvas.height =
                    window.innerHeight * dpr;


                canvas.style.width =
                    `${window.innerWidth}px`;


                canvas.style.height =
                    `${window.innerHeight}px`;


                ctx.setTransform(
                    dpr,
                    0,
                    0,
                    dpr,
                    0,
                    0,
                );


                createParticles();
            };


            /* =================================================
               CREATE PARTICLES
               ================================================= */

            const createParticles = () => {

                const amount =
                    window.innerWidth < 768
                        ? 35
                        : 75;


                particles = [];


                for (
                    let i = 0;
                    i < amount;
                    i++
                ) {

                    particles.push({

                        x:
                            Math.random() *
                            window.innerWidth,

                        y:
                            Math.random() *
                            window.innerHeight,

                        vx:
                            (Math.random() - 0.5) *
                            0.25,

                        vy:
                            (Math.random() - 0.5) *
                            0.25,

                        size:
                            Math.random() *
                                1.8 +
                            0.5,

                    });

                }

            };


            /* =================================================
               DRAW
               ================================================= */

            const draw = () => {

                ctx.clearRect(
                    0,
                    0,
                    window.innerWidth,
                    window.innerHeight,
                );


                /* =============================================
                   MOVE PARTICLES
                   ============================================= */

                particles.forEach(
                    (particle) => {

                        particle.x +=
                            particle.vx;

                        particle.y +=
                            particle.vy;


                        if (
                            particle.x < 0
                        ) {
                            particle.x =
                                window.innerWidth;
                        }


                        if (
                            particle.x >
                            window.innerWidth
                        ) {
                            particle.x = 0;
                        }


                        if (
                            particle.y < 0
                        ) {
                            particle.y =
                                window.innerHeight;
                        }


                        if (
                            particle.y >
                            window.innerHeight
                        ) {
                            particle.y = 0;
                        }


                        /* Particle */

                        ctx.beginPath();


                        ctx.arc(
                            particle.x,
                            particle.y,
                            particle.size,
                            0,
                            Math.PI * 2,
                        );


                        /*
                         * Light blue particles
                         */

                        ctx.fillStyle =
                            "rgba(14,165,233,0.28)";


                        ctx.fill();

                    },
                );


                /* =============================================
                   CONNECTIONS
                   ============================================= */

                for (
                    let i = 0;
                    i < particles.length;
                    i++
                ) {

                    for (
                        let j = i + 1;
                        j < particles.length;
                        j++
                    ) {

                        const a =
                            particles[i];

                        const b =
                            particles[j];


                        const dx =
                            a.x - b.x;

                        const dy =
                            a.y - b.y;


                        const distance =
                            Math.sqrt(
                                dx * dx +
                                dy * dy,
                            );


                        if (
                            distance < 130
                        ) {

                            const opacity =
                                (1 -
                                    distance /
                                        130) *
                                0.10;


                            ctx.beginPath();


                            ctx.moveTo(
                                a.x,
                                a.y,
                            );


                            ctx.lineTo(
                                b.x,
                                b.y,
                            );


                            ctx.strokeStyle =
                                `rgba(14,165,233,${opacity})`;


                            ctx.lineWidth =
                                0.7;


                            ctx.stroke();

                        }

                    }

                }


                animationFrame =
                    requestAnimationFrame(
                        draw,
                    );

            };


            /* =================================================
               EVENTS
               ================================================= */

            window.addEventListener(
                "resize",
                resizeCanvas,
            );


            resizeCanvas();

            draw();


            /* =================================================
               CLEANUP
               ================================================= */

            document.addEventListener(
                "astro:before-swap",
                () => {

                    cancelAnimationFrame(
                        animationFrame,
                    );


                    window.removeEventListener(
                        "resize",
                        resizeCanvas,
                    );

                },
                { once: true },
            );

        }

    }

</script>