---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-white text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- Particle canvas -->
            <canvas
                id="particleCanvas"
                class="absolute inset-0 w-full h-full"
            ></canvas>

            <!-- AI sphere -->
            <div class="liquid-ai-visual" aria-hidden="true">
                <div class="liquid-orb orb-one"></div>
                <div class="liquid-orb orb-two"></div>
                <div class="liquid-orb orb-three"></div>
                <div class="liquid-ribbon ribbon-one"></div>
                <div class="liquid-ribbon ribbon-two"></div>
                <div class="liquid-ribbon ribbon-three"></div>
                <div class="liquid-highlight highlight-one"></div>
                <div class="liquid-highlight highlight-two"></div>
                <div class="liquid-grain"></div>
            </div>v>
            </div>

            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-36 pb-20"
        >

            <!-- Clean content area -->
            <div
                class="relative overflow-hidden rounded-[2rem] border border-white/65 bg-white/18 backdrop-blur-[3px] shadow-[0_30px_100px_-40px_rgba(71,85,105,0.22)]"
            >

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center px-7 py-20 sm:px-12 lg:px-20"
                >

                    <div class="max-w-5xl">

                        <!-- =================================================
                             UNIVERSITY
                             ================================================= -->

                        <div
                            class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 mb-8 shadow-sm backdrop-blur-md"
                        >

                            <span
                                class="w-2 h-2 rounded-full bg-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.6)]"
                            ></span>

                            <span
                                class="text-xs sm:text-sm tracking-wide text-slate-700"
                            >
                                University of Peradeniya · Faculty of Engineering
                            </span>

                        </div>


                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] leading-[0.88] tracking-tight max-w-5xl text-slate-900"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-slate-700">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-8 max-w-2xl text-base sm:text-lg lg:text-xl text-slate-600 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-10 flex flex-wrap items-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-white/70 bg-white/55 px-7 py-3.5 text-sm font-medium text-slate-700 backdrop-blur-md transition-all duration-300 hover:bg-white/80 hover:border-sky-300/60 shadow-sm"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-white/50 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-slate-500"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="The latest"
            title="News & milestones"
            description="Awards, papers, talks and stories from the lab."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-slate-950 text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-sky-300 opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>

    /* =========================================================
       HERO — CLEAN LIGHT BACKGROUND
       ========================================================= */

    /* =========================================================
       PREMIUM LIQUID AI LIGHT
       ========================================================= */

    .liquid-ai-visual {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        background:
            radial-gradient(ellipse at 72% 44%, rgba(124,58,237,.22), transparent 38%),
            radial-gradient(ellipse at 34% 58%, rgba(6,182,212,.16), transparent 42%),
            radial-gradient(ellipse at 58% 28%, rgba(168,85,247,.10), transparent 34%),
            linear-gradient(135deg,#050611 0%,#090b18 42%,#0b0a1a 72%,#060711 100%);
    }

    .liquid-orb,.liquid-ribbon,.liquid-highlight {
        position:absolute;
        border-radius:999px;
        will-change:transform;
    }

    .liquid-orb { filter:blur(26px); mix-blend-mode:screen; }

    .orb-one {
        width:52%;height:46%;left:48%;top:25%;
        background:radial-gradient(ellipse,rgba(139,92,246,.40),rgba(99,102,241,.14) 48%,transparent 72%);
        animation:orbOne 11s ease-in-out infinite;
    }

    .orb-two {
        width:46%;height:42%;left:25%;top:42%;
        background:radial-gradient(ellipse,rgba(34,211,238,.30),rgba(14,165,233,.10) 48%,transparent 72%);
        animation:orbTwo 13s ease-in-out infinite;
    }

    .orb-three {
        width:32%;height:30%;left:55%;top:55%;
        background:radial-gradient(ellipse,rgba(236,72,153,.17),rgba(168,85,247,.10) 48%,transparent 72%);
        animation:orbThree 15s ease-in-out infinite;
    }

    .liquid-ribbon {
        height:clamp(55px,7vw,105px);
        filter:blur(8px);
        opacity:.78;
        background:linear-gradient(90deg,transparent 0%,rgba(34,211,238,.08) 10%,rgba(99,102,241,.45) 32%,rgba(255,255,255,.24) 48%,rgba(168,85,247,.42) 68%,transparent 100%);
        box-shadow:0 0 55px rgba(99,102,241,.25);
        mix-blend-mode:screen;
    }

    .ribbon-one {
        width:110%;left:-4%;top:37%;
        transform:rotate(-9deg);
        animation:ribbonOne 12s ease-in-out infinite;
    }

    .ribbon-two {
        width:105%;left:3%;top:53%;
        opacity:.62;
        transform:rotate(8deg);
        background:linear-gradient(90deg,transparent,rgba(14,165,233,.28),rgba(255,255,255,.18),rgba(139,92,246,.42),transparent);
        animation:ribbonTwo 14s ease-in-out infinite;
    }

    .ribbon-three {
        width:88%;left:20%;top:27%;
        height:clamp(22px,2.8vw,44px);
        opacity:.52;
        transform:rotate(-17deg);
        background:linear-gradient(90deg,transparent,rgba(168,85,247,.32),rgba(255,255,255,.22),rgba(34,211,238,.28),transparent);
        animation:ribbonThree 10s ease-in-out infinite;
    }

    .liquid-highlight {
        width:30%;height:8%;left:51%;top:39%;
        background:rgba(255,255,255,.30);
        filter:blur(16px);
        transform:rotate(-12deg);
        animation:highlightMove 8s ease-in-out infinite;
        mix-blend-mode:screen;
    }

    .highlight-two {
        width:20%;height:5%;left:68%;top:58%;
        opacity:.55;
        animation-delay:-3s;
    }

    .liquid-grain {
        position:absolute;inset:0;opacity:.045;
        background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
        mix-blend-mode:screen;
    }

    @keyframes orbOne{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(-45px,18px,0) scale(1.08)}}
    @keyframes orbTwo{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(38px,-28px,0) scale(1.1)}}
    @keyframes orbThree{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(-30px,-20px,0) scale(1.12)}}
    @keyframes ribbonOne{0%,100%{transform:translate3d(-2%,0,0) rotate(-9deg)}50%{transform:translate3d(5%,18px,0) rotate(-5deg)}}
    @keyframes ribbonTwo{0%,100%{transform:translate3d(3%,0,0) rotate(8deg)}50%{transform:translate3d(-5%,-15px,0) rotate(4deg)}}
    @keyframes ribbonThree{0%,100%{transform:translate3d(0,0,0) rotate(-17deg)}50%{transform:translate3d(-4%,24px,0) rotate(-11deg)}}
    @keyframes highlightMove{0%,100%{transform:translate3d(0,0,0) rotate(-12deg);opacity:.35}50%{transform:translate3d(55px,18px,0) rotate(-7deg);opacity:.75}}

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 1100px) {
        .liquid-ai-visual {
            opacity: 0.92;
        }

        .liquid-ai-label {
            right: 5%;
            bottom: 6%;
        }
    }

    @media (max-width: 900px) {
        .liquid-ai-visual {
            opacity: 0.72;
        }

        .liquid-ai-label {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .liquid-ai-visual {
            opacity: 0.52;
        }
    }


    /* =========================================================
       REDUCE MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .liquid-ai-visual,
        .liquid-glow,
        .liquid-core,
        .liquid-band,
        .liquid-wave,
        .liquid-particle {

            animation: none !important;
        }

    }

</style>


<!-- ============================================================= -->
<!-- PARTICLE / NEURAL NETWORK SCRIPT -->
<!-- ============================================================= -->

<script>

    const canvas =
        document.getElementById(
            "particleCanvas",
        ) as HTMLCanvasElement | null;


    if (canvas) {

        const ctx =
            canvas.getContext("2d");


        if (ctx) {

            let particles: {
                x: number;
                y: number;
                vx: number;
                vy: number;
                size: number;
            }[] = [];


            let animationFrame: number;


            /* =================================================
               RESIZE
               ================================================= */

            const resizeCanvas = () => {

                const dpr =
                    Math.min(
                        window.devicePixelRatio || 1,
                        2,
                    );


                canvas.width =
                    window.innerWidth * dpr;


                canvas.height =
                    window.innerHeight * dpr;


                canvas.style.width =
                    `${window.innerWidth}px`;


                canvas.style.height =
                    `${window.innerHeight}px`;


                ctx.setTransform(
                    dpr,
                    0,
                    0,
                    dpr,
                    0,
                    0,
                );


                createParticles();
            };


            /* =================================================
               CREATE PARTICLES
               ================================================= */

            const createParticles = () => {

                const amount =
                    window.innerWidth < 768
                        ? 35
                        : 75;


                particles = [];


                for (
                    let i = 0;
                    i < amount;
                    i++
                ) {

                    particles.push({

                        x:
                            Math.random() *
                            window.innerWidth,

                        y:
                            Math.random() *
                            window.innerHeight,

                        vx:
                            (Math.random() - 0.5) *
                            0.25,

                        vy:
                            (Math.random() - 0.5) *
                            0.25,

                        size:
                            Math.random() *
                                1.8 +
                            0.5,

                    });

                }

            };


            /* =================================================
               DRAW
               ================================================= */

            const draw = () => {

                ctx.clearRect(
                    0,
                    0,
                    window.innerWidth,
                    window.innerHeight,
                );


                /* =============================================
                   MOVE PARTICLES
                   ============================================= */

                particles.forEach(
                    (particle) => {

                        particle.x +=
                            particle.vx;

                        particle.y +=
                            particle.vy;


                        if (
                            particle.x < 0
                        ) {
                            particle.x =
                                window.innerWidth;
                        }


                        if (
                            particle.x >
                            window.innerWidth
                        ) {
                            particle.x = 0;
                        }


                        if (
                            particle.y < 0
                        ) {
                            particle.y =
                                window.innerHeight;
                        }


                        if (
                            particle.y >
                            window.innerHeight
                        ) {
                            particle.y = 0;
                        }


                        /* Particle */

                        ctx.beginPath();


                        ctx.arc(
                            particle.x,
                            particle.y,
                            particle.size,
                            0,
                            Math.PI * 2,
                        );


                        /*
                         * Light blue particles
                         */

                        ctx.fillStyle =
                            "rgba(14,165,233,0.18)";


                        ctx.fill();

                    },
                );


                /* =============================================
                   CONNECTIONS
                   ============================================= */

                for (
                    let i = 0;
                    i < particles.length;
                    i++
                ) {

                    for (
                        let j = i + 1;
                        j < particles.length;
                        j++
                    ) {

                        const a =
                            particles[i];

                        const b =
                            particles[j];


                        const dx =
                            a.x - b.x;

                        const dy =
                            a.y - b.y;


                        const distance =
                            Math.sqrt(
                                dx * dx +
                                dy * dy,
                            );


                        if (
                            distance < 130
                        ) {

                            const opacity =
                                (1 -
                                    distance /
                                        130) *
                                0.10;


                            ctx.beginPath();


                            ctx.moveTo(
                                a.x,
                                a.y,
                            );


                            ctx.lineTo(
                                b.x,
                                b.y,
                            );


                            ctx.strokeStyle =
                                `rgba(14,165,233,${opacity})`;


                            ctx.lineWidth =
                                0.7;


                            ctx.stroke();

                        }

                    }

                }


                animationFrame =
                    requestAnimationFrame(
                        draw,
                    );

            };


            /* =================================================
               EVENTS
               ================================================= */

            window.addEventListener(
                "resize",
                resizeCanvas,
            );


            resizeCanvas();

            draw();


            /* =================================================
               CLEANUP
               ================================================= */

            document.addEventListener(
                "astro:before-swap",
                () => {

                    cancelAnimationFrame(
                        animationFrame,
                    );


                    window.removeEventListener(
                        "resize",
                        resizeCanvas,
                    );

                },
                { once: true },
            );

        }

    }

</script>