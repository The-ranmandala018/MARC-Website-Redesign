---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-white text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- 3D particle sphere -->
            <canvas
                id="particleCanvas"
                class="absolute inset-0 w-full h-full z-[10] pointer-events-none"
                aria-hidden="true"
            ></canvas>

            <!-- Particle vortex inspired by the supplied reference -->
            <div class="particle-vortex-glow" aria-hidden="true"></div>
            <div class="particle-vortex-core" aria-hidden="true"></div>
            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-36 pb-20"
        >

            <!-- Clean content area -->
            <div class="relative">

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center px-7 py-20 sm:px-12 lg:px-20 lg:translate-x-12"
                >

                    <div class="max-w-5xl">

                        <!-- =================================================
                             UNIVERSITY
                             ================================================= -->

                        <div
                            class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 mb-8 shadow-sm backdrop-blur-md"
                        >

                            <span
                                class="w-2 h-2 rounded-full bg-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.6)]"
                            ></span>

                            <span
                                class="text-xs sm:text-sm tracking-wide text-slate-700 dark:text-slate-200"
                            >
                                University of Peradeniya · Faculty of Engineering
                            </span>

                        </div>


                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display font-semibold text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] leading-[0.88] tracking-tight max-w-5xl text-[#0F172A] dark:text-white"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-slate-700 dark:text-slate-100">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-8 max-w-2xl text-base sm:text-lg lg:text-xl text-slate-600 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-10 flex flex-wrap items-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-white/70 bg-white/55 px-7 py-3.5 text-sm font-medium text-slate-700 backdrop-blur-md transition-all duration-300 hover:bg-white/80 hover:border-sky-300/60 shadow-sm"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-white/50 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-slate-500"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>



    <!-- ========================================================= -->
    <!-- ABOUT MARC -->
    <!-- ========================================================= -->

    <section id="about" class="py-20 lg:py-28 bg-white dark:bg-slate-950">
        <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-20 items-start">
                <div>
                    <p class="eyebrow text-[#004AAD] dark:text-[#5170FF] mb-4">About MARC</p>
                    <h2 class="font-display text-4xl md:text-5xl leading-tight text-slate-900 dark:text-white">
                        AI research across disciplines.
                    </h2>
                </div>
                <div class="space-y-5 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
                    <p>
                        The Multidisciplinary AI Research Centre (MARC) brings together researchers
                        from different disciplines to develop intelligent systems for meaningful
                        real-world impact.
                    </p>
                    <p>
                        Based at the University of Peradeniya, MARC connects foundational AI
                        research with practical challenges in engineering, science, health,
                        energy and society.
                    </p>
                    <a href="/Research" class="inline-flex items-center gap-2 text-sm font-semibold text-[#004AAD] dark:text-[#5170FF] hover:gap-3 transition-all">
                        Explore our research
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="Latest updates"
            title="Latest News"
            description="Discover the latest research, achievements, events and updates from MARC."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-[#0B0405] text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-[#5170FF] opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>

    /* =========================================================
       HERO — CLEAN LIGHT BACKGROUND
       ========================================================= */

    /* =========================================================
       PREMIUM LIQUID AI LIGHT
       ========================================================= */

    /* =========================================================
       3D-LIKE PARTICLE FLOW — LIGHT MARC THEME
       ========================================================= */

    .particle-vortex-glow {
        position:absolute;
        width:52vw;
        height:44vw;
        min-width:520px;
        min-height:360px;
        left:67%;
        top:53%;
        transform:translate(-50%,-50%);
        border-radius:50%;
        background:
            radial-gradient(
                ellipse,
                rgba(124,14,36,.20) 0%,
                rgba(81,112,255,.07) 32%,
                rgba(0,74,173,.07) 54%,
                transparent 74%
            );
        filter:blur(24px);
        pointer-events:none;
    }

    .particle-vortex-core {
        position:absolute;
        width:270px;
        height:190px;
        left:67%;
        top:54%;
        transform:translate(-50%,-50%);
        border-radius:50%;
        background:
            radial-gradient(
                ellipse,
                rgba(255,255,255,1) 0%,
                rgba(81,112,255,.34) 15%,
                rgba(0,74,173,.10) 38%,
                transparent 73%
            );
        filter:blur(22px);
        opacity:.72;
        pointer-events:none;
        animation:vortexCore 8s ease-in-out infinite;
    }

    @keyframes vortexCore {
        0%,100% {
            transform:translate(-50%,-50%) scale(1);
            opacity:.55;
        }
        50% {
            transform:translate(-50%,-50%) scale(1.18);
            opacity:.82;
        }
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 1100px) {
        .liquid-ai-visual {
            opacity: 0.92;
        }

        .liquid-ai-label {
            right: 5%;
            bottom: 6%;
        }
    }

    @media (max-width: 900px) {
        .liquid-ai-visual {
            opacity: 0.72;
        }

        .liquid-ai-label {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .liquid-ai-visual {
            opacity: 0.52;
        }
    }


    /* =========================================================
       REDUCE MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .liquid-ai-visual,
        .liquid-glow,
        .liquid-core,
        .liquid-band,
        .liquid-wave,
        .liquid-particle {

            animation: none !important;
        }

    }

</style>


<!-- ============================================================= -->
<!-- ============================================================= -->
<!-- PARTICLE SPHERE SCRIPT -->
<!-- ============================================================= -->

<script>
const canvas = document.getElementById("particleCanvas") as HTMLCanvasElement | null;

if (canvas) {
    const ctx = canvas.getContext("2d");

    if (ctx) {
        let w = 0;
        let h = 0;
        let dpr = 1;
        let raf = 0;
        let time = 0;

        type Particle = {
            x: number;
            y: number;
            z: number;
            size: number;
            alpha: number;
            phase: number;
        };

        let particles: Particle[] = [];

        const resize = () => {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            w = window.innerWidth;
            h = window.innerHeight;

            canvas.width = w * dpr;
            canvas.height = h * dpr;
            canvas.style.width = w + "px";
            canvas.style.height = h + "px";

            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            const count = w < 768 ? 1700 : 4200;

            particles = Array.from({ length: count }, () => {
                const u = Math.random();
                const v = Math.random();

                const theta = 2 * Math.PI * u;
                const phi = Math.acos(2 * v - 1);

                // Slightly hollow / atmospheric sphere, like the reference.
                const radius = 0.72 + Math.pow(Math.random(), 1.8) * 0.32;

                return {
                    x: radius * Math.sin(phi) * Math.cos(theta),
                    y: radius * Math.cos(phi),
                    z: radius * Math.sin(phi) * Math.sin(theta),
                    size: 0.45 + Math.random() * 1.55,
                    alpha: 0.35 + Math.random() * 0.65,
                    phase: Math.random() * Math.PI * 2,
                };
            });
        };

        const draw = () => {
            time += 0.006;
            ctx.clearRect(0, 0, w, h);

            // Keep the particle sphere on the right side of the hero.
            const cx = w * 0.72;
            const cy = h * 0.52;
            const radius = Math.min(w, h) * (w < 768 ? 0.40 : 0.52);

            const cosY = Math.cos(time * 0.75);
            const sinY = Math.sin(time * 0.75);
            const cosX = Math.cos(Math.sin(time * 0.32) * 0.22);
            const sinX = Math.sin(Math.sin(time * 0.32) * 0.22);

            const projected = particles.map((p) => {
                // Rotate around Y.
                const rx = p.x * cosY - p.z * sinY;
                const rz = p.x * sinY + p.z * cosY;

                // Small X rotation for a natural 3D movement.
                const ry = p.y * cosX - rz * sinX;
                const rz2 = p.y * sinX + rz * cosX;

                const perspective = 1 / (1.55 - rz2 * 0.42);

                return {
                    x: cx + rx * radius * perspective,
                    y: cy + ry * radius * perspective,
                    z: rz2,
                    size: p.size * perspective,
                    alpha: p.alpha * (0.38 + (rz2 + 1) * 0.31),
                    phase: p.phase,
                };
            });

            // Back particles first, then front particles.
            projected.sort((a, b) => a.z - b.z);

            for (const p of projected) {
                const twinkle =
                    0.78 +
                    Math.sin(time * 3.2 + p.phase) * 0.22;

                const alpha = Math.max(
                    0.10,
                    Math.min(1, p.alpha * twinkle * 1.45)
                );

                // Stronger MARC blue/wine particles for better visibility.
                const accent =
                    p.phase % 3.2 < 0.34
                        ? "124,14,36"
                        : p.phase % 3.2 < 0.72
                          ? "0,74,173"
                          : "81,112,255";

                const glow = ctx.createRadialGradient(
                    p.x,
                    p.y,
                    0,
                    p.x,
                    p.y,
                    Math.max(2, p.size * 4)
                );

                glow.addColorStop(
                    0,
                    "rgba(" + accent + "," + alpha + ")"
                );
                glow.addColorStop(
                    0.35,
                    "rgba(" + accent + "," + alpha * 0.42 + ")"
                );
                glow.addColorStop(
                    1,
                    "rgba(" + accent + ",0)"
                );

                ctx.fillStyle = glow;
                ctx.beginPath();
                ctx.arc(
                    p.x,
                    p.y,
                    Math.max(2, p.size * 4),
                    0,
                    Math.PI * 2
                );
                ctx.fill();

                ctx.fillStyle =
                    "rgba(255,255,255," +
                    Math.min(1, alpha + 0.22) +
                    ")";

                ctx.beginPath();
                ctx.arc(
                    p.x,
                    p.y,
                    Math.max(0.35, p.size),
                    0,
                    Math.PI * 2
                );
                ctx.fill();
            }

            raf = requestAnimationFrame(draw);
        };

        resize();
        draw();

        window.addEventListener("resize", resize);

        document.addEventListener(
            "astro:before-swap",
            () => {
                cancelAnimationFrame(raf);
                window.removeEventListener("resize", resize);
            },
            { once: true }
        );
    }
}
</script>
