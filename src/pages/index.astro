---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-white text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- Particle canvas -->
            <canvas
                id="particleCanvas"
                class="absolute inset-0 w-full h-full"
            ></canvas>

            <!-- AI sphere -->
            <div class="liquid-ai-visual" aria-hidden="true">
                <div class="liquid-glow"></div>
                <div class="liquid-core"></div>
                <div class="liquid-band liquid-band-top"></div>
                <div class="liquid-band liquid-band-bottom"></div>

                <svg class="liquid-waves" viewBox="0 0 620 560" preserveAspectRatio="none" role="presentation">
                    <defs>
                        <linearGradient id="liquidWaveOne" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#312e81" />
                            <stop offset="35%" stop-color="#7c3aed" />
                            <stop offset="62%" stop-color="#22d3ee" />
                            <stop offset="100%" stop-color="#2563eb" />
                        </linearGradient>

                        <linearGradient id="liquidWaveTwo" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#0ea5e9" />
                            <stop offset="45%" stop-color="#8b5cf6" />
                            <stop offset="100%" stop-color="#4338ca" />
                        </linearGradient>

                        <filter id="liquidBlur">
                            <feGaussianBlur stdDeviation="8" />
                        </filter>

                        <filter id="liquidGlow">
                            <feGaussianBlur stdDeviation="4" result="blur" />
                            <feMerge>
                                <feMergeNode in="blur" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                    </defs>

                    <path class="liquid-wave wave-back"
                        d="M-40 385 C85 300 105 300 205 350 S355 455 455 390 S570 280 660 315" />

                    <path class="liquid-wave wave-main"
                        d="M-40 415 C75 355 120 315 220 345 S340 445 430 390 S550 275 660 295" />

                    <path class="liquid-wave wave-light"
                        d="M-40 402 C85 340 130 318 220 350 S350 430 435 382 S555 280 660 300" />

                    <path class="liquid-wave wave-top"
                        d="M-30 215 C90 205 120 180 230 205 S380 265 475 225 S570 165 660 185" />
                </svg>

                <span class="liquid-particle particle-a"></span>
                <span class="liquid-particle particle-b"></span>
                <span class="liquid-particle particle-c"></span>
                <span class="liquid-particle particle-d"></span>
                <span class="liquid-particle particle-e"></span>

                <div class="liquid-ai-label">
                    <span class="liquid-ai-dot"></span>
                    AI · Intelligence · Innovation
                </div>
            </div>

            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-36 pb-20"
        >

            <!-- Clean content area -->
            <div
                class="relative overflow-hidden rounded-[2rem] border border-white/20 bg-white/5 dark:border-white/10 dark:bg-slate-950/20 backdrop-blur-[2px] shadow-[0_30px_100px_-40px_rgba(15,23,42,0.35)]"
            >

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center px-7 py-20 sm:px-12 lg:px-20"
                >

                    <div class="max-w-5xl">

                        <!-- =================================================
                             UNIVERSITY
                             ================================================= -->

                        <div
                            class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 mb-8 shadow-sm backdrop-blur-md"
                        >

                            <span
                                class="w-2 h-2 rounded-full bg-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.6)]"
                            ></span>

                            <span
                                class="text-xs sm:text-sm tracking-wide text-slate-200"
                            >
                                University of Peradeniya · Faculty of Engineering
                            </span>

                        </div>


                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] leading-[0.88] tracking-tight max-w-5xl text-white"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-white/90">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-8 max-w-2xl text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-300 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-10 flex flex-wrap items-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 px-7 py-3.5 text-sm font-medium text-white/85 backdrop-blur-md transition-all duration-300 hover:bg-white/15 hover:border-sky-300/50"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-white/10 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-white/45"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="The latest"
            title="News & milestones"
            description="Awards, papers, talks and stories from the lab."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-slate-950 text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-sky-300 opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>

    /* =========================================================
       HERO — CLEAN LIGHT BACKGROUND
       ========================================================= */

    /* =========================================================
       LIQUID AI VISUAL — ABSTRACT INTELLIGENCE
       ========================================================= */

    .liquid-ai-visual {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 4;
        overflow: hidden;
        border-radius: 0;
        pointer-events: none;
        background:
            radial-gradient(circle at 72% 48%, rgba(168,85,247,0.30), transparent 34%),
            radial-gradient(circle at 38% 55%, rgba(14,165,233,0.20), transparent 40%),
            linear-gradient(135deg, #020617 0%, #050816 48%, #020617 100%);
        box-shadow: inset 0 0 140px rgba(37,99,235,0.12);
        animation: liquidBackgroundFloat 12s ease-in-out infinite;
    }

    .liquid-ai-visual::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 8;
        background:
            linear-gradient(90deg, rgba(2,6,23,0.86) 0%, rgba(2,6,23,0.52) 34%, rgba(2,6,23,0.12) 68%, rgba(2,6,23,0.28) 100%),
            radial-gradient(circle at 70% 52%, transparent 0%, rgba(2,6,23,0.10) 52%, rgba(2,6,23,0.55) 100%);
    }

    .liquid-ai-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 9;
        pointer-events: none;
        background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent 22%, transparent 78%, rgba(0,0,0,0.18));
    }

    .liquid-glow {
        position: absolute;
        width: min(58vw, 760px);
        height: min(42vw, 430px);
        left: 34%;
        top: 24%;
        border-radius: 50%;
        background:
            radial-gradient(circle,
                rgba(168,85,247,0.45) 0%,
                rgba(99,102,241,0.20) 32%,
                rgba(14,165,233,0.10) 55%,
                transparent 75%);
        filter: blur(35px);
        animation: liquidGlow 6s ease-in-out infinite;
    }

    .liquid-core {
        position: absolute;
        width: min(46vw, 650px);
        height: min(13vw, 150px);
        left: 8%;
        top: 39%;
        border-radius: 50%;
        background: radial-gradient(ellipse, rgba(255,255,255,0.96) 0%, rgba(216,180,254,0.82) 16%, rgba(168,85,247,0.45) 40%, transparent 72%);
        filter: blur(18px);
        opacity: 0.9;
        animation: coreBreath 5s ease-in-out infinite;
    }

    .liquid-band {
        position: absolute;
        left: -8%;
        width: 116%;
        height: clamp(70px, 8vw, 120px);
        border-radius: 50%;
        filter: blur(13px);
        transform-origin: center;
    }

    .liquid-band-top {
        top: 30%;
        background: linear-gradient(90deg, transparent 0%, rgba(124,58,237,0.55) 22%, rgba(255,255,255,0.92) 48%, rgba(34,211,238,0.45) 72%, transparent 100%);
        animation: bandSweep 7s ease-in-out infinite;
    }

    .liquid-band-bottom {
        top: 64%;
        background: linear-gradient(90deg, transparent 0%, rgba(14,165,233,0.42) 20%, rgba(129,140,248,0.75) 48%, rgba(168,85,247,0.55) 70%, transparent 100%);
        animation: bandSweepReverse 8s ease-in-out infinite;
    }

    .liquid-waves {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .liquid-wave {
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 900;
        animation: waveFlow 9s linear infinite;
    }

    .wave-back {
        stroke: url(#liquidWaveTwo);
        stroke-width: clamp(30px, 3vw, 52px);
        opacity: 0.20;
        filter: url(#liquidBlur);
        animation-duration: 13s;
    }

    .wave-main {
        stroke: url(#liquidWaveOne);
        stroke-width: clamp(22px, 2.2vw, 38px);
        opacity: 0.82;
        filter: url(#liquidGlow);
    }

    .wave-light {
        stroke: rgba(255,255,255,0.86);
        stroke-width: clamp(2px, 0.22vw, 4px);
        opacity: 0.82;
        filter: url(#liquidGlow);
        animation-duration: 7s;
    }

    .wave-top {
        stroke: url(#liquidWaveTwo);
        stroke-width: clamp(10px, 1vw, 18px);
        opacity: 0.36;
        filter: url(#liquidGlow);
        animation-duration: 11s;
    }

    .liquid-particle {
        position: absolute;
        z-index: 7;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow:
            0 0 8px #38bdf8,
            0 0 22px rgba(56,189,248,0.65);
        animation: particleFloat 5s ease-in-out infinite;
    }

    .particle-a { left: 76%; top: 24%; animation-delay: -1s; }
    .particle-b { left: 83%; top: 54%; animation-delay: -2.4s; }
    .particle-c { left: 70%; top: 76%; animation-delay: -3.2s; }
    .particle-d { left: 57%; top: 33%; width: 4px; height: 4px; animation-delay: -0.8s; }
    .particle-e { left: 91%; top: 38%; width: 4px; height: 4px; animation-delay: -4s; }

    .liquid-ai-label {
        position: absolute;
        z-index: 10;
        right: 6%;
        bottom: 7%;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(3,7,18,0.42);
        backdrop-filter: blur(12px);
        color: rgba(226,232,240,0.72);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        box-shadow: 0 8px 30px rgba(0,0,0,0.24);
    }

    .liquid-ai-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: linear-gradient(135deg,#22d3ee,#a855f7);
        box-shadow: 0 0 12px rgba(56,189,248,0.9);
    }

    @keyframes liquidBackgroundFloat {
        0%,100% { transform: scale(1) translate3d(0,0,0); }
        50% { transform: scale(1.025) translate3d(-8px,-4px,0); }
    }

    @keyframes liquidGlow {
        0%,100% { opacity: 0.65; transform: scale(0.92); }
        50% { opacity: 1; transform: scale(1.08); }
    }

    @keyframes coreBreath {
        0%,100% { opacity: 0.65; transform: scale(0.92) translateX(-8px); }
        50% { opacity: 1; transform: scale(1.08) translateX(10px); }
    }

    @keyframes bandSweep {
        0%,100% { transform: translateX(-8%) scaleY(0.82); opacity: 0.65; }
        50% { transform: translateX(7%) scaleY(1.08); opacity: 1; }
    }

    @keyframes bandSweepReverse {
        0%,100% { transform: translateX(7%) scaleY(0.88); opacity: 0.65; }
        50% { transform: translateX(-7%) scaleY(1.1); opacity: 1; }
    }

    @keyframes waveFlow {
        from { stroke-dashoffset: 0; }
        to { stroke-dashoffset: -900; }
    }

    @keyframes particleFloat {
        0%,100% { transform: translate3d(0,0,0) scale(0.8); opacity: 0.45; }
        50% { transform: translate3d(-18px,-20px,0) scale(1.35); opacity: 1; }
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 1100px) {
        .liquid-ai-visual {
            opacity: 0.92;
        }

        .liquid-ai-label {
            right: 5%;
            bottom: 6%;
        }
    }

    @media (max-width: 900px) {
        .liquid-ai-visual {
            opacity: 0.72;
        }

        .liquid-ai-label {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .liquid-ai-visual {
            opacity: 0.52;
        }
    }


    /* =========================================================
       REDUCE MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .liquid-ai-visual,
        .liquid-glow,
        .liquid-core,
        .liquid-band,
        .liquid-wave,
        .liquid-particle {

            animation: none !important;
        }

    }

</style>


<!-- ============================================================= -->
<!-- PARTICLE / NEURAL NETWORK SCRIPT -->
<!-- ============================================================= -->

<script>

    const canvas =
        document.getElementById(
            "particleCanvas",
        ) as HTMLCanvasElement | null;


    if (canvas) {

        const ctx =
            canvas.getContext("2d");


        if (ctx) {

            let particles: {
                x: number;
                y: number;
                vx: number;
                vy: number;
                size: number;
            }[] = [];


            let animationFrame: number;


            /* =================================================
               RESIZE
               ================================================= */

            const resizeCanvas = () => {

                const dpr =
                    Math.min(
                        window.devicePixelRatio || 1,
                        2,
                    );


                canvas.width =
                    window.innerWidth * dpr;


                canvas.height =
                    window.innerHeight * dpr;


                canvas.style.width =
                    `${window.innerWidth}px`;


                canvas.style.height =
                    `${window.innerHeight}px`;


                ctx.setTransform(
                    dpr,
                    0,
                    0,
                    dpr,
                    0,
                    0,
                );


                createParticles();
            };


            /* =================================================
               CREATE PARTICLES
               ================================================= */

            const createParticles = () => {

                const amount =
                    window.innerWidth < 768
                        ? 35
                        : 75;


                particles = [];


                for (
                    let i = 0;
                    i < amount;
                    i++
                ) {

                    particles.push({

                        x:
                            Math.random() *
                            window.innerWidth,

                        y:
                            Math.random() *
                            window.innerHeight,

                        vx:
                            (Math.random() - 0.5) *
                            0.25,

                        vy:
                            (Math.random() - 0.5) *
                            0.25,

                        size:
                            Math.random() *
                                1.8 +
                            0.5,

                    });

                }

            };


            /* =================================================
               DRAW
               ================================================= */

            const draw = () => {

                ctx.clearRect(
                    0,
                    0,
                    window.innerWidth,
                    window.innerHeight,
                );


                /* =============================================
                   MOVE PARTICLES
                   ============================================= */

                particles.forEach(
                    (particle) => {

                        particle.x +=
                            particle.vx;

                        particle.y +=
                            particle.vy;


                        if (
                            particle.x < 0
                        ) {
                            particle.x =
                                window.innerWidth;
                        }


                        if (
                            particle.x >
                            window.innerWidth
                        ) {
                            particle.x = 0;
                        }


                        if (
                            particle.y < 0
                        ) {
                            particle.y =
                                window.innerHeight;
                        }


                        if (
                            particle.y >
                            window.innerHeight
                        ) {
                            particle.y = 0;
                        }


                        /* Particle */

                        ctx.beginPath();


                        ctx.arc(
                            particle.x,
                            particle.y,
                            particle.size,
                            0,
                            Math.PI * 2,
                        );


                        /*
                         * Light blue particles
                         */

                        ctx.fillStyle =
                            "rgba(14,165,233,0.28)";


                        ctx.fill();

                    },
                );


                /* =============================================
                   CONNECTIONS
                   ============================================= */

                for (
                    let i = 0;
                    i < particles.length;
                    i++
                ) {

                    for (
                        let j = i + 1;
                        j < particles.length;
                        j++
                    ) {

                        const a =
                            particles[i];

                        const b =
                            particles[j];


                        const dx =
                            a.x - b.x;

                        const dy =
                            a.y - b.y;


                        const distance =
                            Math.sqrt(
                                dx * dx +
                                dy * dy,
                            );


                        if (
                            distance < 130
                        ) {

                            const opacity =
                                (1 -
                                    distance /
                                        130) *
                                0.10;


                            ctx.beginPath();


                            ctx.moveTo(
                                a.x,
                                a.y,
                            );


                            ctx.lineTo(
                                b.x,
                                b.y,
                            );


                            ctx.strokeStyle =
                                `rgba(14,165,233,${opacity})`;


                            ctx.lineWidth =
                                0.7;


                            ctx.stroke();

                        }

                    }

                }


                animationFrame =
                    requestAnimationFrame(
                        draw,
                    );

            };


            /* =================================================
               EVENTS
               ================================================= */

            window.addEventListener(
                "resize",
                resizeCanvas,
            );


            resizeCanvas();

            draw();


            /* =================================================
               CLEANUP
               ================================================= */

            document.addEventListener(
                "astro:before-swap",
                () => {

                    cancelAnimationFrame(
                        animationFrame,
                    );


                    window.removeEventListener(
                        "resize",
                        resizeCanvas,
                    );

                },
                { once: true },
            );

        }

    }

</script>