---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import Section from "../components/ui/Section.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const researchAreas = Object.values(
    import.meta.glob("./Research/*.md", { eager: true }),
);

const researchImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const getResearchImage = (filename: string) =>
    researchImages[`/src/assets/${filename}`]?.default;

const allNews = await getCollection("news");

const latestNews = allNews
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const allProjects = await getCollection("projects");
const allPubs = await getCollection("publications");
const allPeople = await getCollection("people");

const stats = [
    { label: "Research areas", value: researchAreas.length },
    { label: "Active projects", value: allProjects.length },
    { label: "Publications", value: allPubs.length },
    { label: "Researchers", value: allPeople.length },
];
---

<BaseLayout
    title="Multidisciplinary AI Research Centre"
    description="MARC advances multidisciplinary AI research at the Faculty of Engineering, University of Peradeniya — across computer vision, generative AI, biomedical, smart grid, MSI and socioeconomic systems."
    fullWidth={true}
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section
        class="relative min-h-screen overflow-hidden bg-white text-slate-900 dark:bg-slate-950 dark:text-white"
    >

        <!-- ===================================================== -->
        <!-- BACKGROUND -->
        <!-- ===================================================== -->

        <div class="absolute inset-0 overflow-hidden">

            <!-- Particle canvas -->
            <canvas
                id="particleCanvas"
                class="absolute inset-0 w-full h-full"
            ></canvas>

            <!-- Particle vortex inspired by the supplied reference -->
            <div class="particle-vortex-glow" aria-hidden="true"></div>
            <div class="particle-vortex-core" aria-hidden="true"></div>
            <!--
                IMPORTANT:
                No dark overlay here.
            -->

          

            <!-- Light grid -->
            <div class="hero-grid absolute inset-0"></div>

        </div>


        <!-- ===================================================== -->
        <!-- HERO CONTENT -->
        <!-- ===================================================== -->

        <div
            class="relative z-20 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-36 pb-20"
        >

            <!-- Clean content area -->
            <div
                class="relative overflow-hidden rounded-[2rem] border border-white/65 bg-white/18 backdrop-blur-[3px] shadow-[0_30px_100px_-40px_rgba(71,85,105,0.22)]"
            >

                <div
                    class="relative min-h-[650px] lg:min-h-[720px] flex items-center px-7 py-20 sm:px-12 lg:px-20"
                >

                    <div class="max-w-5xl">

                        <!-- =================================================
                             UNIVERSITY
                             ================================================= -->

                        <div
                            class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 mb-8 shadow-sm backdrop-blur-md"
                        >

                            <span
                                class="w-2 h-2 rounded-full bg-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.6)]"
                            ></span>

                            <span
                                class="text-xs sm:text-sm tracking-wide text-slate-700"
                            >
                                University of Peradeniya · Faculty of Engineering
                            </span>

                        </div>


                        <!-- =================================================
                             MAIN HEADING
                             ================================================= -->

                        <h1
                            class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] leading-[0.88] tracking-tight max-w-5xl text-slate-900"
                        >

                            Multidisciplinary

                            <br />

                            <span class="text-gradient">
                                AI Research
                            </span>

                            <br />

                            <span class="text-slate-700">
                                for a human future.
                            </span>

                        </h1>


                        <!-- =================================================
                             DESCRIPTION
                             ================================================= -->

                        <p
                            class="mt-8 max-w-2xl text-base sm:text-lg lg:text-xl text-slate-600 leading-relaxed"
                        >
                            MARC brings together engineers, scientists and
                            researchers to develop intelligent systems that
                            address real-world challenges through
                            interdisciplinary AI research.
                        </p>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div
                            class="mt-10 flex flex-wrap items-center gap-4"
                        >

                            <!-- Research -->

                            <a
                                href="/Research"
                                class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-sky-600 to-blue-700 text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_35px_rgba(14,165,233,0.25)]"
                            >

                                Explore Research

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 12h14M13 5l7 7-7 7"
                                    ></path>
                                </svg>

                            </a>


                            <!-- Contact -->

                            <a
                                href="/contact"
                                class="inline-flex items-center gap-3 rounded-full border border-white/70 bg-white/55 px-7 py-3.5 text-sm font-medium text-slate-700 backdrop-blur-md transition-all duration-300 hover:bg-white/80 hover:border-sky-300/60 shadow-sm"
                            >
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM INFORMATION
                     ================================================= -->

                <div
                    class="relative z-20 border-t border-white/50 px-7 py-5 sm:px-12 lg:px-20 flex flex-col sm:flex-row justify-between gap-4 text-xs sm:text-sm text-slate-500"
                >

                    <span>
                        Multidisciplinary Artificial Intelligence Research
                    </span>

                    <span>
                        MARC · UoP
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- STATS -->
    <!-- ========================================================= -->

    <section
        class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/50"
    >

        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16"
        >

            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-800"
            >

                {
                    stats.map((s) => (
                        <div class="px-6 py-4 md:py-0 first:pt-0">

                            <div class="font-display text-5xl md:text-6xl text-slate-900 dark:text-white">
                                {s.value}
                            </div>

                            <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                {s.label}
                            </div>

                        </div>
                    ))
                }

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PILLARS -->
    <!-- ========================================================= -->

    <div
        class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    >

        <Section
            eyebrow="Research"
            title="Six pillars, one shared mission"
            description="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
            cta={{ href: "/Research", label: "All research areas" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
            >

                {
                    researchAreas.map((Area: any) => (
                        <ResearchAreaCard
                            Area={Area.frontmatter.title}
                            ImageUrl={getResearchImage(
                                Area.frontmatter.coverImage,
                            )}
                            PageLink={Area.url}
                        >
                            {Area.frontmatter.short}
                        </ResearchAreaCard>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- LATEST NEWS -->
        <!-- ========================================================= -->

        <Section
            eyebrow="The latest"
            title="News & milestones"
            description="Awards, papers, talks and stories from the lab."
            cta={{ href: "/news", label: "All news" }}
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
            >

                {
                    latestNews.map((newsItem) => (
                        <a
                            href={`/news/${newsItem.id}`}
                            class="group surface-hover flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden h-full"
                        >

                            <div
                                class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800"
                            >

                                {newsItem.data.cover && (
                                    <Image
                                        src={newsItem.data.cover}
                                        alt={newsItem.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                )}

                            </div>


                            <div
                                class="p-5 flex flex-col flex-grow"
                            >

                                <p
                                    class="text-xs text-slate-400 dark:text-slate-500 mb-2"
                                >
                                    {newsItem.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </p>

                                <h3
                                    class="font-medium text-base leading-snug text-slate-900 dark:text-white group-hover:text-primary transition-colors mb-2"
                                >
                                    {newsItem.data.title}
                                </h3>

                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-auto"
                                >
                                    {newsItem.data.short}
                                </p>

                            </div>

                        </a>
                    ))
                }

            </div>

        </Section>


        <!-- ========================================================= -->
        <!-- CTA -->
        <!-- ========================================================= -->

        <section class="pb-24 lg:pb-32">

            <div
                class="relative overflow-hidden rounded-3xl bg-slate-950 text-white p-10 md:p-16 dark:bg-slate-900"
            >

                <!-- subtle blue glow -->

                <div
                    class="cta-glow-blue absolute -top-20 -right-10 w-96 h-96"
                ></div>

                <!-- subtle purple glow -->

                <div
                    class="cta-glow-purple absolute -bottom-20 -left-10 w-96 h-96"
                ></div>


                <div
                    class="relative grid md:grid-cols-3 gap-8 items-end"
                >

                    <div class="md:col-span-2">

                        <p
                            class="eyebrow text-sky-300 opacity-90 mb-4"
                        >
                            Get involved
                        </p>

                        <h2
                            class="font-display text-4xl md:text-5xl leading-tight"
                        >
                            Collaborate, research, or join the team.
                        </h2>

                    </div>


                    <div class="flex md:justify-end">

                        <a
                            href="/people"
                            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-slate-950 text-sm font-medium hover:scale-105 transition"
                        >

                            Meet our people

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M5 12h14M13 5l7 7-7 7"
                                ></path>
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</BaseLayout>


<!-- ============================================================= -->
<!-- HERO ANIMATION -->
<!-- ============================================================= -->

<style>

    /* =========================================================
       HERO — CLEAN LIGHT BACKGROUND
       ========================================================= */

    /* =========================================================
       PREMIUM LIQUID AI LIGHT
       ========================================================= */

    /* =========================================================
       PARTICLE VORTEX — LIGHT MARC THEME
       ========================================================= */

    .particle-vortex-glow {
        position:absolute;
        width:42vw;
        height:34vw;
        min-width:360px;
        min-height:280px;
        left:58%;
        top:52%;
        transform:translate(-50%,-50%);
        border-radius:50%;
        background:radial-gradient(circle,rgba(124,58,237,.12) 0%,rgba(59,130,246,.06) 34%,rgba(34,211,238,.035) 55%,transparent 74%);
        filter:blur(28px);
        pointer-events:none;
    }

    .particle-vortex-core {
        position:absolute;
        width:210px;
        height:150px;
        left:64%;
        top:54%;
        transform:translate(-50%,-50%);
        border-radius:50%;
        background:radial-gradient(ellipse,rgba(255,255,255,.95) 0%,rgba(167,139,250,.48) 12%,rgba(59,130,246,.16) 35%,transparent 72%);
        filter:blur(18px);
        opacity:.75;
        pointer-events:none;
        animation:vortexCore 7s ease-in-out infinite;
    }

    @keyframes vortexCore {
        0%,100% { transform:translate(-50%,-50%) scale(1); opacity:.62; }
        50% { transform:translate(-50%,-50%) scale(1.14); opacity:.9; }
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 1100px) {
        .liquid-ai-visual {
            opacity: 0.92;
        }

        .liquid-ai-label {
            right: 5%;
            bottom: 6%;
        }
    }

    @media (max-width: 900px) {
        .liquid-ai-visual {
            opacity: 0.72;
        }

        .liquid-ai-label {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .liquid-ai-visual {
            opacity: 0.52;
        }
    }


    /* =========================================================
       REDUCE MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .liquid-ai-visual,
        .liquid-glow,
        .liquid-core,
        .liquid-band,
        .liquid-wave,
        .liquid-particle {

            animation: none !important;
        }

    }

</style>


<!-- ============================================================= -->
<!-- PARTICLE / NEURAL NETWORK SCRIPT -->
<!-- ============================================================= -->

<script>
    const canvas =
        document.getElementById("particleCanvas") as HTMLCanvasElement | null;

    if (canvas) {
        const ctx = canvas.getContext("2d");

        if (ctx) {
            type Particle = {
                radius: number;
                angle: number;
                speed: number;
                size: number;
                alpha: number;
                hue: number;
                wobble: number;
                phase: number;
            };

            let particles: Particle[] = [];
            let animationFrame = 0;
            let width = 0;
            let height = 0;
            let dpr = 1;

            const reducedMotion =
                window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            const center = () => ({
                x: width * 0.66,
                y: height * 0.54,
            });

            const createParticles = () => {
                const mobile = width < 768;
                const amount = mobile ? 650 : 1500;
                const maxRadius = Math.min(width, height) * (mobile ? 0.48 : 0.58);

                particles = [];

                for (let i = 0; i < amount; i++) {
                    const radius =
                        22 +
                        Math.pow(Math.random(), 0.58) *
                            (maxRadius - 22);

                    particles.push({
                        radius,
                        angle: Math.random() * Math.PI * 2,
                        speed:
                            0.0018 +
                            (1 - radius / maxRadius) * 0.008 +
                            Math.random() * 0.0025,
                        size:
                            Math.random() < 0.08
                                ? Math.random() * 2.4 + 1.4
                                : Math.random() * 1.25 + 0.35,
                        alpha:
                            Math.random() * 0.55 + 0.22,
                        hue: Math.random(),
                        wobble:
                            Math.random() * 0.7 + 0.25,
                        phase: Math.random() * Math.PI * 2,
                    });
                }
            };

            const resizeCanvas = () => {
                dpr = Math.min(window.devicePixelRatio || 1, 2);
                width = window.innerWidth;
                height = window.innerHeight;

                canvas.width = width * dpr;
                canvas.height = height * dpr;
                canvas.style.width = width + "px";
                canvas.style.height = height + "px";

                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                createParticles();
            };

            const drawParticle = (
                x: number,
                y: number,
                size: number,
                alpha: number,
                hue: number,
            ) => {
                const gradient = ctx.createRadialGradient(
                    x, y, 0,
                    x, y, size * 5,
                );

                const color =
                    hue < 0.42
                        ? "99,102,241"
                        : hue < 0.72
                            ? "124,58,237"
                            : "6,182,212";

                gradient.addColorStop(0, "rgba(255,255,255," + alpha + ")");
                gradient.addColorStop(
                    0.22,
                    "rgba(" + color + "," + alpha * 0.8 + ")",
                );
                gradient.addColorStop(
                    1,
                    "rgba(" + color + ",0)",
                );

                ctx.fillStyle = gradient;
                ctx.beginPath();
                ctx.arc(x, y, size * 5, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle =
                    "rgba(255,255,255," +
                    Math.min(1, alpha + 0.15) +
                    ")";
                ctx.beginPath();
                ctx.arc(x, y, Math.max(0.35, size), 0, Math.PI * 2);
                ctx.fill();
            };

            const draw = (time = 0) => {
                ctx.fillStyle = "rgba(255,255,255,0.13)";
                ctx.fillRect(0, 0, width, height);

                const { x: cx, y: cy } = center();
                const maxRadius = Math.min(width, height) * 0.58;

                particles.forEach((particle) => {
                    const previousRadius = particle.radius;

                    particle.angle += particle.speed;
                    particle.radius -=
                        0.025 +
                        (1 - particle.radius / maxRadius) * 0.055;

                    if (particle.radius < 18) {
                        particle.radius =
                            maxRadius * (0.72 + Math.random() * 0.30);
                        particle.angle =
                            Math.random() * Math.PI * 2;
                    }

                    const normalized =
                        particle.radius / maxRadius;

                    const spiral =
                        Math.sin(
                            particle.angle * 2.2 +
                                particle.phase +
                                time * 0.00018,
                        ) *
                        particle.wobble *
                        (12 + normalized * 42);

                    const x =
                        cx +
                        Math.cos(particle.angle) *
                            particle.radius +
                        spiral;

                    const y =
                        cy +
                        Math.sin(particle.angle) *
                            particle.radius *
                            0.54 +
                        Math.sin(
                            particle.angle * 3 +
                                particle.phase,
                        ) *
                            10 *
                            normalized;

                    if (
                        previousRadius > 70 &&
                        particle.size > 0.8 &&
                        Math.random() < 0.34
                    ) {
                        const tailAngle =
                            particle.angle - 0.07;
                        const tx =
                            cx +
                            Math.cos(tailAngle) *
                                (particle.radius + 7) +
                            spiral;
                        const ty =
                            cy +
                            Math.sin(tailAngle) *
                                (particle.radius + 7) *
                                0.54;

                        ctx.beginPath();
                        ctx.moveTo(tx, ty);
                        ctx.lineTo(x, y);
                        ctx.strokeStyle =
                            "rgba(99,102,241," +
                            particle.alpha * 0.10 +
                            ")";
                        ctx.lineWidth =
                            Math.max(0.35, particle.size * 0.45);
                        ctx.stroke();
                    }

                    const coreBoost =
                        normalized < 0.20
                            ? 0.42
                            : normalized < 0.42
                                ? 0.18
                                : 0;

                    drawParticle(
                        x,
                        y,
                        particle.size * (1 + coreBoost),
                        Math.min(0.95, particle.alpha + coreBoost),
                        particle.hue,
                    );
                });

                for (let i = 0; i < 90; i++) {
                    const angle =
                        time * 0.00022 +
                        i * 0.19;
                    const radius =
                        10 + (i % 18) * 2.2;

                    drawParticle(
                        cx + Math.cos(angle) * radius,
                        cy + Math.sin(angle) * radius * 0.46,
                        0.45 + (i % 3) * 0.18,
                        0.42,
                        i % 2 === 0 ? 0.25 : 0.55,
                    );
                }

                if (!reducedMotion) {
                    animationFrame = requestAnimationFrame(draw);
                }
            };

            resizeCanvas();
            ctx.fillStyle = "rgba(255,255,255,1)";
            ctx.fillRect(0, 0, width, height);
            draw(performance.now());

            window.addEventListener("resize", resizeCanvas);

            document.addEventListener(
                "astro:before-swap",
                () => {
                    cancelAnimationFrame(animationFrame);
                    window.removeEventListener("resize", resizeCanvas);
                },
                { once: true },
            );
        }
    }
</script>