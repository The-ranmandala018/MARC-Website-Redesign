---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import { formatDate } from "../../utils/text";

export async function getStaticPaths() {
    const news = await getCollection("news");
    return news.map((item) => ({
        params: { slug: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);

// Skip the summary lead when the article body already starts with it
const normalise = (s: string) => s.replace(/\s+/g, " ").trim();
const showLead = !normalise(item.body ?? "").startsWith(
    normalise(item.data.short).slice(0, 80),
);

const moreNews = (await getCollection("news"))
    .filter((n) => n.id !== item.id)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);
---

<BaseLayout title={item.data.title} description={normalise(item.data.short).slice(0, 155)}>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li><a href="/news">News</a></li>
        <li class="truncate max-w-[220px]">{item.data.title}</li>
    </Breadcrumb>

    <article>
        <!-- Header -->
        <header class="mx-auto max-w-4xl text-center">
            <p class="eyebrow !opacity-100 !text-[#004AAD] dark:!text-[#5170FF]">
                {formatDate(item.data.date, { weekday: "long", day: "numeric", month: "long", year: "numeric" })}
            </p>
            <h1 class="mt-5 font-display text-4xl sm:text-5xl lg:text-6xl text-base-content">
                {item.data.title}
            </h1>
        </header>

        <!-- Cover -->
        {
            item.data.cover && (
                <div class="glass-card mx-auto mt-10 max-w-5xl p-2.5 sm:p-3 !rounded-[2rem]">
                    <Image
                        src={item.data.cover}
                        alt={item.data.title}
                        width={1400}
                        class="aspect-[16/9] w-full rounded-[1.5rem] object-cover"
                        priority
                    />
                </div>
            )
        }

        <!-- Body -->
        <div class="glass-card mx-auto mt-8 max-w-3xl p-6 sm:p-10 lg:p-12">
            {
                showLead && (
                    <p class="mb-8 border-l-4 border-[#5170FF] pl-5 text-lg leading-relaxed text-base-content/80 sm:text-xl">
                        {item.data.short}
                    </p>
                )
            }
            <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-display prose-a:text-[#004AAD] prose-img:rounded-2xl">
                <Content />
            </div>
        </div>

        <div class="mx-auto mt-8 flex max-w-3xl justify-center">
            <ArrowPill label="All news" href="/news" />
        </div>
    </article>

    <!-- More news -->
    {
        moreNews.length > 0 && (
            <section class="mt-20">
                <h2 class="mb-6 font-display text-3xl sm:text-4xl text-base-content">More news</h2>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {moreNews.map((n) => (
                        <a href={`/news/${n.id}`} class="group glass-card glass-hover flex items-center gap-4 p-3">
                            <div class="h-20 w-24 shrink-0 overflow-hidden rounded-2xl bg-base-content/5">
                                {n.data.cover && (
                                    <Image
                                        src={n.data.cover}
                                        alt={n.data.title}
                                        width={200}
                                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    />
                                )}
                            </div>
                            <div class="min-w-0 pr-2">
                                <p class="text-xs text-base-content/55 tabular-nums">{formatDate(n.data.date)}</p>
                                <p class="mt-1 font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                    {n.data.title}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>
