---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import { formatDate } from "../../utils/text";

// Stories (markdown articles), newest first
const stories = (await getCollection("news")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [featured, ...moreStories] = stories;

// Social posts (external links), newest first
const social = (await getCollection("social_news")).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const sourceColor: Record<string, string> = {
    LinkedIn: "text-[#0077b5]",
    Facebook: "text-[#1877F2]",
    Twitter: "text-base-content",
    Web: "text-[#004AAD] dark:text-[#5170FF]",
};
---

<BaseLayout
    title="News"
    description="Discover MARC's latest research milestones, awards, and community activities."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>News</li>
    </Breadcrumb>

    <PageHeader
        eyebrow="News"
        lead="Discover our latest research milestones, awards, and community activities."
    >
        <Fragment slot="title">
            Latest
            <br />
            <span class="text-gradient">from MARC.</span>
        </Fragment>
    </PageHeader>

    <!-- ===================================================== -->
    <!-- FEATURED STORY -->
    <!-- ===================================================== -->

    {
        featured && (
            <a
                href={`/news/${featured.id}`}
                class="group glass-card glass-hover mt-14 grid gap-6 p-3 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:gap-10"
            >
                <div class="relative aspect-[16/10] overflow-hidden rounded-[1.4rem] bg-base-content/5">
                    {featured.data.cover && (
                        <Image
                            src={featured.data.cover}
                            alt={featured.data.title}
                            width={1000}
                            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                        />
                    )}
                    <span class="absolute left-4 top-4 rounded-full border border-white/40 bg-[#141a2e]/40 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">
                        Latest story
                    </span>
                </div>

                <div class="px-3 pb-4 lg:py-6 lg:pr-8">
                    <p class="text-sm text-base-content/55 tabular-nums">{formatDate(featured.data.date)}</p>
                    <h2 class="mt-3 font-display text-3xl sm:text-4xl lg:text-5xl text-base-content transition-colors group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                        {featured.data.title}
                    </h2>
                    <p class="mt-5 line-clamp-4 text-base leading-relaxed text-base-content/70">
                        {featured.data.short}
                    </p>
                    <ArrowPill label="Read story" class="mt-7" />
                </div>
            </a>
        )
    }

    <!-- ===================================================== -->
    <!-- MORE STORIES -->
    <!-- ===================================================== -->

    {
        moreStories.length > 0 && (
            <section class="mt-16">
                <h2 class="mb-6 font-display text-3xl sm:text-4xl text-base-content">More stories</h2>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {moreStories.map((item) => (
                        <a href={`/news/${item.id}`} class="group glass-card glass-hover flex flex-col p-3">
                            <div class="aspect-[16/10] overflow-hidden rounded-[1.25rem] bg-base-content/5">
                                {item.data.cover && (
                                    <Image
                                        src={item.data.cover}
                                        alt={item.data.title}
                                        width={600}
                                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                                    />
                                )}
                            </div>
                            <div class="flex flex-grow flex-col px-2 pb-2 pt-4">
                                <p class="text-xs text-base-content/55 tabular-nums">{formatDate(item.data.date)}</p>
                                <h3 class="mt-1.5 text-xl font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                    {item.data.title}
                                </h3>
                                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-base-content/65">
                                    {item.data.short}
                                </p>
                                <ArrowPill label="Read" class="mt-5 self-start !px-4 !py-2" />
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }

    <!-- ===================================================== -->
    <!-- SOCIAL FEED -->
    <!-- ===================================================== -->

    {
        social.length > 0 && (
            <section class="mt-20">
                <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <p class="eyebrow">Social feed</p>
                        <h2 class="mt-2 font-display text-3xl sm:text-4xl text-base-content">Latest activity</h2>
                    </div>
                    <p class="text-sm text-base-content/60">Updates directly from our social media channels.</p>
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                    {social.map((item) => {
                        const d = new Date(item.data.date);
                        return (
                            <a
                                href={item.data.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group glass-card glass-hover flex items-start gap-4 !rounded-3xl p-4"
                            >
                                <div class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-white/60 text-center ring-1 ring-white/80 dark:bg-white/5 dark:ring-white/10">
                                    <div>
                                        <p class="font-display text-2xl leading-none text-[#004AAD] dark:text-[#5170FF] tabular-nums">
                                            {d.getUTCDate()}
                                        </p>
                                        <p class="mt-1 text-[0.65rem] font-semibold uppercase tracking-wider text-base-content/50">
                                            {d.toLocaleString("en-GB", { month: "short", timeZone: "UTC" })} {d.getUTCFullYear()}
                                        </p>
                                    </div>
                                </div>
                                <div class="min-w-0">
                                    <p class={`text-xs font-semibold uppercase tracking-wider ${sourceColor[item.data.source] ?? "text-base-content"}`}>
                                        {item.data.source}
                                    </p>
                                    <h3 class="mt-1 font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                        {item.data.title.trim()}
                                    </h3>
                                    <p class="mt-2 inline-flex items-center gap-1 text-xs text-base-content/50">
                                        View original post
                                        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span>
                                    </p>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </section>
        )
    }
</BaseLayout>
