---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/app.css";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { Image } from "astro:assets";
import PageHeader from "../../components/PageHeader.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import { getCollection } from "astro:content";

const researchAreas = Object.values(
    import.meta.glob("./*.md", { eager: true }),
) as any[];

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const imagekey_to_src = (imageKey: string) =>
    images[`/src/assets/${imageKey}`]?.default;

// Stable anchor id for each area, used by the jump links.
const slugify = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

// Projects live inside their research area on this page.
const projects = await getCollection("projects");
const norm = (s: string) => s.trim().toLowerCase();
const projectsIn = (title: string) =>
    projects.filter((p) => norm(p.data.researchArea) === norm(title));

const areas = researchAreas.map((Area, i) => ({
    index: String(i + 1).padStart(2, "0"),
    title: Area.frontmatter.title as string,
    short: Area.frontmatter.short as string,
    image: imagekey_to_src(Area.frontmatter.coverImage),
    url: Area.url as string,
    id: slugify(Area.frontmatter.title),
    projects: projectsIn(Area.frontmatter.title),
}));

// Any project whose area doesn't match an area page still gets listed
const areaTitles = new Set(areas.map((a) => norm(a.title)));
const otherProjects = projects.filter((p) => !areaTitles.has(norm(p.data.researchArea)));
---

<BaseLayout
    title="Research"
    description="MARC's research areas and projects — foundational AI and applied research across critical domains where intelligence meets impact."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>Research</li>
    </Breadcrumb>

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <PageHeader
        eyebrow="Research"
        lead="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
    >
        <Fragment slot="title">
            Ten areas,
            <br />
            <span class="text-gradient">one shared mission.</span>
        </Fragment>
    </PageHeader>

    <!-- Research area gallery -->
    <section class="research-gallery mt-12 lg:mt-16" aria-labelledby="research-gallery-title">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="eyebrow">Discover what we do</p>
                <h2 id="research-gallery-title" class="mt-2 font-display text-2xl sm:text-3xl text-base-content">
                    Explore our research
                </h2>
            </div>
            <p class="text-sm text-base-content/60">10 research areas · {projects.length} projects</p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {areas.map((a) => (
                <article id={a.id} class="research-area-card group scroll-mt-28">
                    <a href={a.url} class="research-card-link">
                        <div class="area-media">
                            {a.image && (
                                <Image
                                    src={a.image}
                                    alt={a.title}
                                    width={900}
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.045]"
                                />
                            )}
                            <span class="area-index-badge">{a.index}</span>
                            <span class="area-project-count">
                                {a.projects.length} {a.projects.length === 1 ? "project" : "projects"}
                            </span>
                        </div>
                        <div class="research-card-content">
                            <h3 class="font-display text-xl sm:text-2xl leading-snug text-base-content transition-colors group-hover:text-[#004AAD] dark:group-hover:text-[#9BACF4]">
                                {a.title}
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-base-content/70 line-clamp-3">
                                {a.short}
                            </p>
                            <span class="research-card-cta">
                                Explore area <span aria-hidden="true">↗</span>
                            </span>
                        </div>
                    </a>
                </article>
            ))}
        </div>
    </section>

    {
        otherProjects.length > 0 && (
            <section class="mt-16">
                <h2 class="mb-6 font-display text-3xl sm:text-4xl text-base-content">Other projects</h2>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {otherProjects.map((p) => (
                        <a href={`/projects/${p.id}`} class="group glass-card glass-hover flex items-center gap-4 p-3">
                            <div class="h-16 w-20 shrink-0 overflow-hidden rounded-xl bg-base-content/5">
                                {p.data.coverImage && (
                                    <Image src={p.data.coverImage} alt="" width={160} class="h-full w-full object-cover" />
                                )}
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-xs text-base-content/55">{p.data.researchArea}</p>
                                <p class="mt-1 font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                    {p.data.project}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>

<style>
    .research-gallery {
        position: relative;
    }

    .research-area-card {
        --card-tint: rgba(111, 173, 255, 0.16);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.86);
        border-radius: 1.6rem;
        background:
            radial-gradient(ellipse at 88% 0%, var(--card-tint), transparent 54%),
            linear-gradient(145deg, rgba(255, 255, 255, 0.76), rgba(248, 249, 255, 0.48));
        box-shadow:
            0 16px 42px -30px rgba(37, 57, 110, 0.30),
            inset 0 1px 0 rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(22px) saturate(140%);
        -webkit-backdrop-filter: blur(22px) saturate(140%);
        transition: transform 280ms ease, box-shadow 280ms ease, border-color 280ms ease;
    }

    .research-area-card:nth-child(5n + 1) { --card-tint: rgba(77, 215, 210, 0.22); }
    .research-area-card:nth-child(5n + 2) { --card-tint: rgba(91, 139, 255, 0.23); }
    .research-area-card:nth-child(5n + 3) { --card-tint: rgba(171, 126, 255, 0.23); }
    .research-area-card:nth-child(5n + 4) { --card-tint: rgba(92, 195, 255, 0.22); }
    .research-area-card:nth-child(5n + 5) { --card-tint: rgba(244, 153, 199, 0.23); }

    .research-area-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.98);
        box-shadow:
            0 24px 52px -30px rgba(34, 70, 155, 0.34),
            inset 0 1px 0 rgba(255, 255, 255, 0.98);
    }

    .research-card-link {
        display: flex;
        height: 100%;
        flex-direction: column;
        color: inherit;
        text-decoration: none;
    }

    .area-media {
        position: relative;
        aspect-ratio: 16 / 9;
        margin: 0.55rem 0.55rem 0;
        overflow: hidden;
        border-radius: 1.2rem;
        background: color-mix(in srgb, var(--color-base-content) 6%, transparent);
    }

    .area-media img {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .area-index-badge {
        position: absolute;
        top: 0.8rem;
        left: 0.8rem;
        display: grid;
        min-width: 2.35rem;
        height: 2.35rem;
        place-items: center;
        padding: 0 0.65rem;
        border-radius: 999px;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        background: rgba(15, 23, 42, 0.42);
        border: 1px solid rgba(255, 255, 255, 0.48);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .area-project-count {
        position: absolute;
        right: 0.8rem;
        bottom: 0.8rem;
        padding: 0.42rem 0.7rem;
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 999px;
        color: #17233d;
        background: rgba(255, 255, 255, 0.76);
        font-size: 0.72rem;
        font-weight: 600;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .research-card-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
        padding: 1.15rem 1.25rem 1.3rem;
    }

    .research-card-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.1rem;
        color: #1458d4;
        font-size: 0.88rem;
        font-weight: 650;
    }

    .research-card-cta span {
        transition: transform 220ms ease;
    }

    .research-area-card:hover .research-card-cta span {
        transform: translate(2px, -2px);
    }

    :global(html[data-theme="marc-dark"]) .research-area-card {
        background:
            radial-gradient(ellipse at 88% 0%, var(--card-tint), transparent 54%),
            linear-gradient(145deg, rgba(30, 41, 65, 0.82), rgba(15, 23, 42, 0.72));
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow:
            0 16px 42px -30px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    :global(html[data-theme="marc-dark"]) .research-area-card:hover {
        border-color: rgba(155, 172, 244, 0.34);
        box-shadow: 0 24px 52px -30px rgba(81, 112, 255, 0.24);
    }

    :global(html[data-theme="marc-dark"]) .area-project-count {
        color: #f8fafc;
        background: rgba(15, 23, 42, 0.66);
        border-color: rgba(255, 255, 255, 0.2);
    }

    :global(html[data-theme="marc-dark"]) .research-card-cta {
        color: #9BACF4;
    }

    @media (prefers-reduced-motion: reduce) {
        .research-area-card,
        .research-card-cta span {
            transition: none;
        }
        .research-area-card:hover {
            transform: none;
        }
    }
</style>
