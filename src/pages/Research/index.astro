---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/app.css";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { Image } from "astro:assets";
import PageHeader from "../../components/PageHeader.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import { getCollection } from "astro:content";

const researchAreas = Object.values(
    import.meta.glob("./*.md", { eager: true }),
) as any[];

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const imagekey_to_src = (imageKey: string) =>
    images[`/src/assets/${imageKey}`]?.default;

// Stable anchor id for each area, used by the jump links.
const slugify = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

// Projects live inside their research area on this page.
const projects = await getCollection("projects");
const norm = (s: string) => s.trim().toLowerCase();
const projectsIn = (title: string) =>
    projects.filter((p) => norm(p.data.researchArea) === norm(title));

const areas = researchAreas.map((Area, i) => ({
    index: String(i + 1).padStart(2, "0"),
    title: Area.frontmatter.title as string,
    short: Area.frontmatter.short as string,
    image: imagekey_to_src(Area.frontmatter.coverImage),
    url: Area.url as string,
    id: slugify(Area.frontmatter.title),
    projects: projectsIn(Area.frontmatter.title),
}));

// Any project whose area doesn't match an area page still gets listed
const areaTitles = new Set(areas.map((a) => norm(a.title)));
const otherProjects = projects.filter((p) => !areaTitles.has(norm(p.data.researchArea)));
---

<BaseLayout
    title="Research"
    description="MARC's research areas and projects — foundational AI and applied research across critical domains where intelligence meets impact."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>Research</li>
    </Breadcrumb>

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <PageHeader
        eyebrow="Research"
        lead="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
    >
        <Fragment slot="title">
            Six areas,
            <br />
            <span class="text-gradient">one shared mission.</span>
        </Fragment>

        <!-- Jump links -->
        <nav slot="after" class="mt-10 flex flex-wrap gap-2" aria-label="Research areas">
            {
                areas.map((a) => (
                    <a href={`#${a.id}`} class="glass-chip">
                        <span class="text-[#5170FF] font-semibold tabular-nums">{a.index}</span>
                        {a.title}
                        {a.projects.length > 0 && (
                            <span class="rounded-full bg-[#5170FF]/12 px-2 py-0.5 text-xs font-semibold text-[#3f55c9] dark:text-[#9fb0ff] tabular-nums">
                                {a.projects.length}
                            </span>
                        )}
                    </a>
                ))
            }
        </nav>
    </PageHeader>

    <!-- ===================================================== -->
    <!-- AREAS — alternating editorial rows -->
    <!-- ===================================================== -->

    <div class="mt-16 lg:mt-24 flex flex-col gap-8 lg:gap-12">
        {
            areas.map((a, i) => (
                <article
                    id={a.id}
                    class="group glass-card glass-hover !rounded-[2rem] p-4 lg:p-5 scroll-mt-28"
                >
                    <div class={`grid items-center gap-6 lg:gap-12 lg:grid-cols-2 ${i % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}`}>
                        <!-- Image -->
                        <a href={a.url} class="area-media block" tabindex="-1" aria-hidden="true">
                            {a.image && (
                                <Image
                                    src={a.image}
                                    alt=""
                                    width={900}
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                                />
                            )}
                            <span class="area-index-badge">{a.index}</span>
                        </a>

                        <!-- Text -->
                        <div class="px-1 lg:px-4 py-2">
                            <p class="eyebrow">
                                Research area {a.index}
                            </p>

                            <h2 class="mt-3 font-display text-3xl sm:text-4xl text-base-content">
                                <a href={a.url} class="transition-colors hover:text-[#004AAD] dark:hover:text-[#5170FF]">
                                    {a.title}
                                </a>
                            </h2>

                            <p class="mt-5 text-base leading-relaxed text-base-content/70 line-clamp-5">
                                {a.short}
                            </p>

                            <ArrowPill label="Explore area" href={a.url} class="mt-7" />
                        </div>
                    </div>

                    <!-- Projects in this area -->
                    {a.projects.length > 0 && (
                        <div class="mt-5 border-t border-white/70 px-1 pt-5 lg:mt-6 lg:px-2 dark:border-white/10">
                            <p class="eyebrow flex items-center gap-2">
                                Projects in this area
                                <span class="tabular-nums">· {a.projects.length}</span>
                            </p>
                            <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                                {a.projects.map((p) => (
                                    <a
                                        href={`/projects/${p.id}`}
                                        class="group/project flex items-center gap-3 rounded-2xl bg-white/50 p-2 pr-3 ring-1 ring-white/80 transition-all hover:-translate-y-0.5 hover:bg-white/80 hover:shadow-[0_14px_30px_-18px_rgba(70,90,180,0.6)] dark:bg-white/5 dark:ring-white/10 dark:hover:bg-white/10"
                                    >
                                        <div class="h-14 w-16 shrink-0 overflow-hidden rounded-xl bg-base-content/5">
                                            {p.data.coverImage && (
                                                <Image
                                                    src={p.data.coverImage}
                                                    alt=""
                                                    width={160}
                                                    class="h-full w-full object-cover transition-transform duration-500 group-hover/project:scale-105"
                                                />
                                            )}
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <p class="truncate font-semibold text-base-content group-hover/project:text-[#004AAD] dark:group-hover/project:text-[#5170FF]">
                                                {p.data.project}
                                            </p>
                                            <p class="truncate text-xs text-base-content/55">
                                                {p.data.researchPillars?.join(" · ")}
                                            </p>
                                        </div>
                                        <span aria-hidden="true" class="text-[#5170FF] transition-transform group-hover/project:translate-x-0.5">→</span>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}
                </article>
            ))
        }
    </div>

    {
        otherProjects.length > 0 && (
            <section class="mt-16">
                <h2 class="mb-6 font-display text-3xl sm:text-4xl text-base-content">Other projects</h2>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {otherProjects.map((p) => (
                        <a href={`/projects/${p.id}`} class="group glass-card glass-hover flex items-center gap-4 p-3">
                            <div class="h-16 w-20 shrink-0 overflow-hidden rounded-xl bg-base-content/5">
                                {p.data.coverImage && (
                                    <Image src={p.data.coverImage} alt="" width={160} class="h-full w-full object-cover" />
                                )}
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-xs text-base-content/55">{p.data.researchArea}</p>
                                <p class="mt-1 font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                    {p.data.project}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>

<style>
    .area-media {
        position: relative;
        aspect-ratio: 16 / 11;
        overflow: hidden;
        border-radius: 1.5rem;
        background: color-mix(in srgb, var(--color-base-content) 6%, transparent);
    }

    .area-index-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #fff;
        background: rgba(20, 26, 46, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
</style>
