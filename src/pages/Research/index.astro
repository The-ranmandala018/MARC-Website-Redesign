---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/app.css";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { Image } from "astro:assets";
import PageHeader from "../../components/PageHeader.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import { getCollection } from "astro:content";

const researchAreas = Object.values(
    import.meta.glob("./*.md", { eager: true }),
) as any[];

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const imagekey_to_src = (imageKey: string) =>
    images[`/src/assets/${imageKey}`]?.default;

// Stable anchor id for each area, used by the jump links.
const slugify = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

// Projects live inside their research area on this page.
const projects = await getCollection("projects");
const norm = (s: string) => s.trim().toLowerCase();
const projectsIn = (title: string) =>
    projects.filter((p) => norm(p.data.researchArea) === norm(title));

const areas = researchAreas.map((Area, i) => ({
    index: String(i + 1).padStart(2, "0"),
    title: Area.frontmatter.title as string,
    short: Area.frontmatter.short as string,
    image: imagekey_to_src(Area.frontmatter.coverImage),
    url: Area.url as string,
    id: slugify(Area.frontmatter.title),
    projects: projectsIn(Area.frontmatter.title),
}));

// Any project whose area doesn't match an area page still gets listed
const areaTitles = new Set(areas.map((a) => norm(a.title)));
const otherProjects = projects.filter((p) => !areaTitles.has(norm(p.data.researchArea)));
---

<BaseLayout
    title="Research"
    description="MARC's research areas and projects — foundational AI and applied research across critical domains where intelligence meets impact."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>Research</li>
    </Breadcrumb>

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <PageHeader
        eyebrow="Research"
        lead="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
    >
        <Fragment slot="title">
            Ten areas,
            <br />
            <span class="text-gradient">one shared mission.</span>
        </Fragment>
    </PageHeader>

    <!-- Research areas — immersive image cards -->
    <section class="research-gallery mt-12 lg:mt-16" aria-labelledby="research-gallery-title">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="eyebrow">Discover what we do</p>
                <h2 id="research-gallery-title" class="mt-2 font-display text-2xl sm:text-3xl text-base-content">
                    Explore our research
                </h2>
            </div>
            <div class="research-carousel-controls" aria-label="Research card controls">
                <button type="button" class="research-carousel-button" data-scroll="previous" aria-label="Scroll to previous research areas">←</button>
                <button type="button" class="research-carousel-button" data-scroll="next" aria-label="Scroll to next research areas">→</button>
            </div>
        </div>

        <div class="research-card-track" id="research-card-track">
            {areas.map((a) => (
                <article id={a.id} class="research-area-card group scroll-mt-28">
                    <a href={a.url} class="research-card-link" aria-label={`Explore ${a.title}`}>
                        {a.image && (
                            <Image
                                src={a.image}
                                alt=""
                                width={900}
                                class="research-card-image transition-transform duration-700 group-hover:scale-[1.045]"
                            />
                        )}
                        <div class="research-card-shade"></div>
                        <span class="area-index-badge">{a.index}</span>
                        <div class="research-card-content">
                            <div class="research-card-meta">
                                {a.projects.length} {a.projects.length === 1 ? "project" : "projects"}
                            </div>
                            <h3 class="font-display text-2xl sm:text-[1.7rem] leading-tight text-white">
                                {a.title}
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-white/80 line-clamp-3">
                                {a.short}
                            </p>
                            <span class="research-card-cta">
                                Explore area <span aria-hidden="true">↗</span>
                            </span>
                        </div>
                    </a>
                </article>
            ))}
        </div>
    </section>

    <script>
        const track = document.querySelector<HTMLElement>("#research-card-track");
        document.querySelectorAll<HTMLButtonElement>(".research-carousel-button").forEach((button) => {
            button.addEventListener("click", () => {
                if (!track) return;
                const direction = button.dataset.scroll === "next" ? 1 : -1;
                const card = track.querySelector<HTMLElement>(".research-area-card");
                const distance = card ? card.offsetWidth + 24 : 380;
                track.scrollBy({ left: direction * distance * 2, behavior: "smooth" });
            });
        });
    </script>

    {
        otherProjects.length > 0 && (
            <section class="mt-16">
                <h2 class="mb-6 font-display text-3xl sm:text-4xl text-base-content">Other projects</h2>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {otherProjects.map((p) => (
                        <a href={`/projects/${p.id}`} class="group glass-card glass-hover flex items-center gap-4 p-3">
                            <div class="h-16 w-20 shrink-0 overflow-hidden rounded-xl bg-base-content/5">
                                {p.data.coverImage && (
                                    <Image src={p.data.coverImage} alt="" width={160} class="h-full w-full object-cover" />
                                )}
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-xs text-base-content/55">{p.data.researchArea}</p>
                                <p class="mt-1 font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                    {p.data.project}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>

<style>
    .research-gallery {
        position: relative;
    }

    .research-carousel-controls {
        display: flex;
        gap: 0.5rem;
    }

    .research-carousel-button {
        display: grid;
        width: 2.65rem;
        height: 2.65rem;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.58);
        color: var(--color-base-content);
        font-size: 1.25rem;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: background 200ms ease, transform 200ms ease;
    }

    .research-carousel-button:hover {
        background: rgba(255, 255, 255, 0.9);
        transform: translateY(-1px);
    }

    .research-card-track {
        display: grid;
        grid-auto-columns: minmax(285px, 31%);
        grid-auto-flow: column;
        gap: 1.25rem;
        overflow-x: auto;
        padding: 0.15rem 0.1rem 1.2rem;
        scroll-snap-type: x mandatory;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
    }

    .research-card-track::-webkit-scrollbar {
        display: none;
    }

    .research-area-card {
        position: relative;
        height: clamp(390px, 38vw, 520px);
        overflow: hidden;
        isolation: isolate;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 1.5rem;
        background: #101827;
        box-shadow: 0 18px 48px -28px rgba(15, 23, 42, 0.42);
        scroll-snap-align: start;
        transition: transform 280ms ease, box-shadow 280ms ease, border-color 280ms ease;
    }

    .research-area-card:hover {
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.5);
        box-shadow: 0 25px 55px -30px rgba(15, 23, 42, 0.55);
    }

    .research-card-link {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .research-card-image {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .research-card-shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(180deg, rgba(8, 14, 28, 0.18) 0%, rgba(8, 14, 28, 0.04) 28%, rgba(8, 14, 28, 0.48) 54%, rgba(8, 14, 28, 0.94) 100%),
            linear-gradient(135deg, rgba(0, 74, 173, 0.12), transparent 60%);
        transition: background 250ms ease;
    }

    .research-area-card:hover .research-card-shade {
        background:
            linear-gradient(180deg, rgba(8, 14, 28, 0.12) 0%, rgba(8, 14, 28, 0.02) 25%, rgba(8, 14, 28, 0.48) 52%, rgba(8, 14, 28, 0.94) 100%),
            linear-gradient(135deg, rgba(0, 74, 173, 0.2), transparent 65%);
    }

    .area-index-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: grid;
        min-width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        padding: 0 0.7rem;
        border-radius: 999px;
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
        background: rgba(12, 20, 38, 0.34);
        border: 1px solid rgba(255, 255, 255, 0.42);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    .research-card-content {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 1.35rem;
        color: #fff;
    }

    .research-card-meta {
        margin-bottom: 0.75rem;
        padding: 0.35rem 0.65rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        color: rgba(255, 255, 255, 0.92);
        font-size: 0.72rem;
        font-weight: 600;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .research-card-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.2rem;
        padding: 0.55rem 0.95rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.96);
        color: #111827;
        font-size: 0.82rem;
        font-weight: 650;
        transition: background 200ms ease, transform 200ms ease;
    }

    .research-card-cta span {
        transition: transform 200ms ease;
    }

    .research-area-card:hover .research-card-cta {
        background: #fff;
        transform: translateY(-1px);
    }

    .research-area-card:hover .research-card-cta span {
        transform: translate(2px, -2px);
    }

    :global(html[data-theme="marc-dark"]) .research-carousel-button {
        background: rgba(20, 29, 49, 0.72);
        color: #f8fafc;
        border-color: rgba(255, 255, 255, 0.16);
    }

    @media (min-width: 1600px) {
        .research-card-track { grid-auto-columns: minmax(310px, 27%); }
    }

    @media (max-width: 1023px) {
        .research-card-track { grid-auto-columns: minmax(280px, 44%); }
        .research-area-card { height: 430px; }
    }

    @media (max-width: 639px) {
        .research-card-track { grid-auto-columns: 82%; gap: 0.9rem; }
        .research-area-card { height: 410px; border-radius: 1.3rem; }
        .research-card-content { padding: 1.1rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .research-area-card,
        .research-carousel-button,
        .research-card-cta,
        .research-card-cta span { transition: none; }
        .research-area-card:hover,
        .research-carousel-button:hover { transform: none; }
    }
</style>
