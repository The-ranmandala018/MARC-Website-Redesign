---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/app.css";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { Image } from "astro:assets";
import PageHeader from "../../components/PageHeader.astro";
import ArrowPill from "../../components/ArrowPill.astro";

const researchAreas = Object.values(
    import.meta.glob("./*.md", { eager: true }),
) as any[];

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);

const imagekey_to_src = (imageKey: string) =>
    images[`/src/assets/${imageKey}`]?.default;

// Stable anchor id for each area, used by the jump links.
const slugify = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const areas = researchAreas.map((Area, i) => ({
    index: String(i + 1).padStart(2, "0"),
    title: Area.frontmatter.title as string,
    short: Area.frontmatter.short as string,
    image: imagekey_to_src(Area.frontmatter.coverImage),
    url: Area.url as string,
    id: slugify(Area.frontmatter.title),
}));
---

<BaseLayout
    title="Research Areas"
    description="MARC's research areas — foundational AI and applied research across critical domains where intelligence meets impact."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>Research Areas</li>
    </Breadcrumb>

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <PageHeader
        eyebrow="Research"
        lead="Our work spans foundational AI and applied research across critical domains where intelligence meets impact."
    >
        <Fragment slot="title">
            Six areas,
            <br />
            <span class="text-gradient">one shared mission.</span>
        </Fragment>

        <!-- Jump links -->
        <nav slot="after" class="mt-10 flex flex-wrap gap-2" aria-label="Research areas">
            {
                areas.map((a) => (
                    <a href={`#${a.id}`} class="glass-chip">
                        <span class="text-[#5170FF] font-semibold tabular-nums">{a.index}</span>
                        {a.title}
                    </a>
                ))
            }
        </nav>
    </PageHeader>

    <!-- ===================================================== -->
    <!-- AREAS — alternating editorial rows -->
    <!-- ===================================================== -->

    <div class="mt-16 lg:mt-24 flex flex-col gap-8 lg:gap-12">
        {
            areas.map((a, i) => (
                <article id={a.id} class="group scroll-mt-28">
                    <a
                        href={a.url}
                        class={`glass-card glass-hover !rounded-[2rem] p-4 lg:p-5 grid items-center gap-6 lg:gap-12 lg:grid-cols-2 ${i % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}`}
                    >
                        <!-- Image -->
                        <div class="area-media">
                            {a.image && (
                                <Image
                                    src={a.image}
                                    alt={a.title}
                                    width={900}
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                                />
                            )}
                            <span class="area-index-badge">{a.index}</span>
                        </div>

                        <!-- Text -->
                        <div class="px-1 lg:px-4 py-2">
                            <p class="eyebrow">
                                Research area {a.index}
                            </p>

                            <h2 class="mt-3 font-display text-3xl sm:text-4xl text-base-content transition-colors group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                {a.title}
                            </h2>

                            <p class="mt-5 text-base leading-relaxed text-base-content/70 line-clamp-5">
                                {a.short}
                            </p>

                            <ArrowPill label="Explore area" class="mt-7" />
                        </div>
                    </a>
                </article>
            ))
        }
    </div>
</BaseLayout>

<style>
    .area-media {
        position: relative;
        aspect-ratio: 16 / 11;
        overflow: hidden;
        border-radius: 1.5rem;
        background: color-mix(in srgb, var(--color-base-content) 6%, transparent);
    }

    .area-index-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #fff;
        background: rgba(20, 26, 46, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
</style>
