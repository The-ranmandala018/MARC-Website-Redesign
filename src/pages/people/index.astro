---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHeader from "../../components/PageHeader.astro";
import default_avatar from "../../assets/avatar_default.svg";

const people = await getCollection("people");

// 1. Order the roles appear in (people with other roles are not listed)
const roleOrder = [
    "Director",
    "Deputy Director",
    "Research Assistant",
    "Volunteer",
];

// Leadership roles get larger cards
const leadership = new Set(["Director", "Deputy Director"]);

// 2. Group the people by their 'post'
const groupedPeople = people.reduce<Record<string, (typeof people)[number][]>>(
    (acc, person) => {
        const role = person.data.post ?? "Unspecified";
        if (!roleOrder.includes(role)) return acc;
        if (!acc[role]) acc[role] = [];
        acc[role].push(person);
        return acc;
    },
    {},
);

// 3. Sort roles by the custom order, others alphabetically
const sortedRoles = Object.keys(groupedPeople).sort((a, b) => {
    const indexA = roleOrder.indexOf(a);
    const indexB = roleOrder.indexOf(b);
    if (indexA !== -1 && indexB !== -1) return indexA - indexB;
    if (indexA !== -1) return -1;
    if (indexB !== -1) return 1;
    return a.localeCompare(b);
});

// Names within each role, alphabetical
for (const role of sortedRoles) {
    groupedPeople[role].sort((a, b) => a.data.name.localeCompare(b.data.name));
}

const roleId = (role: string) => role.toLowerCase().replace(/\s+/g, "-");
const plural = (role: string, n: number) => (n === 1 ? role : `${role}s`);
---

<BaseLayout
    title="People"
    description="Meet the researchers and team behind the Multidisciplinary AI Research Centre."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>People</li>
    </Breadcrumb>

    <PageHeader eyebrow="People" lead="Meet the team.">
        <Fragment slot="title">
            The people
            <br />
            <span class="text-gradient">behind MARC.</span>
        </Fragment>

        <nav slot="after" class="mt-10 flex flex-wrap gap-2" aria-label="Roles">
            {
                sortedRoles.map((role) => (
                    <a href={`#${roleId(role)}`} class="glass-chip">
                        {plural(role, groupedPeople[role].length)}
                        <span class="tabular-nums text-[#5170FF] font-semibold">
                            {groupedPeople[role].length}
                        </span>
                    </a>
                ))
            }
        </nav>
    </PageHeader>

    <!-- ===================================================== -->
    <!-- ROLE SECTIONS -->
    <!-- ===================================================== -->

    <div class="mt-16 space-y-16 lg:mt-20 lg:space-y-20">
        {
            sortedRoles.map((role) => {
                const isLead = leadership.has(role);
                return (
                    <section id={roleId(role)} class="scroll-mt-28">
                        <div class="mb-6 flex items-center gap-4">
                            <h2 class="shrink-0 font-display text-3xl sm:text-4xl text-base-content">
                                {plural(role, groupedPeople[role].length)}
                            </h2>
                            <div class="h-px flex-grow bg-gradient-to-r from-base-content/15 to-transparent" />
                        </div>

                        <ul
                            class={`grid gap-5 sm:gap-6 ${
                                isLead
                                    ? "grid-cols-1 md:grid-cols-2"
                                    : "grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
                            }`}
                        >
                            {groupedPeople[role].map((person) => (
                                <li>
                                    <a
                                        href={`/people/${person.id}/`}
                                        class={`group glass-card glass-hover flex h-full p-3 ${
                                            isLead ? "flex-col sm:flex-row sm:items-center sm:gap-6" : "flex-col"
                                        }`}
                                    >
                                        <div
                                            class={`relative overflow-hidden rounded-[1.25rem] bg-gradient-to-br from-[#dfe6ff] via-[#eef1ff] to-[#f6dde4] dark:from-[#1b2340] dark:via-[#161a2e] dark:to-[#2a1620] ${
                                                isLead ? "aspect-square sm:w-48 sm:shrink-0" : "aspect-square"
                                            }`}
                                        >
                                            <Image
                                                src={person.data.photo ?? default_avatar}
                                                alt={person.data.name}
                                                width={isLead ? 400 : 320}
                                                height={isLead ? 400 : 320}
                                                class={`h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] ${
                                                    person.data.photo ? "" : "p-8 opacity-40"
                                                }`}
                                            />
                                        </div>

                                        <div class={`px-2 pb-2 ${isLead ? "pt-5 sm:py-4" : "pt-4"}`}>
                                            <h3
                                                class={`font-semibold leading-snug text-base-content transition-colors group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF] ${
                                                    isLead ? "font-display text-2xl sm:text-3xl" : "text-base sm:text-lg"
                                                }`}
                                            >
                                                {person.data.name}
                                            </h3>
                                            <p class="mt-1 text-sm text-base-content/60">{person.data.post}</p>
                                            {isLead && (
                                                <p class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[#004AAD] dark:text-[#5170FF]">
                                                    View profile
                                                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                                                </p>
                                            )}
                                        </div>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                );
            })
        }
    </div>
</BaseLayout>
