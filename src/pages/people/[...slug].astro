---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import default_avatar from "../../assets/avatar_default.svg";
import "../../styles/app.css";

export async function getStaticPaths() {
    const people = await getCollection("people");
    return people.map((person) => ({
        params: { slug: person.id },
        props: { person },
    }));
}

const { person } = Astro.props;
const { Content } = await render(person);
const hasBio = Boolean(person.body?.trim());
const email = person.data.email.trim();

// Projects this person supervises or works on
const projects = (await getCollection("projects")).filter(
    (project) =>
        project.data.projectMembers.map((e) => e.trim()).includes(email) ||
        project.data.supervisors.map((e) => e.trim()).includes(email),
);
const roleIn = (project: (typeof projects)[number]) =>
    project.data.supervisors.map((e) => e.trim()).includes(email) ? "Supervisor" : "Researcher";

// Publications (newest first)
const publications = (await getCollection("publications"))
    .filter((pub) => pub.data.people.includes(email))
    .sort(
        (a, b) =>
            new Date(b.data.publication_date).getTime() -
            new Date(a.data.publication_date).getTime(),
    );
---

<BaseLayout title={person.data.name} description={`${person.data.name} — ${person.data.post} at MARC.`}>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li><a href="/people">People</a></li>
        <li>{person.data.name}</li>
    </Breadcrumb>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
        <!-- ===================================================== -->
        <!-- PROFILE CARD -->
        <!-- ===================================================== -->

        <aside class="lg:col-span-4">
            <div class="glass-card p-3 lg:sticky lg:top-28">
                <div class="aspect-square overflow-hidden rounded-[1.4rem] bg-gradient-to-br from-[#dfe6ff] via-[#eef1ff] to-[#f6dde4] dark:from-[#1b2340] dark:via-[#161a2e] dark:to-[#2a1620]">
                    <Image
                        src={person.data.photo ?? default_avatar}
                        alt={person.data.name}
                        width={600}
                        height={600}
                        class={`h-full w-full object-cover ${person.data.photo ? "" : "p-16 opacity-40"}`}
                    />
                </div>

                <div class="px-3 pb-3 pt-6">
                    <span class="rounded-full bg-[#5170FF]/10 px-3 py-1 text-xs font-semibold text-[#3f55c9] dark:text-[#9fb0ff]">
                        {person.data.post}
                    </span>
                    <h1 class="mt-4 font-display text-3xl sm:text-4xl text-base-content">
                        {person.data.name}
                    </h1>

                    <a
                        href={`mailto:${email}`}
                        class="mt-5 flex items-center gap-3 rounded-2xl bg-white/50 p-3 text-sm text-base-content/80 ring-1 ring-white/80 transition-colors hover:text-[#004AAD] dark:bg-white/5 dark:ring-white/10 dark:hover:text-[#5170FF]"
                    >
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-gradient-to-r from-[#3f6bf5] to-[#7a84f0] text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                                <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
                                <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
                            </svg>
                        </span>
                        <span class="min-w-0 break-all">{email}</span>
                    </a>

                    <div class="mt-5 grid grid-cols-2 gap-3 text-center">
                        <div class="rounded-2xl bg-white/40 p-3 ring-1 ring-white/70 dark:bg-white/5 dark:ring-white/10">
                            <p class="font-display text-2xl text-base-content tabular-nums">{projects.length}</p>
                            <p class="text-xs text-base-content/55">{projects.length === 1 ? "Project" : "Projects"}</p>
                        </div>
                        <div class="rounded-2xl bg-white/40 p-3 ring-1 ring-white/70 dark:bg-white/5 dark:ring-white/10">
                            <p class="font-display text-2xl text-base-content tabular-nums">{publications.length}</p>
                            <p class="text-xs text-base-content/55">{publications.length === 1 ? "Publication" : "Publications"}</p>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ===================================================== -->
        <!-- BIO, PROJECTS, PUBLICATIONS -->
        <!-- ===================================================== -->

        <div class="space-y-12 lg:col-span-8">
            <section class="glass-card p-6 sm:p-8 lg:p-10">
                <p class="eyebrow">Biography</p>
                {
                    hasBio ? (
                        <article class="prose prose-lg mt-4 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-[#004AAD]">
                            <Content />
                        </article>
                    ) : (
                        <p class="mt-4 text-base-content/60">A biography will be added soon.</p>
                    )
                }
            </section>

            {
                projects.length > 0 && (
                    <section>
                        <div class="mb-5 flex items-center gap-3">
                            <h2 class="font-display text-3xl text-base-content">Projects</h2>
                            <span class="rounded-full bg-base-content/10 px-2.5 py-0.5 text-sm font-semibold tabular-nums">
                                {projects.length}
                            </span>
                        </div>

                        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                            {projects.map((p) => (
                                <a href={`/projects/${p.id}`} class="group glass-card glass-hover flex flex-col p-3">
                                    <div class="aspect-[16/9] overflow-hidden rounded-[1.25rem] bg-base-content/5">
                                        {p.data.coverImage && (
                                            <Image
                                                src={p.data.coverImage}
                                                alt={p.data.project}
                                                width={600}
                                                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                                            />
                                        )}
                                    </div>
                                    <div class="flex flex-grow flex-col px-2 pb-2 pt-4">
                                        <p class="text-xs text-base-content/55">
                                            {p.data.researchArea} · {roleIn(p)}
                                        </p>
                                        <h3 class="mt-1 text-lg font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                            {p.data.project}
                                        </h3>
                                        <ArrowPill label="View project" class="mt-4 self-start !px-4 !py-2" />
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                publications.length > 0 && (
                    <section>
                        <div class="mb-5 flex items-center gap-3">
                            <h2 class="font-display text-3xl text-base-content">Publications</h2>
                            <span class="rounded-full bg-base-content/10 px-2.5 py-0.5 text-sm font-semibold tabular-nums">
                                {publications.length}
                            </span>
                        </div>
                        <div class="space-y-4">
                            {publications.map((pub) => (
                                <PublicationItem
                                    title={pub.data.paper_title}
                                    venue={pub.data.venue}
                                    type={pub.data.type}
                                    doi={pub.data.doi}
                                    date={pub.data.publication_date}
                                    authors={pub.data.authors}
                                    project={pub.data.project}
                                />
                            ))}
                        </div>
                    </section>
                )
            }
        </div>
    </div>
</BaseLayout>
