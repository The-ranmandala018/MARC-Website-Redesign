---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import default_avatar from "../../assets/avatar_default.svg";
import { researchAreaUrl } from "../../utils/researchAreas";
import { excerpt } from "../../utils/text";
import "../../styles/app.css";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

// People lookup by email (supervisors may also be plain names)
const people = await getCollection("people");
const peopleByEmail = new Map(people.map((p) => [p.data.email.trim(), p]));
const resolve = (key: string) => ({
    key,
    person: peopleByEmail.get(key.trim()),
});
const supervisors = project.data.supervisors.map(resolve);
const members = project.data.projectMembers.map(resolve);

// Publications linked to this project, newest first
const publications = (await getCollection("publications"))
    .filter((pub) => pub.data.project === project.data.project)
    .sort(
        (a, b) =>
            new Date(b.data.publication_date).getTime() -
            new Date(a.data.publication_date).getTime(),
    );

const areaUrl = researchAreaUrl(project.data.researchArea);

// A few other projects to continue browsing
const otherProjects = (await getCollection("projects"))
    .filter((p) => p.id !== project.id)
    .slice(0, 3);
---

<BaseLayout
    title={project.data.project}
    description={excerpt(project.body, 155) || `${project.data.project} — a MARC research project.`}
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li><a href="/Research">Research</a></li>
        {areaUrl && <li><a href={areaUrl}>{project.data.researchArea}</a></li>}
        <li class="truncate max-w-[220px]">{project.data.project}</li>
    </Breadcrumb>

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header>
        <div class="flex flex-wrap items-center gap-2">
            {
                areaUrl ? (
                    <a href={areaUrl} class="glass-chip !text-[#004AAD] dark:!text-[#9fb0ff] font-semibold">
                        {project.data.researchArea}
                    </a>
                ) : (
                    <span class="glass-chip font-semibold">{project.data.researchArea}</span>
                )
            }
            {
                project.data.researchPillars?.map((pillar) => (
                    <span class="rounded-full bg-[#5170FF]/10 px-3 py-1.5 text-xs font-medium text-[#3f55c9] dark:text-[#9fb0ff]">
                        {pillar}
                    </span>
                ))
            }
        </div>

        <h1 class="mt-6 max-w-4xl font-display text-5xl sm:text-6xl lg:text-7xl text-base-content">
            {project.data.project}
        </h1>

        <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm text-base-content/60">
            <span>{supervisors.length + members.length} people</span>
            <span>{publications.length} {publications.length === 1 ? "publication" : "publications"}</span>
        </p>
    </header>

    <!-- Cover -->
    {
        project.data.coverImage && (
            <div class="glass-card mt-10 p-2.5 sm:p-3 !rounded-[2rem]">
                <Image
                    src={project.data.coverImage}
                    alt={project.data.project}
                    width={1400}
                    class="aspect-[16/9] lg:aspect-[21/9] w-full rounded-[1.5rem] object-cover"
                />
            </div>
        )
    }

    <!-- ===================================================== -->
    <!-- BODY + SIDEBAR -->
    <!-- ===================================================== -->

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="space-y-10 lg:col-span-8">
            <section class="glass-card p-6 sm:p-8 lg:p-10">
                <p class="eyebrow">Overview</p>
                {
                    hasBody ? (
                        <article class="prose prose-lg mt-4 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-[#004AAD] prose-img:rounded-2xl">
                            <Content />
                        </article>
                    ) : (
                        <p class="mt-4 text-base-content/60">
                            More details about this project will be added soon.
                        </p>
                    )
                }
            </section>

            {
                publications.length > 0 && (
                    <section>
                        <div class="mb-5 flex items-center gap-3">
                            <h2 class="font-display text-3xl text-base-content">Publications</h2>
                            <span class="rounded-full bg-base-content/10 px-2.5 py-0.5 text-sm font-semibold tabular-nums">
                                {publications.length}
                            </span>
                        </div>
                        <div class="space-y-4">
                            {publications.map((pub) => (
                                <PublicationItem
                                    title={pub.data.paper_title}
                                    venue={pub.data.venue}
                                    type={pub.data.type}
                                    doi={pub.data.doi}
                                    date={pub.data.publication_date}
                                    authors={pub.data.authors}
                                />
                            ))}
                        </div>
                    </section>
                )
            }
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-4">
            <div class="space-y-6 lg:sticky lg:top-28">
                <div class="glass-card p-6">
                    <p class="eyebrow">Project team</p>

                    {
                        [
                            { label: "Supervisors", list: supervisors, size: 44 },
                            { label: "Researchers", list: members, size: 36 },
                        ].map(
                            (group) =>
                                group.list.length > 0 && (
                                    <div class="mt-5">
                                        <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/45">
                                            {group.label}
                                        </h3>
                                        <ul class="mt-3 space-y-1">
                                            {group.list.map(({ key, person }) => {
                                                const Tag = person ? "a" : "div";
                                                return (
                                                    <li>
                                                        <Tag
                                                            {...(person ? { href: `/people/${person.id}/` } : {})}
                                                            class="-mx-2 flex items-center gap-3 rounded-2xl p-2 transition-colors hover:bg-white/60 dark:hover:bg-white/5"
                                                        >
                                                            <Image
                                                                src={person?.data.photo ?? default_avatar}
                                                                alt={person?.data.name ?? key}
                                                                width={group.size * 2}
                                                                height={group.size * 2}
                                                                class="shrink-0 rounded-full object-cover ring-2 ring-white dark:ring-white/10"
                                                                style={`width:${group.size}px;height:${group.size}px`}
                                                            />
                                                            <div class="min-w-0">
                                                                <p class="truncate text-sm font-semibold text-base-content">
                                                                    {person?.data.name ?? key}
                                                                </p>
                                                                {person && (
                                                                    <p class="truncate text-xs text-base-content/55">
                                                                        {person.data.post}
                                                                    </p>
                                                                )}
                                                            </div>
                                                        </Tag>
                                                    </li>
                                                );
                                            })}
                                        </ul>
                                    </div>
                                ),
                        )
                    }
                </div>

                {
                    areaUrl && (
                        <div class="glass-card p-6">
                            <p class="eyebrow">Research area</p>
                            <p class="mt-3 font-display text-2xl text-base-content">
                                {project.data.researchArea}
                            </p>
                            <ArrowPill label="Explore area" href={areaUrl} class="mt-5" />
                        </div>
                    )
                }
            </div>
        </aside>
    </div>

    <!-- ===================================================== -->
    <!-- MORE PROJECTS -->
    <!-- ===================================================== -->

    {
        otherProjects.length > 0 && (
            <section class="mt-20">
                <div class="mb-6 flex items-end justify-between gap-4">
                    <h2 class="font-display text-3xl sm:text-4xl text-base-content">More projects</h2>
                    <ArrowPill label="All research" href="/Research" />
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {otherProjects.map((p) => (
                        <a href={`/projects/${p.id}`} class="group glass-card glass-hover flex items-center gap-4 p-3">
                            <div class="h-20 w-24 shrink-0 overflow-hidden rounded-2xl bg-base-content/5">
                                {p.data.coverImage && (
                                    <Image
                                        src={p.data.coverImage}
                                        alt={p.data.project}
                                        width={200}
                                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    />
                                )}
                            </div>
                            <div class="min-w-0 pr-2">
                                <p class="truncate text-xs text-base-content/55">{p.data.researchArea}</p>
                                <p class="mt-1 font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                    {p.data.project}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>
