---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Breadcrumb from "../../components/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArrowPill from "../../components/ArrowPill.astro";
import default_avatar from "../../assets/avatar_default.svg";
import { excerpt } from "../../utils/text";
import "../../styles/app.css";

const projects = await getCollection("projects");
const people = await getCollection("people");
const peopleByEmail = new Map(people.map((p) => [p.data.email.trim(), p]));

// Research areas present in the projects, for the filter chips.
const areas = [...new Set(projects.map((p) => p.data.researchArea))].sort();

const cards = projects.map((project) => {
    const team = [...project.data.supervisors, ...project.data.projectMembers];
    const avatars = team
        .map((email) => peopleByEmail.get(email.trim()))
        .filter(Boolean)
        .slice(0, 4) as typeof people;
    return {
        project,
        teamSize: team.length,
        avatars,
        summary: excerpt(project.body, 170),
    };
});
---

<BaseLayout
    title="Projects"
    description="Research projects at MARC — exploring the frontiers of engineering and AI."
>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li>Projects</li>
    </Breadcrumb>

    <PageHeader eyebrow="Projects" lead="Exploring the frontiers of engineering and AI.">
        <Fragment slot="title">
            Research
            <br />
            <span class="text-gradient">projects.</span>
        </Fragment>

        <!-- Filter by research area -->
        <div slot="after" class="mt-10 flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects by research area">
            <button type="button" class="glass-chip" data-filter="all" aria-pressed="true">
                All
                <span class="tabular-nums opacity-70">{projects.length}</span>
            </button>
            {
                areas.map((area) => (
                    <button type="button" class="glass-chip" data-filter={area} aria-pressed="false">
                        {area}
                    </button>
                ))
            }
        </div>
    </PageHeader>

    <!-- ===================================================== -->
    <!-- PROJECT GRID — first card is featured (wide) -->
    <!-- ===================================================== -->

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8" id="project-grid">
        {
            cards.map(({ project, teamSize, avatars, summary }, i) => (
                <a
                    href={`/projects/${project.id}`}
                    data-area={project.data.researchArea}
                    class={`project-card group glass-card glass-hover flex flex-col p-3 ${i === 0 ? "md:col-span-2 lg:grid lg:grid-cols-2 lg:gap-6 lg:items-stretch" : ""}`}
                >
                    <!-- Image -->
                    <div class={`relative overflow-hidden rounded-[1.25rem] bg-base-content/5 ${i === 0 ? "aspect-[16/10] lg:aspect-auto lg:h-full lg:min-h-[320px]" : "aspect-[16/10]"}`}>
                        {project.data.coverImage && (
                            <Image
                                src={project.data.coverImage}
                                alt={project.data.project}
                                width={i === 0 ? 900 : 600}
                                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                            />
                        )}
                        <span class="absolute left-3 top-3 rounded-full border border-white/40 bg-[#141a2e]/40 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">
                            {project.data.researchArea}
                        </span>
                    </div>

                    <!-- Body -->
                    <div class={`flex flex-grow flex-col px-3 pb-3 ${i === 0 ? "pt-5 lg:py-6 lg:pr-6" : "pt-5"}`}>
                        {i === 0 && <p class="eyebrow mb-3">Featured project</p>}

                        <h2 class={`font-display text-base-content transition-colors group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF] ${i === 0 ? "text-3xl sm:text-4xl" : "text-2xl"}`}>
                            {project.data.project}
                        </h2>

                        {summary && (
                            <p class={`mt-3 text-sm leading-relaxed text-base-content/70 ${i === 0 ? "line-clamp-4 sm:text-base" : "line-clamp-3"}`}>
                                {summary}
                            </p>
                        )}

                        <div class="mt-4 flex flex-wrap gap-1.5">
                            {project.data.researchPillars?.map((pillar) => (
                                <span class="rounded-full bg-[#5170FF]/10 px-2.5 py-1 text-xs font-medium text-[#3f55c9] dark:text-[#9fb0ff]">
                                    {pillar}
                                </span>
                            ))}
                        </div>

                        <!-- Footer: team + CTA -->
                        <div class="mt-auto flex items-center justify-between gap-3 pt-6">
                            <div class="flex items-center gap-3">
                                <div class="flex -space-x-2">
                                    {avatars.map((person) => (
                                        <Image
                                            src={person.data.photo ?? default_avatar}
                                            alt={person.data.name}
                                            width={64}
                                            height={64}
                                            class="h-8 w-8 rounded-full object-cover ring-2 ring-white dark:ring-[#0B0405]"
                                        />
                                    ))}
                                </div>
                                <span class="text-xs font-medium text-base-content/60">
                                    {teamSize} {teamSize === 1 ? "member" : "members"}
                                </span>
                            </div>

                            <ArrowPill label="View" class="!px-4 !py-2" />
                        </div>
                    </div>
                </a>
            ))
        }
    </div>

    <p id="project-empty" class="mt-10 hidden text-center text-base-content/60">
        No projects in this area yet.
    </p>
</BaseLayout>

<script>
    // Research-area filter for the project grid.
    const chips = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    const empty = document.getElementById("project-empty");

    chips.forEach((chip) => {
        chip.addEventListener("click", () => {
            const filter = chip.dataset.filter;
            chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));

            let shown = 0;
            cards.forEach((card) => {
                const match = filter === "all" || card.dataset.area === filter;
                card.hidden = !match;
                if (match) shown++;
            });
            empty?.classList.toggle("hidden", shown > 0);
        });
    });
</script>

<style>
    /* the grid's `hidden` attribute must beat the card's display utilities */
    .project-card[hidden] {
        display: none !important;
    }
</style>
