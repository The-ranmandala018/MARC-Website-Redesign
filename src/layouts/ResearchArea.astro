---
import "../styles/app.css";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ArrowPill from "../components/ArrowPill.astro";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getResearchAreas } from "../utils/researchAreas";

const { frontmatter } = Astro.props;

// Cover image from src/assets (same lookup as before, with a safety check)
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{jpeg,jpg,png,gif}",
    { eager: true },
);
const heroImage = images[`/src/assets/${frontmatter.coverImage}`]?.default;

// Projects in this area
const relatedProjects = (await getCollection("projects")).filter(
    (project) => project.data.researchArea === frontmatter.title,
);

// The other areas, for onward navigation
const otherAreas = getResearchAreas().filter((a) => a.title !== frontmatter.title);
---

<BaseLayout title={frontmatter.title} description={frontmatter.short?.slice(0, 155)}>
    <Breadcrumb>
        <li><a href="/">Home</a></li>
        <li><a href="/Research">Research Areas</a></li>
        <li>{frontmatter.title}</li>
    </Breadcrumb>

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header>
        <p class="eyebrow flex items-center gap-3 !opacity-100 text-[#004AAD] dark:text-[#5170FF]">
            <span class="inline-block h-0.5 w-8 rounded-full bg-current"></span>
            Research area
        </p>
        <h1 class="mt-6 max-w-4xl font-display text-5xl sm:text-6xl lg:text-7xl text-base-content">
            {frontmatter.title}
        </h1>
        {
            frontmatter.description && (
                <p class="mt-6 max-w-2xl text-lg text-base-content/70">{frontmatter.description}</p>
            )
        }
    </header>

    {
        heroImage && (
            <div class="glass-card mt-10 p-2.5 sm:p-3 !rounded-[2rem]">
                <Image
                    src={heroImage}
                    alt={frontmatter.title}
                    width={1400}
                    class="aspect-[16/9] lg:aspect-[21/9] w-full rounded-[1.5rem] object-cover"
                    priority
                />
            </div>
        )
    }

    <!-- ===================================================== -->
    <!-- OVERVIEW -->
    <!-- ===================================================== -->

    <section class="glass-card mt-8 p-6 sm:p-10 lg:p-12">
        <p class="eyebrow">Overview</p>
        <article class="prose prose-lg mt-4 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-[#004AAD] prose-img:rounded-2xl">
            <slot />
        </article>
    </section>

    <!-- ===================================================== -->
    <!-- RELATED PROJECTS -->
    <!-- ===================================================== -->

    {
        relatedProjects.length > 0 && (
            <section class="mt-16">
                <div class="mb-6 flex items-end justify-between gap-4">
                    <h2 class="font-display text-3xl sm:text-4xl text-base-content">Projects in this area</h2>
                    <ArrowPill label="All projects" href="/projects" class="hidden sm:inline-flex" />
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {relatedProjects.map((project) => (
                        <a href={`/projects/${project.id}`} class="group glass-card glass-hover flex flex-col p-3">
                            <div class="aspect-[16/10] overflow-hidden rounded-[1.25rem] bg-base-content/5">
                                {project.data.coverImage && (
                                    <Image
                                        src={project.data.coverImage}
                                        alt={project.data.project}
                                        width={600}
                                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                                    />
                                )}
                            </div>
                            <div class="flex flex-grow flex-col px-2 pb-2 pt-4">
                                <h3 class="text-xl font-semibold leading-snug text-base-content group-hover:text-[#004AAD] dark:group-hover:text-[#5170FF]">
                                    {project.data.project}
                                </h3>
                                <div class="mt-3 flex flex-wrap gap-1.5">
                                    {project.data.researchPillars?.map((pillar: string) => (
                                        <span class="rounded-full bg-[#5170FF]/10 px-2.5 py-1 text-xs font-medium text-[#3f55c9] dark:text-[#9fb0ff]">
                                            {pillar}
                                        </span>
                                    ))}
                                </div>
                                <ArrowPill label="View project" class="mt-5 self-start !px-4 !py-2" />
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }

    <!-- ===================================================== -->
    <!-- OTHER AREAS -->
    <!-- ===================================================== -->

    {
        otherAreas.length > 0 && (
            <section class="mt-16">
                <p class="eyebrow">Explore other research areas</p>
                <div class="mt-4 flex flex-wrap gap-2">
                    {otherAreas.map((a) => (
                        <a href={a.url} class="glass-chip">
                            {a.title}
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>
