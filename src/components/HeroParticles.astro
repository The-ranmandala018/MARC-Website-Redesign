---
/**
 * HeroParticles
 * A round cloud of fine dots in the MARC brand colours (sparse in the
 * middle, fading at the edge) with a thin, jagged ripple line that
 * contracts from the rim toward the centre, dissolves, and starts again.
 *
 * Drawn on a plain 2D canvas (no extra libraries). Works over the site's
 * light or dark hero background.
 */
---

<div class="hero-particles" aria-hidden="true">
    <canvas id="marc-particles"></canvas>
</div>

<style>
    .hero-particles {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
        overflow: hidden;
    }

    #marc-particles {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>

<script>
    const canvas = document.querySelector<HTMLCanvasElement>("#marc-particles");
    const ctx = canvas?.getContext("2d");

    if (canvas && ctx) {
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        // ---------------------------------------------------------
        // Tuning
        // ---------------------------------------------------------
        const LOOP_SECONDS = 1.6; // one ripple cycle — faster than before
        const ACTIVE = 0.75; // share of the cycle where the ripple is visible
        const COUNT = window.innerWidth < 700 ? 2400 : 4200;
        const SHIMMER_SPEED = 2.4; // was 0.8/0.7 — brisker per-dot flicker
        const WAVE_DRIFT_SPEED = 2.6; // was 0.5 — the jagged line moves faster

        // Radial profile measured from the reference, in bins of 40px out of a
        // 243px radius: how many dots fall in each ring, and how dense it is.
        const BIN_FRACTION = [0.003, 0.037, 0.047, 0.066, 0.086, 0.047];
        const BIN_DENSITY = [45, 76, 119, 136, 110, 70].map((v) => v / 255);
        const BIN_WIDTH = 40 / 243;

        // MARC brand palette (from the brand colour sheet).
        const DEEP_BLUE = "#073BCE";
        const ELECTRIC_CYAN = "#00CFF5";
        const SIGNAL_RED = "#F51D2A";
        const MIDNIGHT_NAVY = "#101A35";
        const COLOR_WEIGHTS: [string, number][] = [
            [DEEP_BLUE, 0.48],
            [ELECTRIC_CYAN, 0.34],
            [MIDNIGHT_NAVY, 0.12],
            [SIGNAL_RED, 0.06],
        ];
        const colorTotal = COLOR_WEIGHTS.reduce((s, [, w]) => s + w, 0);
        function pickColor(): string {
            let r = Math.random() * colorTotal;
            for (const [color, w] of COLOR_WEIGHTS) {
                if (r < w) return color;
                r -= w;
            }
            return DEEP_BLUE;
        }

        // ---------------------------------------------------------
        // Build the dots
        // ---------------------------------------------------------
        const weights = BIN_FRACTION.map((f, k) => f * (2 * k + 1)); // x ring area
        const total = weights.reduce((a, b) => a + b, 0);

        const rho = new Float32Array(COUNT); // distance from centre (0..1)
        const theta = new Float32Array(COUNT); // angle
        const density = new Float32Array(COUNT); // base opacity (0..1)
        const sizeMul = new Float32Array(COUNT);
        const phase = new Float32Array(COUNT);
        const pick = new Float32Array(COUNT); // decides who joins the ripple line
        const color: string[] = new Array(COUNT);

        for (let i = 0; i < COUNT; i++) {
            let r = Math.random() * total;
            let k = 0;
            while (k < weights.length - 1 && r > weights[k]) {
                r -= weights[k];
                k++;
            }
            rho[i] = (k + Math.random()) * BIN_WIDTH;
            theta[i] = Math.random() * Math.PI * 2;

            density[i] = Math.min(
                1,
                BIN_DENSITY[k] * (0.6 + Math.random() * 0.9),
            );
            sizeMul[i] = 0.8 + Math.random() * 0.5;
            phase[i] = Math.random() * Math.PI * 2;
            pick[i] = Math.random();
            color[i] = pickColor();
        }

        // Draw order grouped by colour, so each frame sets fillStyle only
        // once per colour instead of once per dot.
        const order = Array.from({ length: COUNT }, (_, i) => i).sort((a, b) =>
            color[a] < color[b] ? -1 : color[a] > color[b] ? 1 : 0,
        );

        // Harmonics that make the ripple line jagged rather than a clean circle.
        const HARM = [3, 5, 8, 13, 21, 34];
        const AMP = [0.07, 0.05, 0.035, 0.022, 0.012, 0.007];
        const harmPhase = HARM.map(() => Math.random() * Math.PI * 2);
        const harmDrift = HARM.map(() => (Math.random() - 0.5) * 0.9);

        const smooth = (a: number, b: number, x: number) => {
            const t = Math.min(Math.max((x - a) / (b - a), 0), 1);
            return t * t * (3 - 2 * t);
        };

        // ---------------------------------------------------------
        // Sizing
        // ---------------------------------------------------------
        let width = 1;
        let height = 1;
        let dpr = 1;

        function resize() {
            const rect = canvas!.getBoundingClientRect();
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = Math.max(1, rect.width);
            height = Math.max(1, rect.height);
            canvas!.width = Math.round(width * dpr);
            canvas!.height = Math.round(height * dpr);
        }

        // Gentle pointer parallax (smoothed).
        let targetX = 0;
        let targetY = 0;
        let offX = 0;
        let offY = 0;
        window.addEventListener(
            "pointermove",
            (e) => {
                targetX = e.clientX / window.innerWidth - 0.5;
                targetY = e.clientY / window.innerHeight - 0.5;
            },
            { passive: true },
        );

        // ---------------------------------------------------------
        // Render one frame at time t (seconds)
        // ---------------------------------------------------------
        function draw(t: number) {
            const c = ctx!;
            c.setTransform(1, 0, 0, 1, 0, 0);
            c.clearRect(0, 0, canvas!.width, canvas!.height);

            offX += (targetX - offX) * 0.04;
            offY += (targetY - offY) * 0.04;

            const radiusCss = Math.min(width, height) * 0.48;
            const radius = radiusCss * dpr;
            const cx = (width / 2 - offX * 16) * dpr;
            const cy = (height / 2 - offY * 16) * dpr;
            const dotSize =
                Math.min(Math.max(radiusCss * 0.005, 1.2), 2.2) * dpr;

            // Where are we in the ripple cycle?
            const p = (t % LOOP_SECONDS) / LOOP_SECONDS;
            const qRaw = (p + 0.15) % 1; // p = 0 matches the reference's first frame
            const active = qRaw < ACTIVE;
            const q = qRaw / ACTIVE;
            const waveR = 0.97 - 0.72 * q; // contracts from rim to centre
            const env = active
                ? smooth(0, 0.1, q) * (1 - smooth(0.82, 1, q))
                : 0;

            let currentColor = "";

            for (let oi = 0; oi < COUNT; oi++) {
                const i = order[oi];

                // Tiny shimmer so the field never looks frozen.
                const wob = reducedMotion ? 0 : 0.0035;
                let x =
                    rho[i] * Math.cos(theta[i]) +
                    Math.cos(t * SHIMMER_SPEED + phase[i]) * wob;
                let y =
                    rho[i] * Math.sin(theta[i]) +
                    Math.sin(t * SHIMMER_SPEED * 0.9 + phase[i] * 1.3) * wob;
                let b = density[i];

                if (env > 0.001) {
                    const r = Math.hypot(x, y);
                    const a = Math.atan2(y, x);

                    // Jagged ripple radius at this angle.
                    let jag = 0;
                    for (let h = 0; h < HARM.length; h++) {
                        jag +=
                            AMP[h] *
                            Math.sin(HARM[h] * a + harmPhase[h] + harmDrift[h] * t);
                    }
                    const wr = waveR * (1 + jag);

                    // Pull nearby dots onto the line; only some arcs are strong,
                    // so the line looks broken and hand-drawn like the reference.
                    const d = r - wr;
                    const near = Math.exp(-((d / 0.06) * (d / 0.06)));
                    const arc =
                        0.5 +
                        0.5 * Math.sin(3 * a + 1.7 + t * WAVE_DRIFT_SPEED);
                    const local = env * Math.pow(arc, 0.7);
                    const join = Math.min(
                        Math.max((local * 1.4 - pick[i]) * 3, 0),
                        1,
                    );
                    const pull = near * join;

                    if (pull > 0) {
                        const r2 = r - d * 0.88 * pull;
                        const k = r2 / (r || 1);
                        x *= k;
                        y *= k;
                        b = Math.min(1, b + 0.4 * pull);
                    }
                }

                const sx = Math.round(cx + x * radius);
                const sy = Math.round(cy + y * radius);
                const s = Math.max(1, Math.round(dotSize * sizeMul[i]));

                if (color[i] !== currentColor) {
                    currentColor = color[i];
                    c.fillStyle = currentColor;
                }
                c.globalAlpha = b;
                c.fillRect(sx, sy, s, s);
            }

            c.globalAlpha = 1;
        }

        // ---------------------------------------------------------
        // Loop control (pause when hidden or off screen)
        // ---------------------------------------------------------
        let raf = 0;
        let running = false;
        let visible = true;
        const startTime = performance.now();

        function frame(now: number) {
            draw((now - startTime) / 1000);
            raf = requestAnimationFrame(frame);
        }

        function start() {
            if (running || reducedMotion) return;
            running = true;
            raf = requestAnimationFrame(frame);
        }

        function stop() {
            running = false;
            cancelAnimationFrame(raf);
        }

        function sync() {
            if (visible && !document.hidden) start();
            else stop();
        }

        resize();
        draw(0);

        new ResizeObserver(() => {
            resize();
            if (reducedMotion || !running) draw(0);
        }).observe(canvas);

        new IntersectionObserver((entries) => {
            visible = entries[0]?.isIntersecting ?? true;
            sync();
        }).observe(canvas);

        document.addEventListener("visibilitychange", sync);

        sync();
    }
</script>
