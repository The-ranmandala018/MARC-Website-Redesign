---
/**
 * ArrowPill
 * MARC-themed call-to-action pill used across pages.
 * Renders a <span> inside a clickable card unless href is provided.
 */
interface Props {
    label: string;
    href?: string;
    external?: boolean;
    class?: string;
}

const { label, href, external = false, class: extra = "" } = Astro.props;
const Tag = href ? "a" : "span";
const isExplore = label.toLowerCase().includes("explore");
const linkProps = href
    ? { href, ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
    : {};
---

<Tag
    {...linkProps}
    class={`marc-cta-pill ${isExplore ? "marc-cta-pill--explore" : "marc-cta-pill--standard"} group/cta inline-flex items-center gap-3 rounded-full px-5 py-2.5 text-sm font-semibold transition-all duration-300 hover:gap-4 group-hover:gap-4 ${extra}`}
>
    <span class="relative z-10">{label}</span>
    <span class={`marc-cta-icon ${isExplore ? "marc-cta-icon--explore" : "marc-cta-icon--standard"} grid h-7 w-7 shrink-0 place-items-center rounded-full text-white transition-transform duration-300 group-hover/cta:translate-x-0.5`}>
        {
            external ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
                </svg>
            ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
                </svg>
            )
        }
    </span>
</Tag>

<style>
    .marc-cta-pill {
        position: relative;
        isolation: isolate;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.42);
        background: linear-gradient(112deg, #004AAD 0%, #4167E8 48%, #7465D9 76%, #7C0E24 135%);
        box-shadow: 0 7px 20px -7px rgba(0, 74, 173, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.22);
        transition: transform 220ms ease, box-shadow 220ms ease, filter 220ms ease;
    }

    .marc-cta-icon {
        background: rgba(255, 255, 255, 0.19);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
    }

    .marc-cta-pill:hover {
        transform: translateY(-2px);
        filter: saturate(1.08) brightness(1.04);
        box-shadow: 0 11px 28px -8px rgba(0, 74, 173, 0.52), 0 0 16px rgba(81, 112, 255, 0.2);
    }

    .marc-cta-pill:focus-visible {
        outline: 3px solid rgba(81, 112, 255, 0.48);
        outline-offset: 3px;
    }

    :global(html[data-theme="marc-dark"]) .marc-cta-pill {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.22);
        background: linear-gradient(112deg, #174A9D 0%, #5369D8 48%, #7664C9 76%, #7C0E24 135%);
        box-shadow: 0 7px 22px -8px rgba(0, 0, 0, 0.62), inset 0 1px 0 rgba(255, 255, 255, 0.16);
    }

    :global(html[data-theme="marc-dark"]) .marc-cta-pill:hover {
        box-shadow: 0 11px 28px -8px rgba(0, 0, 0, 0.7), 0 0 18px rgba(81, 112, 255, 0.24);
    }

    @media (prefers-reduced-motion: reduce) {
        .marc-cta-pill,
        .marc-cta-icon {
            transition: none;
        }
    }
</style>
