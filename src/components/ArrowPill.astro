---
/**
 * ArrowPill
 * The "Explore area →" style call-to-action pill used across pages.
 * Renders a <span> (for use inside a clickable card) unless `href` is
 * given, in which case it renders a link.
 */
interface Props {
    label: string;
    href?: string;
    external?: boolean;
    class?: string;
}

const { label, href, external = false, class: extra = "" } = Astro.props;
const Tag = href ? "a" : "span";
const linkProps = href
    ? { href, ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
    : {};
---

<Tag
    {...linkProps}
    class={`inline-flex items-center gap-3 rounded-full bg-base-100/80 px-5 py-2.5 text-sm font-semibold text-base-content shadow-[0_10px_30px_-16px_rgba(70,90,180,0.5)] ring-1 ring-white/80 dark:ring-white/10 transition-all hover:gap-4 group-hover:gap-4 ${extra}`}
>
    {label}
    <span class="grid h-6 w-6 place-items-center rounded-full bg-gradient-to-r from-[#3f6bf5] to-[#7a84f0] text-white">
        {
            external ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
                </svg>
            ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
                </svg>
            )
        }
    </span>
</Tag>
