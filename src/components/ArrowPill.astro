---
/**
 * ArrowPill
 * MARC-themed call-to-action pill used across pages.
 * Renders a <span> inside a clickable card unless href is provided.
 */
interface Props {
    label: string;
    href?: string;
    external?: boolean;
    class?: string;
}

const { label, href, external = false, class: extra = "" } = Astro.props;
const Tag = href ? "a" : "span";
const isExplore = label.toLowerCase().includes("explore");
const linkProps = href
    ? { href, ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
    : {};
---

<Tag
    {...linkProps}
    class={`marc-cta-pill ${isExplore ? "marc-cta-pill--explore" : "marc-cta-pill--standard"} group/cta inline-flex items-center gap-3 rounded-full px-5 py-2.5 text-sm font-semibold transition-all duration-300 hover:gap-4 group-hover:gap-4 ${extra}`}
>
    <span class="relative z-10">{label}</span>
    <span class="marc-cta-icon grid h-7 w-7 shrink-0 place-items-center rounded-full text-white transition-transform duration-300 group-hover/cta:translate-x-0.5">
        {
            external ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
                </svg>
            ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
                </svg>
            )
        }
    </span>
</Tag>

<style>
    .marc-cta-pill {
        position: relative;
        isolation: isolate;
        color: #12315f;
        border: 1px solid rgba(255, 255, 255, 0.82);
        background: rgba(255, 255, 255, 0.72);
        box-shadow: 0 5px 16px -8px rgba(70, 90, 180, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    /* Use the distinctive MARC gradient-outline treatment only on Explore CTAs. */
    .marc-cta-pill--explore {
        border-color: rgba(81, 112, 255, 0.26);
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(247, 249, 255, 0.84) 60%, rgba(255, 246, 248, 0.9));
        box-shadow: 0 5px 16px -8px rgba(0, 74, 173, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.95);
    }

    .marc-cta-pill--explore::before {
        content: "";
        position: absolute;
        inset: -1px;
        z-index: -1;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(110deg, #004AAD, #5170FF 38%, #9BACF4 63%, #7C0E24);
        opacity: 0.7;
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
        transition: opacity 250ms ease;
    }

    .marc-cta-icon {
        background: linear-gradient(135deg, #004AAD 0%, #5170FF 58%, #7C0E24 125%);
        box-shadow: 0 3px 9px rgba(0, 74, 173, 0.28);
    }

    .marc-cta-pill:hover {
        transform: translateY(-2px);
        border-color: rgba(81, 112, 255, 0.48);
        box-shadow:
            0 10px 24px -10px rgba(0, 74, 173, 0.42),
            0 0 16px rgba(81, 112, 255, 0.13),
            inset 0 1px 0 rgba(255, 255, 255, 0.98);
    }

    .marc-cta-pill--explore:hover::before {
        opacity: 1;
    }

    :global(html[data-theme="marc-dark"]) .marc-cta-pill {
        color: #f8faff;
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(20, 29, 49, 0.72);
        box-shadow: 0 5px 18px -8px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    :global(html[data-theme="marc-dark"]) .marc-cta-pill--explore {
        border-color: rgba(156, 181, 255, 0.24);
        background: linear-gradient(135deg, rgba(20, 31, 57, 0.94), rgba(26, 28, 48, 0.9) 65%, rgba(57, 24, 42, 0.88));
    }

    :global(html[data-theme="marc-dark"]) .marc-cta-pill:hover {
        box-shadow: 0 10px 26px -10px rgba(0, 0, 0, 0.75), 0 0 18px rgba(81, 112, 255, 0.2);
    }

    @media (prefers-reduced-motion: reduce) {
        .marc-cta-pill,
        .marc-cta-icon {
            transition: none;
        }
    }
</style>
