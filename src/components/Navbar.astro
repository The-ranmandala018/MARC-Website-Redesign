---
import logo from "../assets/logo.png";
import { Image } from "astro:assets";

const links = [
    { href: "/", label: "Home" },
    { href: "/Research", label: "Research" },
    { href: "/projects", label: "Projects" },
    { href: "/publications", label: "Publications" },
    { href: "/people", label: "People" },
    { href: "/news", label: "News" },
    { href: "/contact", label: "Contact" },
];

const path =
    Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
    if (href === "/") return path === "/";

    return (
        path === href ||
        path.startsWith(href + "/")
    );
};
---

<header
    class="sticky top-0 z-50 bg-base-100/95 backdrop-blur-xl border-b border-base-300"
>
    <div
        class="container mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-8"
    >

        <div
            class="flex items-center justify-between min-h-20 lg:min-h-24 gap-4"
        >

            <!-- =====================================================
                 MARC BRAND — LEFT SIDE
                 ===================================================== -->

            <a
                href="/"
                class="flex items-center gap-3 shrink-0"
                aria-label="MARC Home"
            >
                <Image
                    src={logo}
                    alt="MARC logo"
                    class="h-14 sm:h-16 lg:h-[72px] w-auto object-contain"
                />

                <div class="leading-tight">
                    <div class="text-lg sm:text-xl lg:text-2xl font-extrabold tracking-tight text-base-content whitespace-nowrap">
                        Multidisciplinary AI Research Centre
                    </div>

                    <div class="mt-1 text-xs sm:text-sm lg:text-base font-semibold text-base-content/65 whitespace-nowrap">
                        University of Peradeniya
                    </div>
                </div>
            </a>


            <!-- =====================================================
                 DESKTOP NAVIGATION
                 ===================================================== -->

            <nav
                class="hidden xl:flex items-center gap-1"
            >
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class={`
                                relative
                                px-4
                                py-2.5
                                rounded-full
                                text-sm
                                font-medium
                                transition-all
                                duration-300

                                ${
                                    isActive(link.href)
                                        ? "bg-primary/10 text-primary"
                                        : "text-base-content/70 hover:text-base-content hover:bg-base-200"
                                }
                            `}
                        >
                            {link.label}

                            {
                                isActive(link.href) && (
                                    <span
                                        class="absolute left-1/2 -bottom-1 -translate-x-1/2 w-6 h-0.5 rounded-full bg-gradient-to-r from-sky-500 to-violet-500"
                                    ></span>
                                )
                            }
                        </a>
                    ))
                }
            </nav>


            <!-- =====================================================
                 RIGHT SIDE
                 ===================================================== -->

            <div class="flex items-center gap-2 shrink-0">

                <!-- AI Research indicator -->

                <div
                    class="hidden lg:flex items-center gap-2 px-3 py-2 rounded-full bg-base-200 border border-base-300"
                >
                    <span
                        class="w-2 h-2 rounded-full bg-gradient-to-r from-sky-500 to-violet-500 animate-pulse"
                    ></span>

                    <span
                        class="text-xs font-medium text-base-content/70"
                    >
                        AI Research
                    </span>
                </div>


                <!-- =================================================
                     DARK MODE BUTTON
                     ================================================= -->

                <button
                    id="theme-toggle"
                    type="button"
                    aria-label="Switch to dark mode"
                    class="flex items-center justify-center w-10 h-10 rounded-full border border-base-300 bg-base-100 text-base-content hover:bg-base-200 transition"
                >

                    <!-- Sun -->

                    <svg
                        id="sun-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 hidden"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <circle
                            cx="12"
                            cy="12"
                            r="4"
                        ></circle>

                        <path
                            stroke-linecap="round"
                            d="M12 2v2
                               M12 20v2
                               M4.93 4.93l1.41 1.41
                               M17.66 17.66l1.41 1.41
                               M2 12h2
                               M20 12h2
                               M4.93 19.07l1.41-1.41
                               M17.66 6.34l1.41-1.41"
                        />
                    </svg>


                    <!-- Moon -->

                    <svg
                        id="moon-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M21 12.79A9 9 0 1 1 11.21 3
                               7 7 0 0 0 21 12.79z"
                        />
                    </svg>

                </button>


                <!-- =================================================
                     MOBILE MENU BUTTON
                     ================================================= -->

                <button
                    id="mobile-menu-toggle"
                    class="xl:hidden flex items-center justify-center w-10 h-10 rounded-full border border-base-300 bg-base-100 text-base-content hover:bg-base-200 transition"
                    aria-label="Open menu"
                    type="button"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 6h16M4 12h16M4 18h16"
                        />
                    </svg>

                </button>

            </div>

        </div>


        <!-- =========================================================
             MOBILE MENU
             ========================================================= -->

        <div
            id="mobile-menu"
            class="hidden xl:hidden pb-5"
        >
            <nav
                class="mt-2 flex flex-col gap-1 p-2 rounded-2xl bg-base-100 border border-base-300 shadow-lg"
            >

                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class={`
                                px-4
                                py-3
                                rounded-xl
                                text-sm
                                font-medium
                                transition

                                ${
                                    isActive(link.href)
                                        ? "bg-primary/10 text-primary"
                                        : "text-base-content/70 hover:bg-base-200 hover:text-base-content"
                                }
                            `}
                        >
                            {link.label}
                        </a>
                    ))
                }

            </nav>
        </div>

    </div>
</header>


<script is:inline>
    /* =========================================================
       THEME SWITCH
       ========================================================= */

    const root = document.documentElement;

    const themeToggle =
        document.getElementById("theme-toggle");

    const sunIcon =
        document.getElementById("sun-icon");

    const moonIcon =
        document.getElementById("moon-icon");


    function updateThemeIcon() {

        const isDark =
            root.getAttribute("data-theme") ===
            "marc-dark";

        sunIcon?.classList.toggle(
            "hidden",
            !isDark
        );

        moonIcon?.classList.toggle(
            "hidden",
            isDark
        );

        themeToggle?.setAttribute(
            "aria-label",
            isDark
                ? "Switch to light mode"
                : "Switch to dark mode"
        );
    }


    updateThemeIcon();


    themeToggle?.addEventListener(
        "click",
        () => {

            const current =
                root.getAttribute("data-theme");

            const next =
                current === "marc-dark"
                    ? "marc"
                    : "marc-dark";

            root.setAttribute(
                "data-theme",
                next
            );

            try {
                localStorage.setItem(
                    "marc-theme",
                    next
                );
            } catch (_) {}

            updateThemeIcon();
        }
    );


    /* =========================================================
       MOBILE MENU
       ========================================================= */

    const menuButton =
        document.getElementById(
            "mobile-menu-toggle"
        );

    const mobileMenu =
        document.getElementById(
            "mobile-menu"
        );


    menuButton?.addEventListener(
        "click",
        () => {

            mobileMenu?.classList.toggle(
                "hidden"
            );

        }
    );
</script>