---
import logo from "../assets/MARC_Logo.png";
import { Image } from "astro:assets";

const links = [
    { href: "/#about", label: "About" },
    { href: "/Research", label: "Research" },
    { href: "/publications", label: "Publications" },
    { href: "/people", label: "People" },
    { href: "/contact", label: "Contact" },
];

const path =
    Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
    if (href === "/") return path === "/";

    return (
        path === href ||
        path.startsWith(href + "/")
    );
};
---

<header class="relative sticky top-3 z-50 mx-3 sm:mx-4">
    <div
        class="relative z-20 container mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-8"
    >

        <div
            class="flex items-center justify-between min-h-20 lg:min-h-24 gap-4"
        >

          <!-- =====================================================
     MARC BRAND — LEFT SIDE
     ===================================================== -->

<a
    href="/"
    class="relative z-20 flex items-center gap-2 shrink-0"
    aria-label="MARC Home"
>
    <Image
        src={logo}
        alt="MARC logo"
        class="h-14 sm:h-16 lg:h-[72px] w-auto object-contain"
    />

    <div class="flex flex-col justify-center leading-tight">
        <div class="text-[12px] sm:text-[13px] lg:text-[14px] font-semibold tracking-tight text-base-content font-['Barlow_Condensed']">
            MULTIDISCIPLINARY AI RESEARCH CENTRE
        </div>

        <div class="mt-1 text-[8px] sm:text-[9px] lg:text-[11px] font-medium text-base-content/65 font-['Barlow_Condensed']">
            UNIVERSITY OF PERADENIYA
        </div>
    </div>
</a>

            <!-- =====================================================
                 DESKTOP NAVIGATION
                 ===================================================== -->

            <nav
                class="relative z-20 hidden lg:flex items-center gap-2 shrink-0"
            >
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class={`
                                relative
                                isolate
                                px-4
                                py-2.5
                                min-h-11
                                rounded-full
                                text-sm
                                font-semibold
                                transition-all
                                duration-300
                                overflow-hidden
                                border
                                border-[#D8DFEC]
                                bg-gradient-to-b from-white/95 via-[#EDF2FA]/95 to-[#F7EDEF]/90
                                dark:border-white/15
                                dark:from-[#25232B]/95 dark:via-[#1B2940]/95 dark:to-[#35232B]/95
                                backdrop-blur-xl
                                shadow-[inset_0_1px_2px_rgba(255,255,255,0.95),inset_0_-2px_8px_rgba(99,102,241,0.10),0_5px_16px_rgba(0,74,173,0.12)]
                                hover:-translate-y-0.5
                                hover:shadow-[inset_0_1px_2px_rgba(255,255,255,1),inset_0_-2px_12px_rgba(99,102,241,0.12),0_8px_22px_rgba(59,130,246,0.14)]
                                ${
                                     isActive(link.href)
                                        ? "!text-[#172A46] dark:!text-[#FFFFFF] ring-1 ring-[#5170FF]/55"
                                        : "!text-[#34445D] dark:!text-[#F2F4FA]"
                                }
                            `}
                        >
                            <span class="pointer-events-none absolute inset-0 rounded-full bg-gradient-to-r from-white/75 via-transparent to-white/55 opacity-90 dark:from-white/10 dark:to-white/5"></span>
                            <span class="relative z-10">{link.label}</span>

                            {
                                isActive(link.href) && (
                                    <span class="absolute inset-x-4 bottom-1 h-0.5 rounded-full bg-gradient-to-r from-[#004AAD] via-[#5170FF] to-[#7C0E24] opacity-80"></span>
                                )
                            }
                        </a>
                    ))
                }
            </nav>


            <!-- =====================================================
                 RIGHT SIDE
                 ===================================================== -->

            <div class="flex items-center gap-2 shrink-0">

                <!-- AI Research indicator -->

                <div
                    class="hidden xl:flex items-center gap-2 px-3 py-2 rounded-full bg-white/35 backdrop-blur-md border border-white/60 shadow-sm"
                >
                    <span
                        class="w-2 h-2 rounded-full bg-gradient-to-r from-[#004AAD] to-[#7C0E24] animate-pulse"
                    ></span>

                    <span
                        class="text-sm font-semibold text-[#34445D] dark:text-[#F2F4FA]"
                    >
                        AI Research
                    </span>
                </div>


                <!-- =================================================
                     DARK MODE BUTTON
                     ================================================= -->

                <button
                    id="theme-toggle"
                    type="button"
                    aria-label="Switch to dark mode"
                    class="flex items-center justify-center w-10 h-10 rounded-full border border-white/60 bg-white/35 backdrop-blur-md text-base-content hover:bg-white/60 transition"
                >

                    <!-- Sun -->

                    <svg
                        id="sun-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 hidden"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <circle
                            cx="12"
                            cy="12"
                            r="4"
                        ></circle>

                        <path
                            stroke-linecap="round"
                            d="M12 2v2
                               M12 20v2
                               M4.93 4.93l1.41 1.41
                               M17.66 17.66l1.41 1.41
                               M2 12h2
                               M20 12h2
                               M4.93 19.07l1.41-1.41
                               M17.66 6.34l1.41-1.41"
                        />
                    </svg>


                    <!-- Moon -->

                    <svg
                        id="moon-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M21 12.79A9 9 0 1 1 11.21 3
                               7 7 0 0 0 21 12.79z"
                        />
                    </svg>

                </button>


                <!-- =================================================
                     MOBILE MENU BUTTON
                     ================================================= -->

                <button
                    id="mobile-menu-toggle"
                    class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full border border-white/60 bg-white/35 backdrop-blur-md text-base-content hover:bg-white/60 transition"
                    aria-label="Open menu"
                    type="button"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 6h16M4 12h16M4 18h16"
                        />
                    </svg>

                </button>

            </div>

        </div>


        <!-- =========================================================
             MOBILE MENU
             ========================================================= -->

        <div
            id="mobile-menu"
            class="hidden lg:hidden pb-5"
        >
            <nav
                class="mt-2 flex flex-col gap-1 p-2 rounded-2xl bg-white/60 backdrop-blur-xl border border-white/60 shadow-lg"
            >

                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class={`
                                px-4
                                py-3
                                rounded-xl
                                text-sm
                                font-medium
                                transition

                                ${
                                    isActive(link.href)
                                        ? "bg-white/55 text-primary border border-white/60"
                                        : "text-base-content/70 hover:bg-white/40 hover:text-base-content"
                                }
                            `}
                        >
                            {link.label}
                        </a>
                    ))
                }

            </nav>
        </div>

    </div>
</header>


<script is:inline>
    /* =========================================================
       THEME SWITCH
       ========================================================= */

    const root = document.documentElement;

    const themeToggle =
        document.getElementById("theme-toggle");

    const sunIcon =
        document.getElementById("sun-icon");

    const moonIcon =
        document.getElementById("moon-icon");


    function updateThemeIcon() {

        const isDark =
            root.getAttribute("data-theme") ===
            "marc-dark";

        sunIcon?.classList.toggle(
            "hidden",
            !isDark
        );

        moonIcon?.classList.toggle(
            "hidden",
            isDark
        );

        themeToggle?.setAttribute(
            "aria-label",
            isDark
                ? "Switch to light mode"
                : "Switch to dark mode"
        );
    }


    updateThemeIcon();


    themeToggle?.addEventListener(
        "click",
        () => {

            const current =
                root.getAttribute("data-theme");

            const next =
                current === "marc-dark"
                    ? "marc"
                    : "marc-dark";

            root.setAttribute(
                "data-theme",
                next
            );

            try {
                localStorage.setItem(
                    "marc-theme",
                    next
                );
            } catch (_) {}

            updateThemeIcon();
        }
    );


    /* =========================================================
       MOBILE MENU
       ========================================================= */

    const menuButton =
        document.getElementById(
            "mobile-menu-toggle"
        );

    const mobileMenu =
        document.getElementById(
            "mobile-menu"
        );


    menuButton?.addEventListener(
        "click",
        () => {

            mobileMenu?.classList.toggle(
                "hidden"
            );

        }
    );
</script>