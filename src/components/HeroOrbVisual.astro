---
/**
 * HeroOrbVisual
 * Abstract orbital/scientific visual for the hero's right-hand side —
 * a glassy central orb, elliptical orbit rings and small satellite
 * spheres riding them. Pure CSS, no canvas/WebGL/JS. Scoped to the
 * hero only.
 */
---

<div class="orb-visual" aria-hidden="true">
    <div class="orbit o1"></div>
    <div class="orbit o2"></div>
    <div class="orbit o3"></div>
    <div class="orb"></div>
    <span class="sat s1"></span>
    <span class="sat s2"></span>
    <span class="sat s3"></span>
    <span class="sat s4"></span>
    <span class="sat s5"></span>
</div>

<style>
    .orb-visual {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 420px;
        display: grid;
        place-items: center;
    }

    .orbit {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(120, 140, 235, 0.28);
        animation: orb-spin 38s linear infinite;
    }

    .orbit.o1 {
        width: 620px;
        height: 300px;
        transform: rotate(-24deg);
    }

    .orbit.o2 {
        width: 720px;
        height: 360px;
        border-style: dashed;
        border-color: rgba(120, 140, 235, 0.22);
        transform: rotate(-14deg);
        animation-duration: 52s;
        animation-direction: reverse;
    }

    .orbit.o3 {
        width: 500px;
        height: 460px;
        transform: rotate(16deg);
        border-color: rgba(160, 140, 235, 0.2);
        animation-duration: 44s;
    }

    @keyframes orb-spin {
        to {
            transform: rotate(336deg);
        }
    }

    .orb {
        position: relative;
        width: min(420px, 70%);
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 42%),
            radial-gradient(circle at 76% 78%, rgba(248, 160, 195, 0.9) 0%, rgba(248, 160, 195, 0) 55%),
            radial-gradient(circle at 20% 80%, rgba(140, 180, 255, 0.8) 0%, rgba(140, 180, 255, 0) 50%),
            linear-gradient(145deg, #9db9ff 0%, #6f7ff2 38%, #8a6ef0 62%, #eaa1c4 100%);
        box-shadow:
            0 50px 90px -40px rgba(80, 90, 220, 0.55),
            inset -24px -30px 60px rgba(90, 80, 200, 0.25),
            inset 18px 22px 50px rgba(255, 255, 255, 0.45);
        animation: orb-bob 9s ease-in-out infinite;
    }

    @keyframes orb-bob {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-16px);
        }
    }

    /* dotted shading on the orb */
    .orb::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background-image: radial-gradient(rgba(255, 255, 255, 0.65) 1px, transparent 1.3px);
        background-size: 8px 8px;
        mix-blend-mode: overlay;
        -webkit-mask-image: radial-gradient(circle at 72% 60%, #000 0%, transparent 72%);
        mask-image: radial-gradient(circle at 72% 60%, #000 0%, transparent 72%);
        opacity: 0.7;
    }

    /* specular highlight */
    .orb::before {
        content: "";
        position: absolute;
        top: 12%;
        left: 16%;
        width: 34%;
        height: 26%;
        border-radius: 50%;
        background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 70%);
        filter: blur(6px);
    }

    /* satellites riding the orbits */
    .sat {
        position: absolute;
        border-radius: 50%;
        background: radial-gradient(circle at 32% 28%, #fff, #7f93f6 70%, #6a6ef0);
        box-shadow: 0 8px 18px -8px rgba(70, 90, 220, 0.9);
    }

    .s1 {
        width: 16px;
        height: 16px;
        left: 6%;
        top: 62%;
    }

    .s2 {
        width: 10px;
        height: 10px;
        left: 14%;
        top: 72%;
        opacity: 0.8;
    }

    .s3 {
        width: 58px;
        height: 58px;
        left: 12%;
        top: 46%;
        background: radial-gradient(circle at 30% 26%, #fff 0%, #e4d9ff 38%, #b8a6f2 72%, #f3b6cd 100%);
        filter: blur(0.5px);
        box-shadow: inset -8px -10px 20px rgba(120, 110, 200, 0.25);
    }

    .s4 {
        width: 70px;
        height: 70px;
        right: 4%;
        top: 14%;
        background: radial-gradient(circle at 30% 26%, #fff 0%, #dde6ff 40%, #9fb3f7 100%);
        box-shadow: inset -8px -10px 20px rgba(110, 120, 200, 0.2);
    }

    .s5 {
        width: 8px;
        height: 8px;
        right: 22%;
        bottom: 22%;
        opacity: 0.7;
    }

    @media (max-width: 1040px) {
        .orb-visual {
            min-height: 340px;
        }

        .orbit.o1 {
            width: 440px;
            height: 220px;
        }

        .orbit.o2 {
            width: 520px;
            height: 260px;
        }

        .orbit.o3 {
            width: 380px;
            height: 340px;
        }
    }

    @media (max-width: 640px) {
        .orb-visual {
            min-height: 260px;
            transform: scale(0.82);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .orbit,
        .orb {
            animation: none;
        }
    }
</style>
