---
/**
 * HeroOrbVisual
 * Abstract orbital/scientific visual for the hero's right-hand side —
 * a glassy central orb, elliptical orbit rings and small satellite
 * spheres riding them. Pure CSS, no canvas/WebGL/JS. Scoped to the
 * hero only.
 */
---

<div class="orb-visual" aria-hidden="true">
    <!-- Back half of the orbit rings (upper arcs, passing behind the orb) -->
    <div class="orbits orbits-back">
        <div class="orbit o1"></div>
        <div class="orbit o2"></div>
        <div class="orbit o3"></div>
    </div>
    <div class="orb"></div>
    <!-- Front half of the same rings (lower arcs, passing in front of the orb) -->
    <div class="orbits orbits-front">
        <div class="orbits-front-half">
            <div class="orbit o1"></div>
            <div class="orbit o2"></div>
            <div class="orbit o3"></div>
        </div>
    </div>
    <span class="sat s1"></span>
    <span class="sat s2"></span>
    <span class="sat s3"></span>
    <span class="sat s4"></span>
    <span class="sat s5"></span>
    <span class="sat s6"></span>
    <span class="sat s7"></span>
    <span class="sat s8"></span>
    <span class="sat s9"></span>
    <span class="sat glass g1"></span>
    <span class="sat glass g2"></span>
    <span class="sat glass g3"></span>
</div>

<style>
    .orb-visual {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 420px;
        display: grid;
        place-items: center;
    }

    /* Each ring is drawn twice. The back copy sits under the orb as
       before. The front copy sits over the orb, masked to the orb's
       circle AND its lower half, so the lower arcs cross in front of the
       sphere while the upper arcs stay hidden behind it — the rings read
       as wrapping around it. Masks live on non-rotating wrappers, so the
       split stays horizontal while the rings spin. */
    .orbits {
        position: absolute;
        display: grid;
        place-items: center;
        pointer-events: none;
    }

    .orbits-back {
        inset: 0;
        z-index: 0;
    }

    .orbits-front {
        z-index: 2;
        /* same box as the orb, centred the same way */
        width: min(420px, 70%);
        aspect-ratio: 1;
        /* clip to the orb's circle (soft at the rim) */
        -webkit-mask-image: radial-gradient(circle closest-side, #000 86%, transparent 100%);
        mask-image: radial-gradient(circle closest-side, #000 86%, transparent 100%);
    }

    /* nested wrapper keeps only the lower half — two single masks instead
       of mask-composite, so it works in every browser */
    .orbits-front-half {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        -webkit-mask-image: linear-gradient(to bottom, transparent 42%, #000 58%);
        mask-image: linear-gradient(to bottom, transparent 42%, #000 58%);
    }

    .orbits-front-half .orbit {
        /* a touch stronger so the arc stays visible over the orb */
        border-color: rgba(255, 255, 255, 0.8);
    }

    .orbits-front-half .orbit.o2 {
        border-color: rgba(255, 255, 255, 0.65);
    }

    .orb-visual > .orb {
        z-index: 1;
    }

    .orb-visual > .sat {
        z-index: 3;
    }

    .orbit {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(120, 140, 235, 0.28);
        animation: orb-spin 38s linear infinite;
    }

    .orbit.o1 {
        width: 620px;
        height: 300px;
        transform: rotate(-24deg);
    }

    .orbit.o2 {
        width: 720px;
        height: 360px;
        border-style: dashed;
        border-color: rgba(120, 140, 235, 0.22);
        transform: rotate(-14deg);
        animation-duration: 52s;
        animation-direction: reverse;
    }

    .orbit.o3 {
        width: 500px;
        height: 460px;
        transform: rotate(16deg);
        border-color: rgba(160, 140, 235, 0.2);
        animation-duration: 44s;
    }

    @keyframes orb-spin {
        to {
            transform: rotate(336deg);
        }
    }

    .orb {
        position: relative;
        width: min(420px, 70%);
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            /* sharp specular point + soft light bounce on the underside */
            radial-gradient(circle at 27% 20%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 9%),
            radial-gradient(ellipse 70% 30% at 55% 96%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 70%),
            radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 42%),
            radial-gradient(circle at 76% 78%, rgba(238, 120, 135, 0.55) 0%, rgba(238, 120, 135, 0) 50%),
            radial-gradient(circle at 20% 80%, rgba(140, 180, 255, 0.8) 0%, rgba(140, 180, 255, 0) 50%),
            linear-gradient(145deg, #9fc0ff 0%, #6a8af5 40%, #7a84f0 68%, #e69aa8 100%);
        box-shadow:
            0 0 70px rgba(110, 140, 255, 0.35),
            0 50px 90px -40px rgba(80, 90, 220, 0.55),
            inset 0 0 0 1.5px rgba(255, 255, 255, 0.45),
            inset 0 -14px 30px rgba(255, 255, 255, 0.3),
            inset -24px -30px 60px rgba(90, 80, 200, 0.25),
            inset 18px 22px 50px rgba(255, 255, 255, 0.45);
        animation: orb-bob 9s ease-in-out infinite;
    }

    @keyframes orb-bob {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-16px);
        }
    }

    /* dotted shading on the orb */
    .orb::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        /* halftone: a bold dot grid plus a finer offset grid between it */
        background-image:
            radial-gradient(rgba(255, 255, 255, 0.9) 1.6px, transparent 2px),
            radial-gradient(rgba(255, 255, 255, 0.6) 0.9px, transparent 1.2px);
        background-size: 9px 9px, 9px 9px;
        background-position: 0 0, 4.5px 4.5px;
        mix-blend-mode: overlay;
        -webkit-mask-image: radial-gradient(circle at 70% 62%, #000 0%, #000 22%, transparent 80%);
        mask-image: radial-gradient(circle at 70% 62%, #000 0%, #000 22%, transparent 80%);
        opacity: 0.9;
    }

    /* specular highlight */
    .orb::before {
        content: "";
        position: absolute;
        top: 12%;
        left: 16%;
        width: 34%;
        height: 26%;
        border-radius: 50%;
        background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 70%);
        filter: blur(6px);
    }

    /* satellites riding the orbits */
    .sat {
        position: absolute;
        border-radius: 50%;
        background: radial-gradient(circle at 32% 28%, #fff, #7f93f6 70%, #6a6ef0);
        box-shadow: 0 8px 18px -8px rgba(70, 90, 220, 0.9);
    }

    .s1 {
        width: 16px;
        height: 16px;
        left: 6%;
        top: 62%;
    }

    .s2 {
        width: 10px;
        height: 10px;
        left: 14%;
        top: 72%;
        opacity: 0.8;
    }

    .s3 {
        width: 58px;
        height: 58px;
        left: 12%;
        top: 46%;
        background: radial-gradient(circle at 30% 26%, #fff 0%, #dfe6ff 38%, #a9b8f4 72%, #e6c2dc 100%);
        filter: blur(0.5px);
        box-shadow: inset -8px -10px 20px rgba(120, 110, 200, 0.25);
    }

    .s4 {
        width: 70px;
        height: 70px;
        right: 4%;
        top: 14%;
        background: radial-gradient(circle at 30% 26%, #fff 0%, #dde6ff 40%, #9fb3f7 100%);
        box-shadow: inset -8px -10px 20px rgba(110, 120, 200, 0.2);
    }

    .s5 {
        width: 8px;
        height: 8px;
        right: 22%;
        bottom: 22%;
        opacity: 0.7;
    }

    .s6 {
        width: 30px;
        height: 30px;
        right: -2%;
        top: 58%;
        background: radial-gradient(circle at 30% 26%, #fff 0%, #ffd6da 40%, #ec8f9c 100%);
        box-shadow: inset -6px -8px 16px rgba(200, 110, 150, 0.2);
    }

    .s7 {
        width: 20px;
        height: 20px;
        left: 32%;
        top: -4%;
        opacity: 0.85;
    }

    .s8 {
        width: 44px;
        height: 44px;
        left: 76%;
        top: 96%;
        background: radial-gradient(circle at 30% 26%, #fff 0%, #dde6ff 40%, #a9b4f6 100%);
        filter: blur(0.5px);
        box-shadow: inset -6px -8px 16px rgba(110, 120, 200, 0.2);
    }

    .s9 {
        width: 13px;
        height: 13px;
        right: 16%;
        top: 86%;
        opacity: 0.75;
    }

    /* larger glass spheres — translucent body, specular highlight,
       rim light and a soft coloured outer glow */
    .glass {
        background:
            radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 38%),
            radial-gradient(circle at 72% 78%, rgba(238, 125, 140, 0.32) 0%, rgba(238, 125, 140, 0) 50%),
            radial-gradient(circle at 50% 50%, rgba(170, 185, 255, 0.35) 0%, rgba(120, 130, 240, 0.55) 100%);
        border: 1px solid rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        box-shadow:
            0 0 40px 6px rgba(130, 140, 255, 0.35),
            0 18px 40px -18px rgba(80, 90, 220, 0.6),
            inset -10px -14px 26px rgba(90, 80, 200, 0.28),
            inset 8px 10px 22px rgba(255, 255, 255, 0.6);
        animation: orb-bob 11s ease-in-out infinite;
    }

    .glass::after {
        content: "";
        position: absolute;
        top: 10%;
        left: 18%;
        width: 32%;
        height: 22%;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 70%);
        filter: blur(3px);
    }

    .g1 {
        width: 120px;
        height: 120px;
        left: -12%;
        bottom: -20%;
        animation-delay: -3s;
    }

    .g2 {
        width: 96px;
        height: 96px;
        right: -6%;
        bottom: -4%;
        animation-delay: -6s;
    }

    .g3 {
        width: 84px;
        height: 84px;
        left: 4%;
        top: -20%;
        animation-delay: -8s;
    }

    @media (max-width: 1040px) {
        .orb-visual {
            min-height: 340px;
        }

        .orbit.o1 {
            width: 440px;
            height: 220px;
        }

        .orbit.o2 {
            width: 520px;
            height: 260px;
        }

        .orbit.o3 {
            width: 380px;
            height: 340px;
        }
    }

    @media (max-width: 640px) {
        .orb-visual {
            min-height: 260px;
            transform: scale(0.82);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .orbit,
        .orb,
        .glass {
            animation: none;
        }
    }
</style>
