---
/**
 * HeroOrb
 * A 3D centrepiece inspired by the "OPTIMIND" reference: an irregular
 * faceted wireframe shell with a couple of open rifts, a bright glowing
 * core showing through the gaps, scattered sparks across the lattice, and
 * two faint orbit rings behind it. Built with Three.js, in the MARC brand
 * colours (deep blue lattice, electric cyan core, a touch of signal red).
 *
 * Transparent background, so it sits over the existing hero section.
 */
---

<div class="hero-orb" aria-hidden="true">
    <canvas id="marc-orb"></canvas>
</div>

<style>
    .hero-orb {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
        overflow: hidden;
    }

    #marc-orb {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>

<script>
    import * as THREE from "three";

    const canvas = document.querySelector<HTMLCanvasElement>("#marc-orb");

    if (canvas) {
      try {
        console.log("[HeroOrb] mounting…");
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        // ---------------------------------------------------------
        // MARC brand palette
        // ---------------------------------------------------------
        const DEEP_BLUE = 0x073bce;
        const ACCENT_BLUE = 0x5170ff;
        const ELECTRIC_CYAN = 0x00cff5;
        const SIGNAL_RED = 0xf51d2a;
        const SLATE = 0x64748b;

        // ---------------------------------------------------------
        // Scene / camera / renderer
        // ---------------------------------------------------------
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
        camera.position.set(0, 0.1, 6.4);

        const renderer = new THREE.WebGLRenderer({
            canvas,
            alpha: true,
            antialias: true,
            powerPreference: "low-power",
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.2;

        const orb = new THREE.Group();
        scene.add(orb);

        // ---------------------------------------------------------
        // Faceted shell: an icosahedron, nudged into an irregular
        // "crystal" shape, with a couple of triangle clusters removed so
        // the glowing core shows through the gaps.
        // ---------------------------------------------------------
        function hash(n: number) {
            const s = Math.sin(n * 127.1) * 43758.5453;
            return s - Math.floor(s);
        }

        function buildShell(radius: number, detail: number) {
            const base = new THREE.IcosahedronGeometry(radius, detail);
            const pos = base.attributes.position;
            const v = new THREE.Vector3();

            for (let i = 0; i < pos.count; i++) {
                v.fromBufferAttribute(pos, i);
                const n = v.clone().normalize();
                const bump =
                    (hash(i * 3.1 + 1) - 0.5) * 0.16 +
                    (hash(i * 7.7 + 5) - 0.5) * 0.07;
                v.addScaledVector(n, bump);
                pos.setXYZ(i, v.x, v.y, v.z);
            }
            pos.needsUpdate = true;

            // Two rift directions: triangles whose centroid falls inside
            // either cone are dropped, opening a window onto the core.
            const rifts = [
                new THREE.Vector3(0.38, 0.22, 0.9).normalize(),
                new THREE.Vector3(-0.55, -0.35, 0.74).normalize(),
            ];
            const riftCos = Math.cos(0.62); // ~35.5° half-angle

            const index = base.index!;
            const kept: number[] = [];
            const a = new THREE.Vector3();
            const b = new THREE.Vector3();
            const cc = new THREE.Vector3();
            const centroid = new THREE.Vector3();

            for (let f = 0; f < index.count; f += 3) {
                const ia = index.getX(f);
                const ib = index.getX(f + 1);
                const ic = index.getX(f + 2);
                a.fromBufferAttribute(pos, ia);
                b.fromBufferAttribute(pos, ib);
                cc.fromBufferAttribute(pos, ic);
                centroid.copy(a).add(b).add(cc).multiplyScalar(1 / 3).normalize();

                const inRift = rifts.some((r) => centroid.dot(r) > riftCos);
                if (!inRift) kept.push(ia, ib, ic);
            }

            const shellGeo = new THREE.BufferGeometry();
            shellGeo.setAttribute("position", pos);
            shellGeo.setIndex(kept);

            const edges = new THREE.EdgesGeometry(shellGeo, 1);
            base.dispose();
            shellGeo.dispose();
            return edges;
        }

        const outerEdges = buildShell(1.18, 3);
        const outerLines = new THREE.LineSegments(
            outerEdges,
            new THREE.LineBasicMaterial({
                color: ACCENT_BLUE,
                transparent: true,
                opacity: 0.8,
            }),
        );
        orb.add(outerLines);

        const innerEdges = buildShell(1.05, 2);
        const innerLines = new THREE.LineSegments(
            innerEdges,
            new THREE.LineBasicMaterial({
                color: ELECTRIC_CYAN,
                transparent: true,
                opacity: 0.22,
            }),
        );
        orb.add(innerLines);

        // ---------------------------------------------------------
        // Glowing core: a bright sphere, a hot white centre, and a soft
        // additive-blended glow sprite (painted on a canvas texture).
        // ---------------------------------------------------------
        function glowTexture() {
            const size = 256;
            const c = document.createElement("canvas");
            c.width = c.height = size;
            const g = c.getContext("2d")!;
            const grad = g.createRadialGradient(
                size / 2, size / 2, 0,
                size / 2, size / 2, size / 2,
            );
            grad.addColorStop(0, "rgba(255,255,255,1)");
            grad.addColorStop(0.22, "rgba(180,235,255,0.95)");
            grad.addColorStop(0.5, "rgba(0,207,245,0.38)");
            grad.addColorStop(1, "rgba(0,207,245,0)");
            g.fillStyle = grad;
            g.fillRect(0, 0, size, size);
            const tex = new THREE.CanvasTexture(c);
            tex.colorSpace = THREE.SRGBColorSpace;
            return tex;
        }

        const glowSprite = new THREE.Sprite(
            new THREE.SpriteMaterial({
                map: glowTexture(),
                blending: THREE.AdditiveBlending,
                depthWrite: false,
                transparent: true,
            }),
        );
        glowSprite.scale.setScalar(3.2);
        orb.add(glowSprite);

        const core = new THREE.Mesh(
            new THREE.SphereGeometry(0.42, 24, 16),
            new THREE.MeshBasicMaterial({ color: ELECTRIC_CYAN }),
        );
        orb.add(core);

        const coreHot = new THREE.Mesh(
            new THREE.SphereGeometry(0.21, 20, 14),
            new THREE.MeshBasicMaterial({ color: 0xeaf7ff }),
        );
        orb.add(coreHot);

        // ---------------------------------------------------------
        // Sparks: small bright points scattered over the shell, denser
        // near the two rifts.
        // ---------------------------------------------------------
        const SPARKS = 260;
        const sparkPositions = new Float32Array(SPARKS * 3);
        const sparkColors = new Float32Array(SPARKS * 3);
        const colorPool = [DEEP_BLUE, ELECTRIC_CYAN, ACCENT_BLUE, SIGNAL_RED];
        const colorWeights = [0.38, 0.4, 0.17, 0.05];
        const tmpColor = new THREE.Color();

        function weightedColor() {
            let r = Math.random();
            for (let i = 0; i < colorPool.length; i++) {
                if (r < colorWeights[i]) return colorPool[i];
                r -= colorWeights[i];
            }
            return DEEP_BLUE;
        }

        for (let i = 0; i < SPARKS; i++) {
            const u = Math.random() * 2 - 1;
            const theta = Math.random() * Math.PI * 2;
            const s = Math.sqrt(1 - u * u);
            const r = 1.0 + Math.random() * 0.32;
            sparkPositions[i * 3] = Math.cos(theta) * s * r;
            sparkPositions[i * 3 + 1] = u * r;
            sparkPositions[i * 3 + 2] = Math.sin(theta) * s * r;

            tmpColor.set(weightedColor());
            sparkColors[i * 3] = tmpColor.r;
            sparkColors[i * 3 + 1] = tmpColor.g;
            sparkColors[i * 3 + 2] = tmpColor.b;
        }

        const sparkGeo = new THREE.BufferGeometry();
        sparkGeo.setAttribute(
            "position",
            new THREE.BufferAttribute(sparkPositions, 3),
        );
        sparkGeo.setAttribute(
            "color",
            new THREE.BufferAttribute(sparkColors, 3),
        );
        const sparks = new THREE.Points(
            sparkGeo,
            new THREE.PointsMaterial({
                size: 0.028,
                vertexColors: true,
                transparent: true,
                opacity: 0.9,
                sizeAttenuation: true,
                blending: THREE.AdditiveBlending,
                depthWrite: false,
            }),
        );
        orb.add(sparks);

        // ---------------------------------------------------------
        // Two faint orbit rings behind the shape.
        // ---------------------------------------------------------
        const ringMaterial = new THREE.LineBasicMaterial({
            color: SLATE,
            transparent: true,
            opacity: 0.16,
        });

        function makeRing(radius: number, tiltX: number, tiltZ: number) {
            const curve = new THREE.EllipseCurve(0, 0, radius, radius);
            const pts = curve.getPoints(96);
            const geo = new THREE.BufferGeometry().setFromPoints(
                pts.map((p) => new THREE.Vector3(p.x, p.y, 0)),
            );
            const ring = new THREE.LineLoop(geo, ringMaterial);
            ring.rotation.x = tiltX;
            ring.rotation.z = tiltZ;
            return ring;
        }

        const ringA = makeRing(2.05, Math.PI / 2 + 0.18, 0.1);
        const ringB = makeRing(2.35, Math.PI / 2 - 0.22, -0.16);
        scene.add(ringA, ringB);

        // Soft ambient + a single faint key light (materials are mostly
        // self-lit, but this keeps edges from looking completely flat).
        scene.add(new THREE.AmbientLight(0xffffff, 0.6));

        // ---------------------------------------------------------
        // Sizing
        // ---------------------------------------------------------
        function resize() {
            const rect = canvas!.getBoundingClientRect();
            const width = Math.max(1, rect.width);
            const height = Math.max(1, rect.height);
            renderer.setSize(width, height, false);
            camera.aspect = width / height;
            camera.position.z = width < 640 ? 8.4 : width < 980 ? 7.3 : 6.4;
            camera.updateProjectionMatrix();
        }
        resize();
        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(canvas);

        // ---------------------------------------------------------
        // Animate (pause off screen / hidden tab / reduced motion)
        // ---------------------------------------------------------
        const clock = new THREE.Clock();
        let raf = 0;
        let running = false;
        let visible = true;

        function renderFrame() {
            const t = clock.getElapsedTime();

            orb.rotation.y = t * 0.16;
            orb.rotation.x = 0.06 + Math.sin(t * 0.22) * 0.05;
            ringA.rotation.z += 0.0009;
            ringB.rotation.z -= 0.0007;

            const pulse = 1 + Math.sin(t * 1.3) * 0.05;
            core.scale.setScalar(pulse);
            coreHot.scale.setScalar(1 + Math.sin(t * 1.3 + 0.6) * 0.08);
            glowSprite.scale.setScalar(3.2 * (1 + Math.sin(t * 1.1) * 0.06));

            sparks.rotation.y = t * 0.05;

            renderer.render(scene, camera);
        }

        function loop() {
            renderFrame();
            raf = requestAnimationFrame(loop);
        }

        function start() {
            if (running || reducedMotion) return;
            running = true;
            raf = requestAnimationFrame(loop);
        }

        function stop() {
            running = false;
            cancelAnimationFrame(raf);
        }

        function sync() {
            if (visible && !document.hidden) start();
            else stop();
        }

        renderFrame();
        console.log("[HeroOrb] first frame rendered", {
            width: canvas.clientWidth,
            height: canvas.clientHeight,
        });

        new IntersectionObserver((entries) => {
            visible = entries[0]?.isIntersecting ?? true;
            sync();
        }).observe(canvas);

        document.addEventListener("visibilitychange", sync);

        sync();
      } catch (err) {
        // Something in the 3D setup threw. Log it (check the browser
        // console) and fall back to a plain glowing circle so the hero
        // isn't left blank.
        console.error("[HeroOrb] failed to mount:", err);
        const ctx2d = canvas.getContext("2d");
        if (ctx2d) {
            const w = canvas.clientWidth || 400;
            const h = canvas.clientHeight || 400;
            canvas.width = w;
            canvas.height = h;
            const cx = w / 2;
            const cy = h / 2;
            const r = Math.min(w, h) * 0.18;
            const grad = ctx2d.createRadialGradient(cx, cy, 0, cx, cy, r * 2.2);
            grad.addColorStop(0, "rgba(0,207,245,0.9)");
            grad.addColorStop(1, "rgba(0,207,245,0)");
            ctx2d.fillStyle = grad;
            ctx2d.beginPath();
            ctx2d.arc(cx, cy, r * 2.2, 0, Math.PI * 2);
            ctx2d.fill();
        }
      }
    }
</script>
