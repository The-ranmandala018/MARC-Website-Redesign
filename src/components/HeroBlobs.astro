---
/**
 * HeroBlobs
 * Background colour clouds + dot grid + grain, matching the reference
 * mock exactly: eight soft radial-gradient blobs at varying blur depths
 * (heavy blur = distant cloud, light blur + inset shadow = glass bubble
 * in focus), a faint dot grid lower-left, and a subtle grain overlay so
 * the gradients don't band.
 *
 * Pure CSS — no canvas/WebGL. Scoped to the hero only.
 */
---

<div class="hero-blobs" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
    <span class="blob b4"></span>
    <span class="blob b5"></span>
    <span class="blob b6"></span>
    <span class="blob b7"></span>
    <span class="blob b8"></span>
    <span class="blob b9"></span>
    <span class="blob b10"></span>
    <div class="dots"></div>
    <div class="grain"></div>
</div>

<style>
    .hero-blobs {
        position: absolute;
        inset: 0;
        z-index: 10;
        overflow: hidden;
        pointer-events: none;
    }

    .blob {
        position: absolute;
        border-radius: 50%;
        will-change: transform;
    }

    .b1 {
        /* big blue, top-left bleed */
        width: 620px;
        height: 620px;
        top: -170px;
        left: -160px;
        background: radial-gradient(circle at 34% 30%, #eef2ff 0%, #a9c0fb 28%, #5f82f5 65%, #4860ea 100%);
        filter: blur(12px);
        opacity: 0.9;
        animation: blob-float1 22s ease-in-out infinite;
    }

    .b2 {
        /* violet / pink, top-right */
        width: 720px;
        height: 720px;
        top: -240px;
        right: -220px;
        background: radial-gradient(circle at 38% 32%, #f3edff 0%, #c7adf7 26%, #9c7cef 62%, #e887b8 100%);
        filter: blur(16px);
        opacity: 0.88;
        animation: blob-float2 26s ease-in-out infinite;
    }

    .b3 {
        /* lavender mid-left, big edge coverage */
        width: 460px;
        height: 460px;
        top: 30%;
        left: -140px;
        background: radial-gradient(circle at 40% 35%, #eef0ff 0%, #b6c0f6 35%, #7f93f0 75%, #6a75ea 100%);
        filter: blur(24px);
        opacity: 0.82;
        animation: blob-float3 19s ease-in-out infinite;
    }

    .b4 {
        /* peach / pink bottom-left */
        width: 620px;
        height: 620px;
        bottom: -220px;
        left: -170px;
        background: radial-gradient(circle at 36% 30%, #fff0f6 0%, #f0b3d8 26%, #b98bef 62%, #7c8cf0 100%);
        filter: blur(14px);
        opacity: 0.85;
        animation: blob-float2 24s ease-in-out infinite reverse;
    }

    .b5 {
        /* rose bottom-right */
        width: 720px;
        height: 720px;
        bottom: -280px;
        right: -230px;
        background: radial-gradient(circle at 34% 28%, #fff0f3 0%, #f4a7c6 26%, #cb8fe0 58%, #8894ef 100%);
        filter: blur(16px);
        opacity: 0.84;
        animation: blob-float1 28s ease-in-out infinite;
    }

    .b6 {
        /* small glass bubble, upper mid */
        width: 140px;
        height: 140px;
        top: 14%;
        left: 44%;
        background: radial-gradient(circle at 32% 28%, #ffffff 0%, #e8ecff 40%, #c3cdfb 100%);
        filter: blur(10px);
        opacity: 0.75;
        animation: blob-float3 16s ease-in-out infinite;
    }

    .b7 {
        /* crisp bubble right edge */
        width: 120px;
        height: 120px;
        top: 9%;
        right: 11%;
        background: radial-gradient(circle at 30% 26%, #ffffff 0%, #dbe3ff 35%, #9fb3f7 75%, #c9a8ef 100%);
        filter: blur(1.5px);
        opacity: 0.9;
        box-shadow: inset -10px -14px 26px rgba(120, 120, 200, 0.18);
        animation: blob-float3 14s ease-in-out infinite reverse;
    }

    .b8 {
        /* mid-right pale */
        width: 200px;
        height: 200px;
        top: 56%;
        right: 6%;
        background: radial-gradient(circle at 36% 30%, #ffffff 0%, #eef1ff 45%, #cdd6fa 100%);
        filter: blur(26px);
        opacity: 0.65;
        animation: blob-float1 21s ease-in-out infinite reverse;
    }

    .b9 {
        /* right-mid, fills the right edge */
        width: 420px;
        height: 420px;
        top: 32%;
        right: -140px;
        background: radial-gradient(circle at 36% 30%, #eef2ff 0%, #a9c0fb 32%, #6f7ff2 70%, #4860ea 100%);
        filter: blur(20px);
        opacity: 0.78;
        animation: blob-float3 23s ease-in-out infinite reverse;
    }

    .b10 {
        /* bottom-centre, fills the lower edge */
        width: 500px;
        height: 500px;
        bottom: -220px;
        left: 32%;
        background: radial-gradient(circle at 36% 30%, #fff0f6 0%, #f0b3d8 30%, #ab8cee 66%, #6f7ff2 100%);
        filter: blur(22px);
        opacity: 0.76;
        animation: blob-float2 25s ease-in-out infinite;
    }

    /* faint dot grid, lower-left */
    .dots {
        position: absolute;
        left: 2%;
        bottom: 8%;
        width: 180px;
        height: 220px;
        background-image: radial-gradient(rgba(90, 105, 180, 0.26) 1.1px, transparent 1.2px);
        background-size: 12px 12px;
        -webkit-mask-image: linear-gradient(120deg, #000 10%, transparent 85%);
        mask-image: linear-gradient(120deg, #000 10%, transparent 85%);
        opacity: 0.55;
    }

    /* grain so the gradients never band */
    .grain {
        position: absolute;
        inset: 0;
        opacity: 0.16;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.5'/></svg>");
    }

    @keyframes blob-float1 {
        0%,
        100% {
            transform: translate3d(0, 0, 0) scale(1);
        }
        50% {
            transform: translate3d(26px, -30px, 0) scale(1.05);
        }
    }

    @keyframes blob-float2 {
        0%,
        100% {
            transform: translate3d(0, 0, 0) scale(1);
        }
        50% {
            transform: translate3d(-30px, 24px, 0) scale(1.04);
        }
    }

    @keyframes blob-float3 {
        0%,
        100% {
            transform: translate3d(0, 0, 0);
        }
        50% {
            transform: translate3d(14px, 22px, 0);
        }
    }

    @media (max-width: 640px) {
        .hero-blobs {
            opacity: 0.85;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .blob {
            animation: none;
        }
    }
</style>
