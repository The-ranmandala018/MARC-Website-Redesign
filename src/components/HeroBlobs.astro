---
/**
 * HeroBlobs
 * Background colour clouds + dot grid + grain, matching the reference
 * mock exactly: eight soft radial-gradient blobs at varying blur depths
 * (heavy blur = distant cloud, light blur + inset shadow = glass bubble
 * in focus), a faint dot grid lower-left, and a subtle grain overlay so
 * the gradients don't band.
 *
 * Pure CSS — no canvas/WebGL. Scoped to the hero only.
 */
---

<div class="hero-blobs" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
    <span class="blob b4"></span>
    <span class="blob b5"></span>
    <span class="blob b6"></span>
    <span class="blob b7"></span>
    <span class="blob b8"></span>
    <div class="dots"></div>
    <div class="grain"></div>
</div>

<style>
    .hero-blobs {
        position: absolute;
        inset: 0;
        z-index: 10;
        overflow: hidden;
        pointer-events: none;
    }

    .blob {
        position: absolute;
        border-radius: 50%;
        will-change: transform;
    }

    .b1 {
        /* big blue, top-left bleed */
        width: 420px;
        height: 420px;
        top: -130px;
        left: -120px;
        background: radial-gradient(circle at 34% 30%, #ffffff 0%, #c6d6ff 32%, #7c9cf8 70%, #6f7ff2 100%);
        filter: blur(14px);
        opacity: 0.78;
        animation: blob-float1 22s ease-in-out infinite;
    }

    .b2 {
        /* violet / pink, top-right */
        width: 520px;
        height: 520px;
        top: -180px;
        right: -140px;
        background: radial-gradient(circle at 38% 32%, #ffffff 0%, #e3d9ff 30%, #b9a4f5 65%, #f0a8c6 100%);
        filter: blur(18px);
        opacity: 0.72;
        animation: blob-float2 26s ease-in-out infinite;
    }

    .b3 {
        /* lavender mid-left, very soft */
        width: 300px;
        height: 300px;
        top: 34%;
        left: -60px;
        background: radial-gradient(circle at 40% 35%, #ffffff 0%, #dfe4ff 40%, #b6c0f6 100%);
        filter: blur(34px);
        opacity: 0.6;
        animation: blob-float3 19s ease-in-out infinite;
    }

    .b4 {
        /* peach / pink bottom-left */
        width: 460px;
        height: 460px;
        bottom: -170px;
        left: -110px;
        background: radial-gradient(circle at 36% 30%, #ffffff 0%, #ffe0e8 28%, #d9b8f2 60%, #a9b4f6 100%);
        filter: blur(16px);
        opacity: 0.7;
        animation: blob-float2 24s ease-in-out infinite reverse;
    }

    .b5 {
        /* rose bottom-right */
        width: 560px;
        height: 560px;
        bottom: -220px;
        right: -170px;
        background: radial-gradient(circle at 34% 28%, #ffffff 0%, #ffd9e2 30%, #f0a9c3 62%, #b7a6f0 100%);
        filter: blur(18px);
        opacity: 0.68;
        animation: blob-float1 28s ease-in-out infinite;
    }

    .b6 {
        /* small glass bubble, upper mid */
        width: 140px;
        height: 140px;
        top: 14%;
        left: 44%;
        background: radial-gradient(circle at 32% 28%, #ffffff 0%, #e8ecff 40%, #c3cdfb 100%);
        filter: blur(10px);
        opacity: 0.75;
        animation: blob-float3 16s ease-in-out infinite;
    }

    .b7 {
        /* crisp bubble right edge */
        width: 120px;
        height: 120px;
        top: 9%;
        right: 11%;
        background: radial-gradient(circle at 30% 26%, #ffffff 0%, #dbe3ff 35%, #9fb3f7 75%, #c9a8ef 100%);
        filter: blur(1.5px);
        opacity: 0.9;
        box-shadow: inset -10px -14px 26px rgba(120, 120, 200, 0.18);
        animation: blob-float3 14s ease-in-out infinite reverse;
    }

    .b8 {
        /* mid-right pale */
        width: 200px;
        height: 200px;
        top: 56%;
        right: 6%;
        background: radial-gradient(circle at 36% 30%, #ffffff 0%, #eef1ff 45%, #cdd6fa 100%);
        filter: blur(26px);
        opacity: 0.65;
        animation: blob-float1 21s ease-in-out infinite reverse;
    }

    /* faint dot grid, lower-left */
    .dots {
        position: absolute;
        left: 2%;
        bottom: 8%;
        width: 180px;
        height: 220px;
        background-image: radial-gradient(rgba(90, 105, 180, 0.26) 1.1px, transparent 1.2px);
        background-size: 12px 12px;
        -webkit-mask-image: linear-gradient(120deg, #000 10%, transparent 85%);
        mask-image: linear-gradient(120deg, #000 10%, transparent 85%);
        opacity: 0.55;
    }

    /* grain so the gradients never band */
    .grain {
        position: absolute;
        inset: 0;
        opacity: 0.16;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.5'/></svg>");
    }

    @keyframes blob-float1 {
        0%,
        100% {
            transform: translate3d(0, 0, 0) scale(1);
        }
        50% {
            transform: translate3d(26px, -30px, 0) scale(1.05);
        }
    }

    @keyframes blob-float2 {
        0%,
        100% {
            transform: translate3d(0, 0, 0) scale(1);
        }
        50% {
            transform: translate3d(-30px, 24px, 0) scale(1.04);
        }
    }

    @keyframes blob-float3 {
        0%,
        100% {
            transform: translate3d(0, 0, 0);
        }
        50% {
            transform: translate3d(14px, 22px, 0);
        }
    }

    @media (max-width: 640px) {
        .hero-blobs {
            opacity: 0.85;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .blob {
            animation: none;
        }
    }
</style>
