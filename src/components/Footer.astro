---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const facebookUrl =
    "https://www.facebook.com/p/Multidisciplinary-AI-Research-Center-MARC-61566611961677/";
const linkedinUrl = "https://www.linkedin.com/company/multidisciplinaryai";
const youtubeUrl = "https://www.youtube.com/@MARCUoP";
const facultyUrl = "https://eng.pdn.ac.lk/";

const exploreLinks = [
    { href: "/Research", label: "Research & projects" },
    { href: "/publications", label: "Publications" },
];
const aboutLinks = [
    { href: "/people", label: "People" },
    { href: "/news", label: "News" },
    { href: facultyUrl, label: "Faculty of Engineering", external: true },
];
const year = new Date().getFullYear();
---

<footer class="marc-footer mt-16 sm:mt-20">
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-9 sm:py-11">
        <div class="grid grid-cols-1 gap-7 sm:gap-8 md:grid-cols-12">
            <!-- Brand -->
            <div class="md:col-span-5 space-y-3">
                <div class="flex items-center gap-3">
                    <Image
                        src={logo}
                        alt="MARC logo"
                        class="w-9 h-9 rounded-full ring-1 ring-white/20"
                    />
                    <div>
                        <div class="font-semibold text-base tracking-wide">MARC</div>
                        <div class="text-[11px] opacity-70">
                            Multidisciplinary AI Research Centre
                        </div>
                    </div>
                </div>
                <p class="text-xs sm:text-sm opacity-75 max-w-sm leading-relaxed">
                    A research centre at the Faculty of Engineering, University
                    of Peradeniya, advancing AI through interdisciplinary
                    collaboration in collaboration with DEEE & DMIE.
                </p>

                <div class="flex items-center gap-2 pt-1">
                    <a
                        href={linkedinUrl}
                        target="_blank"
                        rel="noopener"
                        aria-label="LinkedIn"
                        class="marc-footer-social w-8 h-8 grid place-items-center rounded-full transition"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            class="fill-current"
                        >
                            <path
                                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href={youtubeUrl}
                        target="_blank"
                        rel="noopener"
                        aria-label="YouTube"
                        class="w-9 h-9 grid place-items-center rounded-full bg-white/5 hover:bg-white/15 transition"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            class="fill-current"
                        >
                            <path
                                d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href={facebookUrl}
                        target="_blank"
                        rel="noopener"
                        aria-label="Facebook"
                        class="w-9 h-9 grid place-items-center rounded-full bg-white/5 hover:bg-white/15 transition"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            class="fill-current"
                        >
                            <path
                                d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Explore -->
            <div class="md:col-span-3">
                <h4 class="text-[11px] font-semibold uppercase tracking-[0.16em] mb-3 opacity-65">Explore</h4>
                <ul class="space-y-2">
                    {
                        exploreLinks.map((l) => (
                            <li>
                                <a
                                    href={l.href}
                                    class="marc-footer-link text-xs sm:text-sm transition-colors"
                                >
                                    {l.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- About -->
            <div class="md:col-span-4">
                <h4 class="text-[11px] font-semibold uppercase tracking-[0.16em] mb-3 opacity-65">About</h4>
                <ul class="space-y-3">
                    {
                        aboutLinks.map((l) => (
                            <li>
                                <a
                                    href={l.href}
                                    target={l.external ? "_blank" : undefined}
                                    rel={l.external ? "noopener" : undefined}
                                    class="marc-footer-link text-xs sm:text-sm transition-colors inline-flex items-center gap-1"
                                >
                                    {l.label}
                                    {l.external && (
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-3 h-3"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M14 3h7v7m0-7L10 14m-4-4v11h11"
                                            />
                                        </svg>
                                    )}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="mt-8 sm:mt-9 pt-5 border-t flex flex-col md:flex-row justify-between gap-2 text-[11px] opacity-65">
            <p>© {year} Multidisciplinary AI Research Centre.</p>
            <p>Faculty of Engineering, University of Peradeniya, Sri Lanka.</p>
        </div>
    </div>

    <style>
        .marc-footer {
            color: #eaf0ff;
            background:
                radial-gradient(ellipse at 12% 0%, rgba(81, 112, 255, 0.24), transparent 38%),
                radial-gradient(ellipse at 88% 100%, rgba(124, 14, 36, 0.20), transparent 34%),
                linear-gradient(120deg, #07172f 0%, #10264b 52%, #151b35 100%);
            border-top: 1px solid rgba(156, 181, 255, 0.26);
        }

        .marc-footer-link {
            color: rgba(234, 240, 255, 0.76);
            text-decoration: none;
            transition: color 180ms ease;
        }

        .marc-footer-link:hover {
            color: #ffffff;
        }

        .marc-footer-social {
            color: #eaf0ff;
            border: 1px solid rgba(156, 181, 255, 0.24);
            background: rgba(255, 255, 255, 0.055);
        }

        .marc-footer-social:hover {
            border-color: transparent;
            background: linear-gradient(135deg, #004AAD, #5170FF 58%, #7C0E24 125%);
            box-shadow: 0 0 14px rgba(81, 112, 255, 0.22);
            transform: translateY(-1px);
        }

        html[data-theme="marc-dark"] .marc-footer {
            background:
                radial-gradient(ellipse at 12% 0%, rgba(81, 112, 255, 0.2), transparent 38%),
                radial-gradient(ellipse at 88% 100%, rgba(124, 14, 36, 0.18), transparent 34%),
                linear-gradient(120deg, #050b18 0%, #0b1530 52%, #130e20 100%);
        }
    </style>
</footer>
