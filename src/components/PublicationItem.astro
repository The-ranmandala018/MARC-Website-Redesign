---
/**
 * PublicationItem
 * One publication as a glass row: type + date, title (links to DOI),
 * venue, authors, and a "Read paper" pill. Used on project and people
 * pages; the Publications page renders the same design in its Preact
 * list.
 */
interface Props {
    title: string;
    venue: string;
    type: string;
    doi: string;
    date: string;
    authors: string[];
    project?: string;
}

const { title, venue, type, doi, date, authors, project } = Astro.props;

const prettyDate = new Date(date).toLocaleDateString("en-GB", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
});
---

<article class="glass-card glass-hover p-5 sm:p-6 !rounded-3xl">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 text-xs">
                <span
                    class={`rounded-full px-2.5 py-1 font-semibold uppercase tracking-wider ${
                        type === "Journal"
                            ? "bg-[#004AAD]/10 text-[#004AAD] dark:bg-[#5170FF]/15 dark:text-[#9fb0ff]"
                            : "bg-[#7C0E24]/10 text-[#7C0E24] dark:bg-[#f3dfe4]/10 dark:text-[#f3dfe4]"
                    }`}
                >
                    {type}
                </span>
                <span class="text-base-content/50 tabular-nums">{prettyDate}</span>
                {project && <span class="text-base-content/50">· {project}</span>}
            </div>

            <h3 class="mt-3 text-lg font-semibold leading-snug text-base-content">
                <a href={doi} target="_blank" rel="noopener noreferrer" class="hover:text-[#004AAD] dark:hover:text-[#5170FF] transition-colors">
                    {title}
                </a>
            </h3>

            <p class="mt-1.5 text-sm italic text-base-content/75">{venue.trim()}</p>

            <p class="mt-2 text-sm leading-relaxed text-base-content/60">
                {authors.join(", ")}
            </p>
        </div>

        <div class="shrink-0">
            <a
                href={doi}
                target="_blank"
                rel="noopener noreferrer"
                class="glass-chip !py-2 text-xs font-semibold"
            >
                Read paper
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
                </svg>
            </a>
        </div>
    </div>
</article>
