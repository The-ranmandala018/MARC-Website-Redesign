---
/**
 * PageBackground
 * Reuses the homepage HeroBlobs component. The default instance remains
 * unchanged for the homepage; innerPage enables the fixed shared backdrop
 * for every inner page without duplicating blob markup or styles.
 */
import HeroBlobs from "./HeroBlobs.astro";

interface Props {
    innerPage?: boolean;
}

const { innerPage = false } = Astro.props;
---

<div class:list={["page-bg", { "page-bg-inner": innerPage }]} aria-hidden="true">
    <HeroBlobs />
</div>

<style>
    .page-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    /* Preserve the existing homepage instance; apply the shared warm base only to inner pages. */
    .page-bg-inner {
        background-color: #FAF8F3;
    }

    /* Keep the background subtle behind dark-theme content. */
    :global(html[data-theme="marc-dark"]) .page-bg {
        opacity: 0.3;
    }

    /* Keep the same composition on mobile while reducing its visual weight. */
    @media (max-width: 640px) {
        .page-bg-inner {
            opacity: 0.85;
        }
    }

    /* Dark mode takes precedence over the mobile opacity adjustment. */
    :global(html[data-theme="marc-dark"]) .page-bg-inner {
        opacity: 0.3;
    }
</style>
