---
/**
 * HeroMiniOrbs
 * Smaller copies of the main hero orb, distributed around the hero.
 * Pure CSS, no JS. Scoped to the hero only.
 */
---

<div class="mini-orbs" aria-hidden="true">
    <span class="mini m1"></span>
    <span class="mini m2"></span>
    <span class="mini m3"></span>
    <span class="mini m4"></span>
</div>

<style>
    .mini-orbs {
        position: absolute;
        inset: 0;
        z-index: 15;
        pointer-events: none;
    }

    .mini {
        position: absolute;
        border-radius: 50%;
        background:
            radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 42%),
            radial-gradient(circle at 76% 78%, rgba(238, 120, 135, 0.55) 0%, rgba(238, 120, 135, 0) 50%),
            radial-gradient(circle at 20% 80%, rgba(140, 180, 255, 0.8) 0%, rgba(140, 180, 255, 0) 50%),
            linear-gradient(145deg, #9fc0ff 0%, #6a8af5 40%, #7a84f0 68%, #e69aa8 100%);
        box-shadow:
            0 30px 60px -28px rgba(80, 90, 220, 0.55),
            inset -12px -16px 32px rgba(90, 80, 200, 0.25),
            inset 10px 12px 28px rgba(255, 255, 255, 0.45);
        animation: mini-bob 10s ease-in-out infinite;
    }

    .mini::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background-image: radial-gradient(rgba(255, 255, 255, 0.65) 1px, transparent 1.3px);
        background-size: 6px 6px;
        mix-blend-mode: overlay;
        -webkit-mask-image: radial-gradient(circle at 72% 60%, #000 0%, transparent 72%);
        mask-image: radial-gradient(circle at 72% 60%, #000 0%, transparent 72%);
        opacity: 0.7;
    }

    .mini::before {
        content: "";
        position: absolute;
        top: 12%;
        left: 16%;
        width: 34%;
        height: 26%;
        border-radius: 50%;
        background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 70%);
        filter: blur(4px);
    }

    /* Keep the same bubble effects; adjust only scale and placement. */
    .m1 {
        width: 96px;
        height: 96px;
        left: calc(7% - 48px);
        top: calc(17% - 48px);
        animation-delay: -2s;
    }

    .m2 {
        width: 48px;
        height: 48px;
        left: calc(39% - 24px);
        top: calc(92% - 24px);
        animation-delay: -5s;
    }

    .m3 {
        width: 64px;
        height: 64px;
        left: calc(5% - 32px);
        top: calc(80% - 32px);
        animation-delay: -7s;
    }

    .m4 {
        width: 40px;
        height: 40px;
        left: calc(94% - 20px);
        top: calc(91% - 20px);
        animation-delay: -3.5s;
    }

    @keyframes mini-bob {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-12px);
        }
    }

    @media (max-width: 1023px) {
        .mini-orbs {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mini {
            animation: none;
        }
    }
</style>
